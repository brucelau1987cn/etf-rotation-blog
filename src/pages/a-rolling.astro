---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import AStockSubnav from '../components/AStockSubnav.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import QuoteLiveScripts from '../components/QuoteLiveScripts.astro';
import ARollingStatsStrip from '../components/ARollingStatsStrip.astro';
import ARollingEnergyMatrix from '../components/ARollingEnergyMatrix.astro';
import ARollingAiAlerts from '../components/ARollingAiAlerts.astro';
import { SITE_TITLE } from '../consts';
import '../styles/a-rolling.css';

type BuyCycle = {
  cycle_code: string;
  segment: string;
  timeframe_minutes: number;
  timeframe_label: string;
  buy_state: 'BUY' | 'STOPPED' | 'INACTIVE' | 'UNKNOWN';
  buy_triggered_at: string | null;
};

type SellStar = {
  code: string;
  timeframe_minutes: number;
  timeframe_label: string;
  sell_state: 'SELL' | 'INACTIVE';
  triggered_at: string | null;
};

type SellNode = {
  code: string;
  timeframe_minutes: number;
  timeframe_label: string;
  sell_state: 'SELL' | 'OBSERVING' | 'INACTIVE';
  triggered_at: string | null;
};

type SellAlert = {
  alert_id: string;
  cycle_code: string;
  timeframe_minutes: number;
  triggered_at: string;
  transmission_position: string | null;
  remaining_session_minutes: number;
  analysis_state: 'pending' | 'ready' | 'unavailable';
  analysis: string;
};

type TimelineItem = {
  type: 'BUY' | 'SELL' | string;
  code: string;
  triggered_at?: string | null;
  sell_state?: string;
};

type Payload = {
  schema_version: string;
  mode: 'demo' | 'live';
  generated_at: string;
  data_as_of: string;
  freshness: string;
  stale_after_seconds: number;
  notice: string;
  delivery: { state: string; reason: string | null };
  instrument: { instrument_name: string; exchange: string; symbol: string };
  transmission: {
    state: string;
    basis: string;
    current_cycle_code: string | null;
    stopped_at_code?: string | null;
    started_at: string | null;
    lit_count: number;
    continuous_confirmed: boolean;
    latest_triggered_at?: string | null;
  };
  buy_cycles: BuyCycle[];
  cycles?: BuyCycle[];
  sell_chain: {
    window_type: string;
    window_description: string;
    warning_star: SellStar;
    nodes: SellNode[];
  };
  sell_alerts: SellAlert[];
  timeline?: TimelineItem[];
};

const payload = JSON.parse(readFileSync(join(process.cwd(), 'public/data/a-rolling-signals.json'), 'utf-8')) as Payload;

const formatTime = (value: string | null | undefined, includeDate = true, includeSeconds = false) => {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;

  const options: Intl.DateTimeFormatOptions = {
    timeZone: 'Asia/Shanghai',
    hour12: false,
    hour: '2-digit',
    minute: '2-digit',
  };
  if (includeSeconds) options.second = '2-digit';
  if (includeDate) {
    options.month = '2-digit';
    options.day = '2-digit';
  }
  return date.toLocaleString('zh-CN', options);
};

const timeline: TimelineItem[] = Array.isArray(payload.timeline) && payload.timeline.length
  ? payload.timeline
  : [
      ...(payload.buy_cycles || payload.cycles || []).map((c) => ({
        type: 'BUY' as const,
        code: c.cycle_code,
        triggered_at: c.buy_triggered_at,
      })),
      ...(payload.sell_chain?.nodes || []).map((n) => ({
        type: 'SELL' as const,
        code: n.code,
        triggered_at: n.triggered_at,
        sell_state: n.sell_state,
      })),
    ].sort((a, b) => new Date(a.triggered_at || 0).getTime() - new Date(b.triggered_at || 0).getTime());

const sellNodes = payload.sell_chain?.nodes || [];
const litTimeText = payload.transmission?.latest_triggered_at
  ? `(${formatTime(payload.transmission.latest_triggered_at, true, true)})`
  : '';

const pageTitle = `A股滚动｜多空能量传导链 | ${SITE_TITLE}`;
const pageDescription = 'A股滚动多空能量传导终端，展示买方力量与卖方预警的动态延伸。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>
  <body>
    <Header />
    <main id="main-content" class="a-rolling-main">
      <AStockSubnav active="rolling" />

      <section class="dashboard-hero card" aria-labelledby="page-title">
        <div class="hero-top">
          <div class="hero-copy">
            <div class="meta-line">
              <span class="pill pill-red">🇨🇳 A股 · 滚动</span>
              <span class="pill" id="pill-stock-quote" style="background:#f1f5f9; color:#334155; border-color:#cbd5e1;">行情获取中...</span>
              <span class="pill pill-amber" id="pill-as-of">数据时点：{formatTime(payload.data_as_of)}</span>
              <span class="pill pill-blue" id="pill-mode">模式：{payload.mode === 'demo' ? '基准演示' : '实时数据'}</span>
              <span class="pill">协议：a-rolling-energy-v3</span>
              <span class="pill live-pill" id="live-status-pill" style="background:#e6f4ff; color:#0958d9; border-color:#91caff;">实时连接中</span>
            </div>
            <h1 id="page-title">多空能量传导链</h1>
            <p>基于 TradingBox AI 4.0 信号的 34 周期买方能量传导与动态卖出预警中枢</p>
          </div>
        </div>

        <ARollingStatsStrip
          currentCode={payload.transmission?.current_cycle_code || '—'}
          litCount={payload.transmission?.lit_count || 0}
          litTimeText={litTimeText}
          transmissionState={payload.transmission?.state || '观察中'}
          sellNodeCode={sellNodes[0]?.code || null}
          sellNodeTime={sellNodes[0]?.triggered_at ? formatTime(sellNodes[0].triggered_at, true, true) : '等待买方信号后再出'}
          sellNodeCount={sellNodes.length}
        />
      </section>

      <ARollingEnergyMatrix
        instrumentName={payload.instrument.instrument_name}
        symbol={payload.instrument.symbol}
        timeline={timeline}
        formatTime={formatTime}
      />

      <ARollingAiAlerts alerts={payload.sell_alerts || []} />
    </main>
    <Footer />

    <QuoteLiveScripts />
    <!-- 客户端后台自动轮询刷新脚本：支持 TradingView Webhook 推送后无缝点亮 -->
    <script is:inline src="/js/a-rolling-app.js"></script>
  </body>
</html>
