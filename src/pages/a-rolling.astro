---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import AStockSubnav from '../components/AStockSubnav.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import QuoteLiveScripts from '../components/QuoteLiveScripts.astro';
import ARollingStatsStrip from '../components/ARollingStatsStrip.astro';
import ARollingEnergyMatrix from '../components/ARollingEnergyMatrix.astro';
import ARollingAiAlerts from '../components/ARollingAiAlerts.astro';
import { SITE_TITLE } from '../consts';
import '../styles/a-rolling.css';

type TimelineItem = {
  type: 'BUY' | 'SELL' | string;
  code: string;
  triggered_at?: string | null;
  sell_state?: string;
  label?: string;
};

type Payload = {
  schema_version: string;
  mode: 'demo' | 'live';
  generated_at: string;
  data_as_of: string;
  instrument: { instrument_name: string; exchange: string; symbol: string };
  transmission?: {
    state?: string;
    current_cycle_code?: string | null;
    lit_count?: number;
    latest_triggered_at?: string | null;
  };
  cycles?: Array<{ cycle_code: string; buy_triggered_at?: string | null; label?: string }>;
  sell_chain?: { nodes?: Array<{ code: string; triggered_at?: string | null; sell_state?: string }> };
  sell_alerts?: Array<any>;
  timeline?: TimelineItem[];
};

const loadPayload = (file: string): Payload =>
  JSON.parse(readFileSync(join(process.cwd(), 'public/data', file), 'utf-8')) as Payload;

const shanghai = loadPayload('a-rolling-signals.json');
const chuangxin = loadPayload('a-rolling-signals-002173.json');
const sanan = loadPayload('a-rolling-signals-600703.json');

const formatTime = (value: string | null | undefined, includeDate = true, includeSeconds = false) => {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  const options: Intl.DateTimeFormatOptions = {
    timeZone: 'Asia/Shanghai',
    hour12: false,
    hour: '2-digit',
    minute: '2-digit',
  };
  if (includeSeconds) options.second = '2-digit';
  if (includeDate) {
    options.month = '2-digit';
    options.day = '2-digit';
  }
  return date.toLocaleString('zh-CN', options);
};

const toTimeline = (payload: Payload): TimelineItem[] => {
  if (Array.isArray(payload.timeline) && payload.timeline.length) return payload.timeline;
  return [
    ...(payload.cycles || []).map((c) => ({
      type: 'BUY' as const,
      code: c.cycle_code,
      triggered_at: c.buy_triggered_at,
      label: c.label,
    })),
    ...(payload.sell_chain?.nodes || []).map((n) => ({
      type: 'SELL' as const,
      code: n.code,
      triggered_at: n.triggered_at,
      sell_state: n.sell_state,
    })),
  ];
};

const boardInstruments = [
  {
    instrumentName: shanghai.instrument.instrument_name,
    symbol: shanghai.instrument.symbol,
    exchange: shanghai.instrument.exchange,
    timeline: toTimeline(shanghai),
  },
  {
    instrumentName: chuangxin.instrument.instrument_name,
    symbol: chuangxin.instrument.symbol,
    exchange: chuangxin.instrument.exchange,
    timeline: toTimeline(chuangxin),
  },
  {
    instrumentName: sanan.instrument.instrument_name,
    symbol: sanan.instrument.symbol,
    exchange: sanan.instrument.exchange,
    timeline: toTimeline(sanan),
  },
];

const allAlerts = [
  ...(shanghai.sell_alerts || []),
  ...(chuangxin.sell_alerts || []),
  ...(sanan.sell_alerts || []),
];

const buyTotal = boardInstruments.reduce(
  (sum, inst) => sum + inst.timeline.filter((item) => item.type === 'BUY' && item.code !== '1.75h' && item.code !== '105m').length,
  0,
);
const sellTotal = boardInstruments.reduce(
  (sum, inst) => sum + inst.timeline.filter((item) => item.type === 'SELL' && item.code !== '10m').length,
  0,
);

const latestAsOf = [shanghai.data_as_of, chuangxin.data_as_of, sanan.data_as_of]
  .filter(Boolean)
  .sort((a, b) => new Date(b).getTime() - new Date(a).getTime())[0];

const pageTitle = `A股滚动｜三标的多空能量看板 | ${SITE_TITLE}`;
const pageDescription = 'A股滚动三标的看板：上海电力、创新医疗、三安光电的多方正式窗口与空方预警同屏展示。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>
  <body>
    <Header />
    <main id="main-content" class="a-rolling-main">
      <AStockSubnav active="rolling" />

      <section class="dashboard-hero card" aria-labelledby="page-title">
        <div class="hero-top">
          <div class="hero-copy">
            <div class="meta-line">
              <span class="pill pill-red">🇨🇳 A股 · 滚动</span>
              <span class="pill" id="pill-stock-quote" style="background:#f1f5f9; color:#334155; border-color:#cbd5e1;">行情获取中...</span>
              <span class="pill pill-amber" id="pill-as-of">数据时点：{formatTime(latestAsOf)}</span>
              <span class="pill pill-blue" id="pill-mode">模式：三标的看板</span>
              <span class="pill">正式窗口：2h→5.5h</span>
              <span class="pill">观察：多方1.75h / 空方10m</span>
              <span class="pill live-pill" id="live-status-pill" style="background:#e6f4ff; color:#0958d9; border-color:#91caff;">实时连接中</span>
            </div>
            <h1 id="page-title">三标的多空能量看板</h1>
            <p>上海电力 / 创新医疗 / 三安光电 同屏对照。正式多方按 2h→5.5h 排序；标签后红/绿小圆为 1.75h 与 10m 观察窗。</p>
          </div>
        </div>

        <ARollingStatsStrip
          currentCode="三标的"
          litCount={buyTotal}
          litTimeText={`买 ${buyTotal} / 卖 ${sellTotal}`}
          transmissionState={buyTotal > 0 ? 'transmitting' : 'observing'}
          sellNodeCode={sellTotal > 0 ? String(sellTotal) : null}
          sellNodeTime={sellTotal > 0 ? '见各标的空方轨' : '卖出信号暂无'}
          sellNodeCount={sellTotal}
        />
      </section>

      <ARollingEnergyMatrix instruments={boardInstruments} formatTime={formatTime} />

      <ARollingAiAlerts alerts={allAlerts} />
    </main>
    <Footer />

    <QuoteLiveScripts />
    <script is:inline src="/js/a-rolling-app.js"></script>
  </body>
</html>
