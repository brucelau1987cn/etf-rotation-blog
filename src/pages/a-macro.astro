---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AStockSubnav from '../components/AStockSubnav.astro';
import AMacroHero from '../components/AMacroHero.astro';
import AMacroLiveGates from '../components/AMacroLiveGates.astro';
import AMacroFramework from '../components/AMacroFramework.astro';
import AMacroLadder from '../components/AMacroLadder.astro';
import AMacroDiscipline from '../components/AMacroDiscipline.astro';
import '../styles/a-macro.css';

const data = JSON.parse(readFileSync(join(process.cwd(), 'public/data/a-share-mid-macro.json'), 'utf-8'));
const constraint = data.constraint || {};
const factors = data.factors || [];
const factorMap = new Map(factors.map((factor: any) => [factor.key, factor]));
const framework = data.framework || [];
const scored = framework.filter((item: any) => item.factor_key && factorMap.has(item.factor_key));
const concreteOfficial = framework.filter((item: any) => !item.factor_key && (item.observations || []).length > 0);
const factorAsOfDates = factors
  .map((factor: any) => String(factor?.as_of || '').trim())
  .filter(Boolean)
  .sort();
const applyDate = factorAsOfDates.at(-1) || String(data.generated_at || '').slice(0, 10) || '待更新';
const updatedAt = data.generated_at || '待更新';
const modelVersion = data.model_version || data.version || 'A-share Macro';
const timezoneLabel = data.timezone === 'Asia/Shanghai' ? 'CST · UTC+8' : (data.timezone || 'Asia/Shanghai');
const liveGateCount = scored.length;
const liveGateReady = scored.filter((item: any) => {
  const factor: any = factorMap.get(item.factor_key) || {};
  return factor?.as_of || typeof factor?.score === 'number';
}).length;
const stateClass = (state: string) => state === '逆风' ? 'risk' : state === '顺风' ? 'support' : state === '待接入' ? 'pending' : 'neutral';
const stateIcon = (state: string) => state === '逆风' ? '↓' : state === '顺风' ? '↑' : state === '待接入' ? '·' : '—';
const metricLabel: Record<string, Record<string, string>> = {
  rates_fixed_income: { bond_ret5: '固收5日', bond_ret20: '固收20日', equity_ret5: '沪深300 5日', equity_ret20: '沪深300 20日', bond_vs_equity_5d_pp: '固收相对权益5日', bond_vs_equity_20d_pp: '固收相对权益20日' },
  overseas_deleveraging: { proxy_ret5_avg: '海外映射5日均值', proxy_ret20_avg: '海外映射20日均值', proxy_weak_count_5d: '核心弱势数', overseas_pool_count: '海外相关池', overseas_weak_share: '海外池弱化占比' },
  margin_financing: { rzye_yi: '两融余额', rzyezb: '融资余额占比', chg5_pct: '5日变化', chg10_pct: '10日变化', chg20_pct: '20日变化', down_streak: '连续回落' },
};
const formatMetric = (key: string, value: unknown) => {
  if (typeof value !== 'number') return String(value ?? 'N/A');
  if (key === 'rzye_yi') return `${value.toFixed(0)}亿元`;
  if (key === 'rzyezb') return `${value.toFixed(2)}%`;
  if (key === 'overseas_weak_share') return `${Math.round(value * 100)}%`;
  if (key.includes('count') || key === 'down_streak') return `${value}项`;
  return `${value > 0 ? '+' : ''}${value.toFixed(2)}${key.includes('pp') ? 'pp' : '%'}`;
};
const coverageLabel = (coverage: string) => ({ live: '日度实测', proxy: '日度代理', official: '官方低频实测', pending_official: '官方月度待接入' })[coverage] || coverage;
const sourceLabel = (value: string) => ({
  'eastmoney RPTA_RZRQ_LSHJ': '公开两融历史汇总',
  'tencent qfq day bars': '公开前复权日线',
})[value] || value;
const dailyMissing = Object.keys(data.source_audit?.failures || {}).length;
const officialCoverage = concreteOfficial.length;
const pressureScore = factors.reduce((sum: number, factor: any) => sum + (Number(factor.score) || 0), 0);
const levelCopy = [
  { level: 0, label: '中性', discipline: '按ETF关键位与趋势正常执行' },
  { level: 1, label: '偏逆风', discipline: '权益上限下调一档，只等回踩' },
  { level: 2, label: '逆风', discipline: '禁止追高，新增进攻仓减半' },
  { level: 3, label: '强逆风', discipline: '停止新开进攻仓，优先防御' },
];

const liveCards = scored.map((dimension: any) => {
  const factor: any = factorMap.get(dimension.factor_key) || {};
  const metrics = Object.entries(factor.metrics || {})
    .filter(([key]) => metricLabel[factor.key]?.[key])
    .slice(0, 6)
    .map(([key, value]) => ({
      label: metricLabel[factor.key][key],
      value: formatMetric(key, value),
    }));
  return {
    dimensionLabel: dimension.label,
    question: dimension.question,
    coverageLabel: coverageLabel(dimension.coverage),
    factor,
    metrics,
  };
});
---
<!doctype html>
<html lang="zh-CN">
<head>
  <BaseHead title="A股宏观雷达｜流动性、信用与风险预算" description="A股宏观雷达：客观跟踪货币流动性、信用周期、增长盈利、通胀利润率、汇率外部环境和市场资金杠杆，并将及时指标映射为ETF风险预算。" />
</head>
<body>
  <Header />
  <main id="main-content" class="a-macro-main" tabindex="-1">
    <AStockSubnav active="macro" />
    <AMacroHero
      applyDate={applyDate}
      updatedAt={updatedAt}
      timezoneLabel={timezoneLabel}
      modelVersion={modelVersion}
      liveGateReady={liveGateReady}
      liveGateCount={liveGateCount}
      constraint={constraint}
      scoringNote={data.scoring_scope?.note || '宏观背景只约束风险预算，ETF价格与资金负责触发。'}
      pressureScore={pressureScore}
    />
    <AMacroLiveGates
      cards={liveCards}
      stateClass={stateClass}
      stateIcon={stateIcon}
    />
    <AMacroFramework
      framework={framework}
      stateClass={stateClass}
      coverageLabel={coverageLabel}
    />
    <AMacroLadder
      levels={levelCopy}
      currentLevel={constraint.headwind_level}
    />
    <AMacroDiscipline
      rules={constraint.execution_rules || []}
      marginSource={sourceLabel(data.source_audit?.margin_source)}
      priceSource={sourceLabel(data.source_audit?.price_source)}
      dailyMissing={dailyMissing}
      officialCoverage={officialCoverage}
      disclaimer={data.disclaimer}
    />
  </main>
  <Footer />
</body>
</html>
