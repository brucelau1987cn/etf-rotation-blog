---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AStockSubnav from '../components/AStockSubnav.astro';
import QuoteLiveScripts from '../components/QuoteLiveScripts.astro';
import AMomentumHero from '../components/AMomentumHero.astro';
import AMomentumRecommendations from '../components/AMomentumRecommendations.astro';
import AMomentumPoolPanel from '../components/AMomentumPoolPanel.astro';
import AMomentumSideStack from '../components/AMomentumSideStack.astro';
import '../styles/a-momentum.css';

const title = 'A股趋势风控雷达｜91池市场结构与风险过滤';
const description = 'A股趋势风控雷达：通过ETF罗盘91池的趋势强度、交易风险、交易状态与行情快照，为左侧轮动提供确认和过滤。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main id="main-content" class="a-momentum-main" tabindex="-1">
      <AStockSubnav active="trend" />
      <AMomentumHero />
      <AMomentumRecommendations />
      <section class="dashboard-grid">
        <AMomentumPoolPanel />
        <AMomentumSideStack />
      </section>
    </main>
    <Footer />
    <QuoteLiveScripts />
    <script is:inline src="/js/momentum-shared.js"></script>
    <script is:inline src="/js/a-momentum-recompute.js"></script>
    <script is:inline src="/js/a-momentum-app.js"></script>
  </body>
</html>
