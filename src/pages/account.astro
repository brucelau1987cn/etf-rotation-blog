---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const title = `个人信息 | ${SITE_TITLE}`;
const description = '查看当前账号等级、授权有效期与绑定设备。';
---
<BaseHead title={title} description={description} />
<body>
  <Header />
  <main class="account-main site-shell">
    <div class="account-heading">
      <div>
        <p class="page-kicker">ACCOUNT CENTER</p>
        <h1>个人信息</h1>
        <p>查看当前登录身份、授权状态和设备使用情况。</p>
      </div>
      <a class="back-link" href="/">返回首页</a>
    </div>

    <div class="account-loading" id="account-loading">
      <span class="loading-dot"></span> 正在读取账号信息…
    </div>

    <section class="account-layout" id="account-body" hidden style="display:none">
      <article class="identity-card">
        <div class="identity-top">
          <div class="identity-avatar" id="identity-avatar">👤</div>
          <div>
            <span class="status-pill"><i></i> 授权有效</span>
            <h2 id="identity-role">—</h2>
            <p id="identity-caption">—</p>
          </div>
        </div>
        <div class="identity-meta" id="identity-meta"></div>
      </article>

      <div class="account-content">
        <article class="info-card">
          <div class="card-heading">
            <div>
              <p class="section-kicker">OVERVIEW</p>
              <h2>账号概览</h2>
            </div>
          </div>
          <dl class="info-list" id="account-grid"></dl>
        </article>

        <article class="device-card" id="device-card">
          <div class="card-heading">
            <div>
              <p class="section-kicker">DEVICE ACCESS</p>
              <h2>设备使用</h2>
            </div>
            <strong id="device-count">0 / 5</strong>
          </div>
          <div class="device-progress" aria-label="设备使用率">
            <span id="device-progress-bar"></span>
          </div>
          <p id="device-tip">每个订阅最多绑定 5 台设备。同一设备重复登录不会重复占用名额。</p>
        </article>

        <article class="security-card">
          <div>
            <p class="section-kicker">SECURITY</p>
            <h2>登录安全</h2>
            <p>退出后将清除本机登录状态，再次访问需要重新验证。</p>
          </div>
          <button class="account-logout" id="account-logout">退出当前账号</button>
        </article>

        <article class="security-card" id="change-pwd-card" hidden style="display:none">
          <div>
            <p class="section-kicker">CHANGE PASSWORD</p>
            <h2>修改密码</h2>
            <p>需要验证旧密码；新密码至少 6 位，不限大小写、数字与特殊字符。</p>
          </div>
          <div class="pwd-form">
            <label>旧密码<input type="password" id="pwd-old" autocomplete="current-password" placeholder="当前密码" /></label>
            <label>新密码<input type="password" id="pwd-new" autocomplete="new-password" placeholder="至少 6 位" /></label>
            <label>确认新密码<input type="password" id="pwd-confirm" autocomplete="new-password" placeholder="再次输入" /></label>
            <button class="account-logout" id="pwd-submit" type="button">保存新密码</button>
            <p class="pwd-msg" id="pwd-msg"></p>
          </div>
        </article>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const formatTime = (value) => {
        if (!value) return '—';
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return String(value).replace('T', ' ').slice(0, 16);
        return new Intl.DateTimeFormat('zh-CN', {
          timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', hour12: false,
        }).format(d).replaceAll('/', '-');
      };

      function renderRows(rows) {
        const list = $('account-grid');
        const nodes = rows.map(([label, value, accent]) => {
          const row = document.createElement('div');
          const dt = document.createElement('dt');
          const dd = document.createElement('dd');
          dt.textContent = label;
          dd.textContent = value;
          if (accent) dd.className = accent;
          row.append(dt, dd);
          return row;
        });
        list.replaceChildren(...nodes);
      }

      fetch('/api/public/v1/me', { credentials: 'same-origin' })
        .then((r) => r.json())
        .then((d) => {
          $('account-loading').hidden = true;
          $('account-loading').style.display = 'none';
          if (d.kind === 'anonymous') {
            location.href = '/login/?next=%2Faccount%2F';
            return;
          }
          $('account-body').hidden = false;
          $('account-body').style.display = 'grid';

          if (d.kind === 'admin') {
            const role = d.role === 'super_admin' ? '超级管理员' : '管理员';
            $('identity-avatar').textContent = '🛠';
            $('identity-role').textContent = role;
            $('identity-caption').textContent = '管理账号 · 可管理订阅授权';
            $('identity-meta').textContent = '管理会话';
            renderRows([
              ['账号等级', role, 'value-blue'],
              ['登录方式', '用户名 + 密码'],
              ['会话到期', d.expires_at && d.expires_at >= '2099-01-01' ? '长期有效（无期限）' : formatTime(d.expires_at)],
              ['管理权限', d.role === 'super_admin' ? '全部权限' : '账号开通与订阅管理'],
            ]);
            $('device-card').hidden = true;
          } else {
            const role = d.vip ? 'VIP用户' : '订阅用户';
            const deviceCount = Number(d.device_count || 0);
            const deviceLimit = Number(d.device_limit || 5);
            $('identity-avatar').textContent = d.vip ? '💎' : '👤';
            $('identity-role').textContent = role;
            $('identity-caption').textContent = d.label || 'ETF 罗盘订阅账号';
            $('identity-meta').textContent = `授权至 ${formatTime(d.expires_at)}`;
            renderRows([
              ['账号等级', role, d.vip ? 'value-blue' : ''],
              ['账号备注', d.label || '—'],
              ['登录方式', d.vip ? '用户名 + 密码 / 订阅密码' : '订阅密码'],
              ['授权到期', formatTime(d.expires_at), 'value-green'],
            ]);
            $('device-count').textContent = `${deviceCount} / ${deviceLimit}`;
            $('device-progress-bar').style.width = `${Math.min(100, deviceCount / deviceLimit * 100)}%`;
            $('device-tip').textContent = deviceCount >= deviceLimit
              ? '设备名额已满。如需更换设备，请联系管理员解绑后重新登录。'
              : `还可绑定 ${Math.max(0, deviceLimit - deviceCount)} 台设备。同一设备重复登录不会重复占用名额。`;
          }
        })
        .catch(() => {
          $('account-loading').textContent = '账号信息加载失败，请刷新页面重试。';
          $('account-loading').classList.add('error');
        });

      $('account-logout').addEventListener('click', () => {
        $('account-logout').disabled = true;
        $('account-logout').textContent = '正在退出…';
        fetch('/api/public/v1/logout', { method: 'POST', credentials: 'same-origin' })
          .finally(() => { location.href = '/login/'; });
      });

      // ── 修改密码 ──
      $('change-pwd-card').hidden = false;
      $('change-pwd-card').style.display = 'grid';
      const setMsg = (text, ok = false) => {
        const el = $('pwd-msg');
        el.textContent = text;
        el.style.color = ok ? '#15803d' : '#dc2626';
      };
      $('pwd-submit').addEventListener('click', async () => {
        const oldPwd = $('pwd-old').value;
        const newPwd = $('pwd-new').value;
        const confirmPwd = $('pwd-confirm').value;
        if (!oldPwd) return setMsg('请输入旧密码');
        if (newPwd.length < 6) return setMsg('新密码至少 6 位');
        if (newPwd !== confirmPwd) return setMsg('两次输入的新密码不一致');
        const btn = $('pwd-submit');
        btn.disabled = true; btn.textContent = '保存中…';
        try {
          const resp = await fetch('/api/public/v1/account/change-password', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ old_password: oldPwd, new_password: newPwd }),
          });
          const d = await resp.json();
          if (!resp.ok || !d.ok) {
            setMsg(d.error || '修改失败，请重试');
            btn.disabled = false; btn.textContent = '保存新密码';
            return;
          }
          setMsg('密码已更新。订阅账号需重新登录，即将跳转…', true);
          setTimeout(() => { location.href = '/login/'; }, 1200);
        } catch {
          setMsg('网络错误，请重试');
          btn.disabled = false; btn.textContent = '保存新密码';
        }
      });
    })();
  </script>
</body>

<style>
  .account-main { padding: 2.2rem 0 4rem; }
  .account-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.4rem; }
  .page-kicker, .section-kicker { margin: 0 0 .35rem; color: #2563eb; font-size: .68rem; font-weight: 900; letter-spacing: .12em; }
  .account-heading h1 { margin: 0; font-size: clamp(1.7rem, 3vw, 2.25rem); letter-spacing: -.035em; }
  .account-heading p:last-child { margin: .45rem 0 0; color: rgb(var(--gray-mid)); font-size: .9rem; }
  .back-link { color: #1d4ed8; background: #eff6ff; border: 1px solid #dbeafe; border-radius: 999px; padding: .5rem .85rem; font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .account-loading { display: flex; align-items: center; gap: .55rem; min-height: 160px; color: rgb(var(--gray-mid)); font-size: .88rem; }
  .account-loading[hidden], .account-layout[hidden] { display: none !important; }
  .account-loading.error { color: #dc2626; }
  .loading-dot { width: 8px; height: 8px; border-radius: 50%; background: #2563eb; box-shadow: 0 0 0 5px #dbeafe; }
  .account-layout { display: grid; gap: 1rem; }
  .pwd-form { display: grid; gap: .6rem; margin-top: .4rem; }
  .pwd-form label { display: grid; gap: .28rem; color: #475569; font-size: .74rem; font-weight: 800; }
  .pwd-form input { min-height: 40px; padding: .55rem .7rem; border: 1px solid #dbe2ea; border-radius: 10px; font: inherit; font-size: .84rem; outline: none; }
  .pwd-form input:focus { border-color: #60a5fa; box-shadow: 0 0 0 3px #dbeafe; }
  .pwd-msg { margin: .2rem 0 0; font-size: .78rem; font-weight: 800; }
  .identity-card, .info-card, .device-card, .security-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 18px; }
  .identity-card {
    display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    min-height: 132px; padding: 1.45rem 1.6rem;
    background: linear-gradient(135deg, #0f172a 0%, #172554 62%, #1e3a8a 100%);
    color: #fff; border: none; box-shadow: 0 14px 34px rgba(15, 23, 42, .14);
  }
  .identity-top { display: flex; align-items: center; gap: 1rem; min-width: 0; }
  .identity-avatar { flex: 0 0 auto; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 16px; background: rgba(255,255,255,.11); border: 1px solid rgba(255,255,255,.16); font-size: 1.35rem; }
  .status-pill { display: inline-flex; align-items: center; gap: .35rem; color: #bbf7d0; font-size: .68rem; font-weight: 850; }
  .status-pill i { width: 6px; height: 6px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34,197,94,.15); }
  .identity-card h2 { margin: .3rem 0 .15rem; color: #fff !important; font-size: 1.45rem; line-height: 1.2; }
  .identity-card p { margin: 0; color: #cbd5e1 !important; font-size: .8rem; }
  .identity-meta {
    flex: 0 0 auto; min-width: 180px; margin: 0; padding: .8rem 1rem;
    color: #dbeafe; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12);
    border-radius: 12px; font-size: .78rem; line-height: 1.55; text-align: right;
  }
  .account-content { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .info-card { grid-column: 1 / -1; }
  .info-card, .device-card { padding: 1.35rem; }
  .device-card[hidden] { display: none !important; }
  .card-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .card-heading h2, .security-card h2 { margin: 0; font-size: 1.05rem; letter-spacing: -.01em; }
  .card-heading strong { color: #1d4ed8; font-size: .9rem; }
  .info-list { display: grid; margin: 0; }
  .info-list div { display: grid; grid-template-columns: minmax(100px, .45fr) minmax(0, 1fr); gap: 1rem; padding: .85rem 0; border-top: 1px solid #f1f5f9; }
  .info-list div:first-child { border-top: 0; }
  .info-list dt { color: #64748b; font-size: .78rem; font-weight: 750; }
  .info-list dd { margin: 0; color: #0f172a; font-size: .88rem; font-weight: 800; text-align: right; }
  .info-list .value-blue { color: #1d4ed8; }
  .info-list .value-green { color: #15803d; }
  .device-progress { height: 8px; overflow: hidden; background: #eef2f7; border-radius: 999px; }
  .device-progress span { display: block; width: 0; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #2563eb, #60a5fa); transition: width .35s ease; }
  .device-card > p { margin: .8rem 0 0; color: #64748b; font-size: .78rem; line-height: 1.55; }
  .security-card { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.25rem 1.35rem; }
  .security-card p:not(.section-kicker) { margin: .35rem 0 0; color: #64748b; font-size: .78rem; line-height: 1.5; }
  .account-logout { flex: 0 0 auto; padding: .62rem 1rem; color: #b91c1c; background: #fff; border: 1px solid #fecaca; border-radius: 999px; font-size: .8rem; font-weight: 850; cursor: pointer; }
  .account-logout:hover { background: #fef2f2; }
  .account-logout:disabled { opacity: .6; cursor: wait; }
  @media (max-width: 760px) {
    .account-main { padding: 1.3rem 0 3rem; }
    .identity-card { align-items: flex-start; flex-direction: column; gap: 1.1rem; }
    .identity-meta { width: 100%; box-sizing: border-box; min-width: 0; text-align: left; }
    .account-content { grid-template-columns: 1fr; }
    .info-card { grid-column: auto; }
    .security-card { align-items: stretch; flex-direction: column; }
    .account-logout { width: 100%; }
  }
</style>
