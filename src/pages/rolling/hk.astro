---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import QuoteLiveScripts from '../../components/QuoteLiveScripts.astro';
import RollingSubnav from '../../components/RollingSubnav.astro';
import ARollingStatsStrip from '../../components/ARollingStatsStrip.astro';
import ARollingEnergyMatrix from '../../components/ARollingEnergyMatrix.astro';
import ARollingAiAlerts from '../../components/ARollingAiAlerts.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/a-rolling.css';

type TimelineItem = {
  type: 'BUY' | 'SELL' | string;
  code: string;
  triggered_at?: string | null;
  sell_state?: string;
  label?: string;
};

type Payload = {
  data_as_of: string;
  instrument: { instrument_name: string; exchange: string; symbol: string };
  cycles?: Array<{ cycle_code: string; buy_triggered_at?: string | null; label?: string }>;
  sell_chain?: { nodes?: Array<{ code: string; triggered_at?: string | null; sell_state?: string }> };
  sell_alerts?: Array<any>;
  timeline?: TimelineItem[];
};

const payload01378 = JSON.parse(
  readFileSync(join(process.cwd(), 'public/data/a-rolling-signals-01378.json'), 'utf-8'),
) as Payload;
const payload06809 = JSON.parse(
  readFileSync(join(process.cwd(), 'public/data/a-rolling-signals-06809.json'), 'utf-8'),
) as Payload;

const formatTime = (value: string | null | undefined, includeDate = true, includeSeconds = false) => {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  const options: Intl.DateTimeFormatOptions = {
    timeZone: 'Asia/Shanghai', hour12: false, hour: '2-digit', minute: '2-digit',
  };
  if (includeSeconds) options.second = '2-digit';
  if (includeDate) { options.month = '2-digit'; options.day = '2-digit'; }
  return date.toLocaleString('zh-CN', options);
};

const summarize = (payloadItem: Payload) => {
  const t: TimelineItem[] = Array.isArray(payloadItem.timeline) && payloadItem.timeline.length
    ? payloadItem.timeline
    : [
        ...(payloadItem.cycles || []).map((c) => ({ type: 'BUY', code: c.cycle_code, triggered_at: c.buy_triggered_at, label: c.label })),
        ...(payloadItem.sell_chain?.nodes || []).map((n) => ({ type: 'SELL', code: n.code, triggered_at: n.triggered_at, sell_state: n.sell_state })),
      ];
  const isBuyObs = (code: string) => code === '1.75h' || code === '105m';
  const isSellObs = (code: string) => code === '5m';
  const b = t.filter((item) => item.type === 'BUY' && !isBuyObs(item.code));
  // 多方重置空方历史：空方只保留最近一次正式多方之后的窗口
  const latestBuyTime = b.reduce((max, item) => Math.max(max, new Date(item.triggered_at || 0).getTime()), 0);
  const roundSells = latestBuyTime > 0
    ? t.filter((item) => item.type === 'SELL' && new Date(item.triggered_at || 0).getTime() >= latestBuyTime)
    : t.filter((item) => item.type === 'SELL');
  const s = roundSells.filter((item) => !isSellObs(item.code));
  const l = t
    .filter((item) => item.triggered_at)
    .sort((a, b) => new Date(b.triggered_at || 0).getTime() - new Date(a.triggered_at || 0).getTime())[0] || null;
  return {
    name: payloadItem.instrument.instrument_name,
    symbol: payloadItem.instrument.symbol,
    exchange: payloadItem.instrument.exchange,
    timeline: t,
    startDate: (payloadItem as any)?.transmission?.start_date || null,
    buyCount: b.length,
    sellCount: s.length,
    buyWatch: t.some((item) => item.type === 'BUY' && isBuyObs(item.code)),
    sellWatch: roundSells.some((item) => isSellObs(item.code)),
    latest: l,
    data_as_of: payloadItem.data_as_of,
    sell_alerts: payloadItem.sell_alerts || [],
  };
};

const summary01378 = summarize(payload01378);
const summary06809 = summarize(payload06809);
const summaries = [summary01378, summary06809];

const buyTotal = summaries.reduce((acc, cur) => acc + cur.buyCount, 0);
const sellTotal = summaries.reduce((acc, cur) => acc + cur.sellCount, 0);

const latestEvent = summaries
  .map((s) => s.latest)
  .filter(Boolean)
  .sort((a, b) => new Date(b!.triggered_at || 0).getTime() - new Date(a!.triggered_at || 0).getTime())[0] || null;

const latestAction = latestEvent
  ? `最新 ${latestEvent.type === 'BUY' ? '买入' : '卖出'} ${latestEvent.code} · ${formatTime(latestEvent.triggered_at)}`
  : '等待信号';

const latestAsOf = summaries
  .map((s) => s.data_as_of)
  .filter(Boolean)
  .sort((a, b) => new Date(b).getTime() - new Date(a).getTime())[0];

const pageTitle = `港股滚动｜中国宏桥 & 澜起科技多空能量看板 | ${SITE_TITLE}`;
const pageDescription = '港股滚动看板：中国宏桥、澜起科技的多方正式窗口、空方预警和观察信号。';
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={pageTitle} description={pageDescription} /></head>
  <body>
    <Header />
    <main id="main-content" class="a-rolling-main">
      <RollingSubnav active="hk" />
      <section class="dashboard-hero card" aria-labelledby="page-title">
        <div class="hero-top">
          <div class="hero-copy">
            <div class="status-row" aria-label="数据元信息">
              <span class="pill pill-red">🇭🇰 港股 · 滚动</span>
              <span class="pill" id="pill-refresh-countdown">实时：准备刷新…</span>
              <span class="pill pill-amber" id="pill-as-of">信号时间：{formatTime(latestAsOf)}</span>
              <span class="pill live-pill" id="live-status-pill">实时连接中</span>
            </div>
            <h1 id="page-title">港股滚动</h1>
            <p>中国宏桥、澜起科技展示。红=多方正式买入，绿=空方正式卖出；标签后小圆为 1.75h / 5m 观察窗。多方/空方各最多显示最新 4 个。</p>
          </div>
        </div>
        <ARollingStatsStrip buyTotal={buyTotal} sellTotal={sellTotal} instruments={summaries} latestAction={latestAction} indexMarket="hk" />
      </section>
      <ARollingEnergyMatrix
        instruments={summaries.map((s) => ({ instrumentName: s.name, symbol: s.symbol, exchange: s.exchange, timeline: s.timeline, startDate: s.startDate }))}
        formatTime={formatTime}
      />
      <ARollingAiAlerts alerts={summaries.flatMap((s) => s.sell_alerts)} />
    </main>
    <Footer />
    <QuoteLiveScripts />
    <script is:inline src="/js/a-rolling-status.js"></script>
    <script is:inline src="/js/a-rolling-app.js" data-market="hk"></script>
  </body>
</html>
