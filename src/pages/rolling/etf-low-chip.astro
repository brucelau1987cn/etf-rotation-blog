---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import RollingSubnav from '../../components/RollingSubnav.astro';
import { SITE_TITLE } from '../../consts';
import etfData from '../../../public/data/etf-low-chip-stocks.json';

const title = `低筹码ETF｜跟踪指数获利盘筛选 | ${SITE_TITLE}`;
const description = '跟踪指数收盘获利比例低于2%的股票型ETF筛选结果（指数筹码分布代理口径）。';
const fmt = (value: number | null | undefined, digits = 2) => value == null ? '—' : Number(value).toFixed(digits);
const fmtYi = (value: number | null | undefined) => value == null ? '—' : `${Number(value).toFixed(2)}亿`;
const fmtPct = (value: number | null | undefined, digits = 1) => value == null ? '—' : `${Number(value).toFixed(digits)}%`;

const CHAR_INITIAL: Record<string, string> = {
  华:'h',泰:'t',柏:'b',瑞:'r',上:'s',证:'z',科:'k',创:'c',易:'y',方:'f',达:'d',国:'g',嘉:'j',实:'s',
  建:'j',信:'x',富:'f',鹏:'p',东:'d',财:'c',工:'g',银:'y',南:'n',中:'z',券:'q',联:'l',康:'k',西:'x',
  部:'b',利:'l',得:'d',业:'y',板:'b',综:'z',合:'h',新:'x',能:'n',源:'y',电:'d',池:'c',安:'a',农:'n',
  金:'j',基:'j',深:'s',价:'j',值:'z',长:'c',江:'j',环:'h',保:'b',华:'h',宝:'b',兴:'x',广:'g',发:'f',
  华:'h',夏:'x',博:'b',时:'s',汇:'h',添:'t',富:'f',招:'z',商:'s',平:'p',人:'r',民:'m',生:'s',光:'g',
  大:'d',建:'j',设:'s',交:'j',通:'t',信:'x',海:'h',申:'s',万:'w',宏:'h',河:'h',君:'j',泰:'t',康:'k',
  东:'d',财:'c',工:'g',银:'y',前:'q',海:'h',开:'k',源:'y',华:'h',宝:'b',晶:'j',锐:'r',天:'t',弘:'h',
  恒:'h',越:'y',永:'y',盈:'y',浙:'z',商:'s',华:'h',富:'f',红:'h',塔:'t',广:'g',发:'f',华:'h',泰:'t',
  柏:'b',瑞:'r',上:'s',证:'z',科:'k',创:'c',鹏:'p',华:'h',中:'z',银:'y',证:'z',国:'g',联:'l',泰:'t',
  康:'k',西:'x',部:'b',利:'l',得:'d',华:'h',夏:'x',创:'c',业:'y',板:'b',综:'z',博:'b',时:'s',广:'g',
  发:'f',国:'g',证:'z',新:'x',能:'n',源:'y',电:'d',池:'c',深:'s',创:'c',价:'j',值:'z',华:'h',安:'a',
  农:'n',业:'y',银:'y',行:'h',基:'j',金:'j',汇:'h',添:'t',富:'f',中:'z',证:'z',沪:'h',深:'s',300:'3',
  500:'5',1000:'1',200:'2',50:'5',180:'1',创:'c',业:'y',板:'b',综:'z',合:'h',数:'s',字:'z',货:'h',
  币:'b',区:'q',块:'k',链:'l',人:'r',工:'g',智:'z',能:'n',机:'j',器:'q',元:'y',宇:'u',宙:'z',稀:'x',
  土:'t',有:'y',色:'s',煤:'m',炭:'t',钢:'g',铁:'t',建:'j',材:'c',汽:'q',车:'c',家:'j',纺:'f',织:'z',
  服:'f',装:'z',农:'n',林:'l',牧:'m',渔:'y',食:'s',品:'p',饮:'y',料:'l',酿:'n',酒:'j',旅:'l',游:'y',
  酒:'j',店:'d',航:'h',空:'k',机:'j',场:'c',港:'g',口:'k',公:'g',路:'l',铁:'t',路:'l',物:'w',流:'l',
  快:'k',递:'d',化:'h',石:'s',油:'y',气:'q',电:'d',力:'l',用:'y',水:'s',务:'w',垃:'l',圾:'j',分:'f',
  类:'l',生:'s',医:'y',药:'y',疫:'y',苗:'m',血:'x',液:'y',制:'z',品:'p',器:'q',械:'x',务:'w',养:'y',
  老:'l',育:'y',教:'j',培:'p',训:'x',体:'t',文:'w',娱:'y',游:'y',戏:'x',影:'y',视:'s',传:'c',媒:'m',
  广:'g',告:'g',营:'y',销:'x',软:'r',件:'j',数:'s',据:'j',云:'y',计:'j',算:'s',边:'b',缘:'y',物:'w',
  网:'w',制:'z',造:'z',互:'h',特:'t',高:'g',压:'y',充:'c',储:'c',氢:'q',风:'f',光:'g',热:'r',核:'h',
  水:'s',火:'h',纯:'c',碱:'j',玻:'b',璃:'l',泥:'n',材:'c',铝:'l',铜:'t',锌:'x',镍:'n',钴:'g',锂:'l',
  钨:'w',钼:'m',钛:'t',永:'y',磁:'c',超:'c',导:'d',碳:'t',纤:'x',维:'w',复:'f',半:'b',导:'d',体:'t',
  设:'s',备:'b',材:'c',料:'l',光:'g',刻:'k',胶:'j',掩:'y',膜:'m',靶:'b',化:'h',电:'d',学:'x',品:'p',
  军:'j',工:'g',防:'f',卫:'w',航:'h',天:'t',低:'d',空:'k',卫:'w',星:'x',导:'d',航:'h',无:'w',线:'x',
  通:'t',5:'5',6:'6',G:'g',算:'s',力:'l',存:'c',储:'c',芯:'x',片:'p',集:'j',成:'c',电:'d',路:'l',
  传:'c',感:'g',器:'q',封:'f',装:'z',测:'c',试:'s',消:'x',费:'f',电:'d',子:'z',智:'z',慧:'h',城:'c',
  市:'s',汽:'q',车:'c',零:'l',部:'b',件:'j',动:'d',力:'l',电:'d',池:'c',储:'c',氢:'h',燃:'r',料:'l',
  电:'d',池:'c',充:'c',换:'h',电:'d',桩:'z',逆:'n',变:'b',器:'q',光:'g',伏:'f',风:'f',电:'d',核:'h',
  电:'d',水:'s',电:'d',绿:'l',色:'s',碳:'t',中:'z',和:'h',专:'z',精:'j',特:'t',新:'x',小:'x',巨:'j',
  人:'r',专:'z',精:'j',特:'t',新:'x',创:'c',业:'y',板:'b',注:'z',册:'c',制:'z',改:'g',革:'g',
};
const nameInitials = (name: string) => {
  const raw = String(name || '').trim();
  if (!raw) return '';
  return Array.from(raw).map((ch) => /[A-Za-z0-9]/.test(ch) ? ch.toLowerCase() : CHAR_INITIAL[ch] || '').join('');
};

const PAGE_SIZE = 8;
const rows = etfData.etfs.map((row) => ({
  ...row,
  nameInitials: nameInitials(row.name),
}));
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={title} description={description} /></head>
  <body>
    <Header />
    <main id="main-content" class="low-chip-main site-shell">
      <RollingSubnav active="etf-low-chip" />

      <header class="low-chip-hero">
        <div>
          <p class="eyebrow">A股滚动 · ETF筹码筛选</p>
          <h1>低筹码ETF</h1>
          <p>股票型ETF中，跟踪指数收盘获利比例低于2%的标的。ETF本身无独立筹码分布，以跟踪指数的收盘获利比例（iWenCai指数口径）作为获利盘代理。</p>
        </div>
        <dl>
          <div><dt>筛选日期</dt><dd>{etfData.data_as_of}</dd></div>
          <div><dt>过滤后标的</dt><dd>{rows.length}只</dd></div>
        </dl>
      </header>

      <section class="chip-section" aria-labelledby="chip-title">
        <div class="chip-toolbar">
          <div class="chip-toolbar-left">
            <p class="eyebrow">跟踪指数同时满足</p>
            <h2 id="chip-title">指数收盘获利比例低于2%</h2>
          </div>
          <div class="chip-toolbar-right">
            <div class="chip-pager" id="chip-pager" data-page-size={PAGE_SIZE}>
              <button type="button" class="chip-page-btn" id="chip-page-prev" aria-label="上一页">上一页</button>
              <div class="chip-page-nums" id="chip-page-nums" role="navigation" aria-label="页码"></div>
              <button type="button" class="chip-page-btn" id="chip-page-next" aria-label="下一页">下一页</button>
              <span class="chip-page-meta" id="chip-page-meta">第 1 页</span>
            </div>
            <label class="chip-search-wrap">
              <span class="chip-search-label">检索</span>
              <input id="chip-search-input" class="chip-search-input" type="search" inputmode="search" autocomplete="off" spellcheck="false" placeholder="代码 / 名称 / 指数 / 首字母" />
            </label>
          </div>
        </div>

        <div class="chip-financial-filters" id="chip-financial-filters" aria-label="基金条件筛选">
          <button type="button" class="chip-filter-btn" data-filter="scale-1" aria-pressed="false">规模 ≥ 1亿</button>
          <button type="button" class="chip-filter-btn" data-filter="scale-10" aria-pressed="false">规模 ≥ 10亿</button>
          <button type="button" class="chip-filter-btn" data-filter="t0" aria-pressed="false">仅 T+0</button>
          <button type="button" class="chip-filter-reset" id="chip-filter-reset">清除</button>
          <span class="chip-filter-meta" id="chip-filter-meta">未启用筛选</span>
        </div>

        <div class="chip-list" id="chip-list">
          {rows.map((row, index) => (
            <div
              class="chip-row"
              data-symbol={row.code}
              data-name={row.name}
              data-initials={row.nameInitials}
              data-index={row.track_index}
              data-scale={row.scale_yi}
              data-t0={row.t0 ? '1' : '0'}
              data-board-index={index}
              hidden={index >= PAGE_SIZE}
            >
              <div class="chip-row-top">
                <div class="chip-row-main">
                  <div class="chip-identity"><strong class="chip-row-name">{row.name}</strong><span class="chip-row-code">{row.code}</span></div>
                  <span class="chip-industry" title={`跟踪指数：${row.track_index} · 收盘获利比例 ${fmtPct(row.index_profit)}`}>{row.track_index} <em class="chip-idx-profit">{fmtPct(row.index_profit)}</em></span>
                  {row.t0 ? <span class="chip-quality" title="支持 T+0 交易">T+0 ✓</span> : null}
                </div>
                <div class="chip-row-metrics" aria-label="指数获利比例">
                  <span class="chip-metric"><em class="chip-val">{fmtPct(row.index_profit)}</em><small>指数获利</small></span>
                  <span class="chip-metric"><em class="chip-val">{fmtYi(row.scale_yi)}</em><small>规模</small></span>
                  <span class="chip-metric"><em class="chip-val">{fmtYi(row.shares_yi)}</em><small>份额</small></span>
                </div>
                <div class="chip-row-footer">
                  <span class="chip-price">¥{fmt(row.price)}</span>
                  <span class:list={['chip-change', (row.change_percent ?? 0) >= 0 ? 'chip-up' : 'chip-down']}>{(row.change_percent ?? 0) >= 0 ? '+' : ''}{fmt(row.change_percent)}%</span>
                </div>
              </div>
              <div class="chip-row-shareholders" aria-label={`${row.name}基金指标`}>
                <button type="button" class="chip-shr-toggle" aria-expanded="false">
                  <span>基金指标</span><i class="chip-shr-chev" aria-hidden="true">▾</i>
                </button>
                <div class="chip-shr-head" aria-hidden="true">
                  <span>基金规模</span><span>基金份额</span><span>指数获利</span><span>类型</span><span>T+0</span>
                </div>
                <div class="chip-shr-body">
                  <span><strong>{fmtYi(row.scale_yi)}</strong></span>
                  <span><strong>{fmtYi(row.shares_yi)}</strong></span>
                  <span><strong>{fmtPct(row.index_profit)}</strong></span>
                  <span><strong class="chip-type-cell">{row.type || '—'}</strong></span>
                  <span><strong>{row.t0 ? '是' : '—'}</strong></span>
                </div>
              </div>
            </div>
          ))}
          <div class="chip-row chip-row-empty" id="chip-search-empty" hidden>
            <strong>没有匹配标的</strong>
            <span>换个代码、名称或指数试试</span>
          </div>
        </div>
      </section>

      <footer class="data-note">
        <strong>数据来源：iWenCai + 腾讯行情</strong>
        <span>筛选日期：{etfData.data_as_of} · 指标：跟踪指数收盘获利比例（代理口径） · 阈值：低于2% · 范围：股票型ETF</span>
        <p>ETF无独立筹码分布字段，本页以 iWenCai 指数的「收盘获利比例」作为获利盘代理：获利比例越低，表示跟踪指数处于套牢盘密集区。覆盖 {etfData.counts.low_profit_indices} 个低获利指数中的 {etfData.counts.matched_indices} 个可映射指数（{etfData.counts.matched_etfs} 只ETF）。价格与涨跌幅来自腾讯行情，指数获利来自 iWenCai。</p>
      </footer>
    </main>
    <Footer />

    <script is:inline>
    (function() {
      var list = document.getElementById('chip-list');
      var pager = document.getElementById('chip-pager');
      var nums = document.getElementById('chip-page-nums');
      var meta = document.getElementById('chip-page-meta');
      var prevBtn = document.getElementById('chip-page-prev');
      var nextBtn = document.getElementById('chip-page-next');
      var searchInput = document.getElementById('chip-search-input');
      var empty = document.getElementById('chip-search-empty');
      var filterButtons = Array.from(document.querySelectorAll('.chip-filter-btn'));
      var filterReset = document.getElementById('chip-filter-reset');
      var filterMeta = document.getElementById('chip-filter-meta');
      var shrToggles = Array.from(list.querySelectorAll('.chip-shr-toggle'));
      if (!list || !pager || !nums || !meta || !prevBtn || !nextBtn) return;

      var PAGE_SIZE = Math.max(1, Number(pager.dataset.pageSize || 8));
      var rows = Array.from(list.querySelectorAll('.chip-row:not(.chip-row-empty)'));
      if (!rows.length) return;

      var page = 1;
      var query = '';
      var activeFilters = new Set();

      function normalize(v) { return String(v || '').trim().toLowerCase().replace(/\s+/g, ''); }

      function filtered() {
        return rows.filter(function(c) {
          var sym = String(c.dataset.symbol || '').toLowerCase();
          var name = String(c.dataset.name || '').toLowerCase();
          var initials = String(c.dataset.initials || '').toLowerCase();
          var indexName = String(c.dataset.index || '').toLowerCase();
          var searchMatched = !query || sym.indexOf(query) !== -1 || name.indexOf(query) !== -1 || initials.indexOf(query) !== -1 || initials.indexOf(query) === 0 || indexName.indexOf(query) !== -1;
          if (!searchMatched) return false;
          if (activeFilters.has('scale-1') && Number(c.dataset.scale) < 1) return false;
          if (activeFilters.has('scale-10') && Number(c.dataset.scale) < 10) return false;
          if (activeFilters.has('t0') && c.dataset.t0 !== '1') return false;
          return true;
        });
      }

      function render() {
        var matched = filtered();
        var totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
        if (page > totalPages) page = totalPages;
        if (page < 1) page = 1;
        var start = (page - 1) * PAGE_SIZE;
        var end = start + PAGE_SIZE;
        var visible = matched.slice(start, end);

        rows.forEach(function(c) { c.hidden = true; });
        visible.forEach(function(c) { c.hidden = false; });
        if (empty) empty.hidden = matched.length > 0;

        var showPager = matched.length > PAGE_SIZE;
        pager.hidden = !showPager;
        meta.textContent = matched.length ? '\u7B2C ' + page + '/' + totalPages + ' \u9875 \u00B7 ' + matched.length + ' \u53EA' : '\u65E0\u5339\u914D';
        if (filterMeta) filterMeta.textContent = activeFilters.size ? '\u5DF2\u542F\u7528 ' + activeFilters.size + ' \u9879 \u00B7 ' + matched.length + ' \u53EA' : '\u672A\u542F\u7528\u7B5B\u9009';

        nums.replaceChildren();
        if (showPager) {
          for (var i = 1; i <= totalPages; i++) {
            (function(p) {
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'chip-page-num' + (i === page ? ' is-active' : '');
              btn.textContent = String(i);
              btn.setAttribute('aria-label', '\u7B2C ' + i + ' \u9875');
              if (i === page) btn.setAttribute('aria-current', 'page');
              btn.addEventListener('click', function() { page = p; render(); });
              nums.appendChild(btn);
            })(i);
          }
        }
        prevBtn.disabled = page <= 1 || matched.length === 0;
        nextBtn.disabled = page >= totalPages || matched.length === 0;
      }

      prevBtn.addEventListener('click', function() { if (page > 1) { page--; render(); } });
      nextBtn.addEventListener('click', function() { page++; render(); });
      if (searchInput) {
        searchInput.addEventListener('input', function() { query = normalize(searchInput.value); page = 1; render(); });
      }
      filterButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var key = btn.dataset.filter;
          if (!key) return;
          if (activeFilters.has(key)) activeFilters.delete(key); else activeFilters.add(key);
          btn.classList.toggle('is-active', activeFilters.has(key));
          btn.setAttribute('aria-pressed', activeFilters.has(key) ? 'true' : 'false');
          page = 1;
          render();
        });
      });
      if (filterReset) filterReset.addEventListener('click', function() {
        activeFilters.clear();
        filterButtons.forEach(function(btn) { btn.classList.remove('is-active'); btn.setAttribute('aria-pressed', 'false'); });
        page = 1;
        render();
      });
      shrToggles.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var row = btn.closest('.chip-row');
          if (!row) return;
          var open = row.classList.toggle('is-shr-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      });
      render();
    })();
    </script>
  </body>
</html>

<style is:global>
  .low-chip-main{padding-bottom:3rem;color:#14243b}
  .low-chip-hero,.chip-section,.data-note{border:1px solid #dbe3ec;border-radius:14px;background:#fff}
  .low-chip-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.25rem;padding:1.35rem}
  .eyebrow{margin:0 0 .35rem;color:#64748b;font-size:.75rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
  h1,h2,p{margin-top:0}.low-chip-hero h1{margin-bottom:.45rem;font-size:2rem}.low-chip-hero p:last-child{max-width:720px;margin-bottom:0;color:#526176;line-height:1.7}
  .low-chip-hero dl{display:grid;grid-template-columns:repeat(2,minmax(82px,1fr));gap:.5rem;margin:0}
  .low-chip-hero dl div{padding:.65rem .8rem;border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc}
  dt{color:#64748b;font-size:.72rem;font-weight:800}dd{margin:.2rem 0 0;font-size:1rem;font-weight:900}

  .chip-section{margin-top:1rem;overflow:hidden}
  .chip-toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.2rem;border-left:4px solid #d97706;border-bottom:1px solid #e2e8f0}
  .chip-toolbar h2{margin:0;font-size:1.15rem}
  .chip-toolbar-right{display:flex;align-items:center;justify-content:flex-end;gap:.75rem;flex-wrap:wrap}
  .chip-search-wrap{display:flex;align-items:center;gap:.5rem}
  .chip-search-label{color:#64748b;font-size:.82rem;font-weight:800}
  .chip-search-input{width:200px;height:2.1rem;padding:0 .9rem;border:1px solid #dbe3ec;border-radius:999px;font-size:.82rem;font-weight:650;outline:0;transition:border-color .15s}
  .chip-search-input:focus{border-color:#93c5fd;box-shadow:0 0 0 3px rgba(59,130,246,.12)}

  .chip-pager{display:inline-flex;align-items:center;gap:.35rem;flex-wrap:wrap}
  .chip-page-btn,.chip-page-num{min-width:2rem;height:1.95rem;padding:0 .7rem;border:1px solid #dbe3ec;border-radius:999px;background:#fff;color:#334155;font-size:.74rem;font-weight:750;cursor:pointer;transition:all .12s}
  .chip-page-btn:hover:not(:disabled),.chip-page-num:hover:not(.is-active){background:#f0f2f5;border-color:#b0bec5}
  .chip-page-btn:disabled{opacity:.4;cursor:default}
  .chip-page-nums{display:inline-flex;align-items:center;gap:.25rem}
  .chip-page-num{display:inline-flex;align-items:center;justify-content:center;padding:0 .35rem}
  .chip-page-num.is-active{color:#1d4ed8;border-color:#93c5fd;background:#eff6ff}
  .chip-page-meta{margin-left:.15rem;color:#64748b;font-size:.72rem;font-weight:700;white-space:nowrap}
  .chip-pager[hidden],.chip-row[hidden]{display:none!important}
  .chip-financial-filters{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;padding:.65rem 1.2rem;border-bottom:1px solid #e2e8f0;background:#fafbfc}
  .chip-filter-btn,.chip-filter-reset{height:1.95rem;padding:0 .7rem;border:1px solid #dbe3ec;border-radius:999px;background:#fff;color:#475569;font-size:.72rem;font-weight:750;cursor:pointer}
  .chip-filter-btn.is-active{border-color:#93c5fd;background:#eff6ff;color:#1d4ed8}
  .chip-filter-reset{color:#64748b}
  .chip-filter-meta{margin-left:auto;color:#64748b;font-size:.72rem;font-weight:700;white-space:nowrap}

  .chip-list{display:flex;flex-direction:column}
  .chip-row{display:flex;flex-direction:column;gap:.55rem;padding:.7rem 1.2rem;border-bottom:1px solid #edf1f5;transition:background .1s}
  .chip-row:hover{background:#f8fafc}
  .chip-row:last-child{border-bottom:0}
