---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import LowChipModeNav from '../../../components/LowChipModeNav.astro';
import RollingSubnav from '../../../components/RollingSubnav.astro';
import { SITE_TITLE } from '../../../consts';
import trackingData from '../../../../public/data/low-chip-tracking.json';

const title = `低筹码追踪｜加入以来表现 | ${SITE_TITLE}`;
const description = '内部模型观察标的加入以来每日走势与跟踪指标统计。';

const fmt = (v: number | null | undefined, digits = 2) => v == null ? '—' : Number(v).toFixed(digits);
const controlLevel = (label: string | null | undefined) => String(label || '').replace(/控盘/g, '') || '—';

const stocks = Object.entries(trackingData.stocks || {})
  .map(([symbol, rec]) => {
    const daily = (rec.daily || []).slice(1); // 加入当日不算，隔日股价算第一日
    const closes = daily.map((d) => d.close).filter((v) => v != null);
    const profits = daily.map((d) => d.profit_ratio).filter((v) => v != null);
    const firstClose = closes.length ? closes[0] : null;
    const lastClose = closes.length ? closes[closes.length - 1] : null;
    const maxClose = closes.length ? Math.max(...closes) : null;
    const minClose = closes.length ? Math.min(...closes) : null;
    const firstProfit = profits.length ? profits[0] : null;
    const lastProfit = profits.length ? profits[profits.length - 1] : null;
    let peak = firstClose;
    let maxDrawdown = 0;
    for (const close of closes) {
      if (peak == null || close > peak) peak = close;
      if (peak > 0) maxDrawdown = Math.min(maxDrawdown, ((close - peak) / peak) * 100);
    }
    const maxGain = firstClose != null && maxClose != null ? ((maxClose - firstClose) / firstClose) * 100 : null;
    return {
      symbol, ...rec, daily,
      joinClose: (rec.daily || [])[0]?.close ?? null,
      latestStoredDate: (rec.daily || []).at(-1)?.date ?? '',
      firstClose, lastClose, maxClose, minClose, firstProfit, lastProfit,
      maxGain, maxDrawdown,
      totalChange: firstClose != null && lastClose != null ? ((lastClose - firstClose) / firstClose) * 100 : null,
      profitChange: firstProfit != null && lastProfit != null ? lastProfit - firstProfit : null,
    };
  })
  .sort((a, b) => (b.first_seen || '').localeCompare(a.first_seen || ''));
const activeStocks = stocks.filter((s) => !s.tracking_complete);
const historyStocks = stocks.filter((s) => Boolean(s.tracking_complete));
const validChanges = activeStocks.map((s) => s.totalChange).filter((v): v is number => v != null && Number.isFinite(v));
const risingCount = validChanges.filter((v) => v > 0).length;
const risingRatio = validChanges.length ? (risingCount / validChanges.length) * 100 : 0;
const sortedChanges = [...validChanges].sort((a, b) => a - b);
const medianChange = sortedChanges.length
  ? (sortedChanges.length % 2
    ? sortedChanges[(sortedChanges.length - 1) / 2]
    : (sortedChanges[sortedChanges.length / 2 - 1] + sortedChanges[sortedChanges.length / 2]) / 2)
  : 0;
const strongestChange = validChanges.length ? Math.max(...validChanges) : 0;

// ── SVG 图表辅助 ─────────────────────────────────────────────
// 返回 { points, areaPoints, lastX, lastY, min, max }，空则 null
function chartGeom(values: number[], W: number, H: number, PAD = 4) {
  if (values.length < 2) return null;
  const min = Math.min(...values), max = Math.max(...values);
  const range = max - min || 1;
  const pts = values.map((v, i) => {
    const x = PAD + (i / (values.length - 1)) * (W - PAD * 2);
    const y = H - PAD - ((v - min) / range) * (H - PAD * 2);
    return [x, y] as const;
  });
  const last = pts[pts.length - 1];
  return {
    points: pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' '),
    area: `M${pts[0][0].toFixed(1)},${H} L${pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' L')} L${last[0].toFixed(1)},${H} Z`,
    lastX: last[0], lastY: last[1], min, max,
  };
}
const UP = '#e04444', DOWN = '#0aa869', PROFIT = '#7c5cd6', GRID = '#eef1f5';
---
<BaseHead title={title} description={description} />
<body>
  <Header />
  <main class="site-shell">
    <RollingSubnav active="low-chip" />
    <LowChipModeNav active="tracking" trackingCount={activeStocks.length} />

    <section class="tc-overview" aria-labelledby="tc-title">
      <div class="tc-header">
        <p class="tc-eyebrow">A股滚动 · 低筹码追踪</p>
        <h1 id="tc-title">低筹码追踪</h1>
        <p class="tc-desc">从股票首次进入内部模型观察列表起追踪，记录加入后 20 个交易日的市场表现。加入当日作为基准，隔日起算第 1 日；完成窗口后自动进入历史区。</p>
        <p class="tc-overview-meta">当前追踪 <strong>{activeStocks.length}</strong> 只 · 历史 <strong>{historyStocks.length}</strong> 只</p>
      </div>

      <div class="tc-summary" aria-label="追踪概览">
        <div class="tc-summary-stat"><strong>{activeStocks.length}</strong><span>追踪中</span></div>
        <div class="tc-summary-stat"><strong id="tc-summary-rising">{validChanges.length ? `${fmt(risingRatio, 1)}%` : '—'}</strong><span>上涨占比 <small id="tc-summary-rising-count">{risingCount}/{validChanges.length}</small></span></div>
        <div class="tc-summary-stat"><strong id="tc-summary-median" class:list={[validChanges.length && (medianChange >= 0 ? 'tc-up' : 'tc-down')]}>{validChanges.length ? `${medianChange >= 0 ? '+' : ''}${fmt(medianChange, 1)}%` : '—'}</strong><span>中位涨幅</span></div>
        <div class="tc-summary-stat"><strong id="tc-summary-strongest" class:list={[validChanges.length && (strongestChange >= 0 ? 'tc-up' : 'tc-down')]}>{validChanges.length ? `${strongestChange >= 0 ? '+' : ''}${fmt(strongestChange, 1)}%` : '—'}</strong><span>当前最大涨幅 <small id="tc-summary-mode" aria-live="polite">收盘统计</small></span></div>
      </div>
    </section>

    <div class="tc-toolbar">
      <span class="tc-toolbar-label">状态</span>
      <button type="button" class="tc-sort-btn is-active" id="tc-view-active" aria-pressed="true">追踪中 {activeStocks.length}</button>
      <button type="button" class="tc-sort-btn" id="tc-view-history" aria-pressed="false">已完成 {historyStocks.length}</button>
      <span class="tc-toolbar-divider" aria-hidden="true"></span>
      <span class="tc-toolbar-label">排序</span>
      <button type="button" class="tc-sort-btn is-active is-sort" id="tc-sort-days" aria-pressed="true">加入日</button>
      <button type="button" class="tc-sort-btn is-sort" id="tc-sort-change" aria-pressed="false">涨幅</button>
      <span class="tc-toolbar-divider" aria-hidden="true"></span>
      <label class="tc-search-wrap" for="tc-search-input">
        <span>搜索</span>
        <input id="tc-search-input" type="search" inputmode="search" autocomplete="off" spellcheck="false" placeholder="代码 / 名称" />
      </label>
      <span class="tc-toolbar-divider" aria-hidden="true"></span>
      <label class="tc-star-switch" for="tc-star-toggle">
        <input type="checkbox" id="tc-star-toggle" checked />
        <span class="tc-star-track" aria-hidden="true"><span></span></span>
        <span>包含科创板</span>
      </label>
      <nav class="tc-pagination" id="tc-pagination" aria-label="跟踪股票分页">
        <button type="button" id="tc-page-prev" class="tc-page-btn">上一页</button>
        <span id="tc-page-status" class="tc-page-status" aria-live="polite">第 1 / 1 页</span>
        <button type="button" id="tc-page-next" class="tc-page-btn">下一页</button>
      </nav>
      <span class="tc-filter-count" id="tc-filter-count">显示 {stocks.length} 只</span>
    </div>

    <div class="tc-financial-filters" id="tc-financial-filters" aria-label="财务与股东条件筛选">
      <button type="button" class="tc-filter-btn" data-filter="roe" aria-pressed="false">ROE ≥ 15%</button>
      <button type="button" class="tc-filter-btn" data-filter="net-margin" aria-pressed="false">净利率 ≥ 15%</button>
      <button type="button" class="tc-filter-btn" data-filter="cash-profit" aria-pressed="false">现金流/净利润 ≥ 20%</button>
      <button type="button" class="tc-filter-btn" data-filter="gross-margin" aria-pressed="false">毛利率 ≥ 15%</button>
      <button type="button" class="tc-filter-btn" data-filter="debt-ratio" aria-pressed="false">负债率 ≤ 30%</button>
      <button type="button" class="tc-filter-btn" data-filter="quality-shareholder" aria-pressed="false">优质股东</button>
      <button type="button" class="tc-filter-btn" data-filter="institutional-shareholder" aria-pressed="false">机构股东</button>
      <button type="button" class="tc-filter-reset" id="tc-filter-reset">清除</button>
      <span class="tc-filter-meta" id="tc-filter-meta">未启用筛选</span>
    </div>

    <section class="tc-list" id="tc-list" aria-label="追踪股票列表">
      {stocks.length === 0 && (
        <div class="tc-empty">
          <strong>暂无追踪数据</strong>
          <span>每日流水线生成模型观察快照后自动开始记录。</span>
        </div>
      )}
      {stocks.map((rec) => {
        const cGeom = chartGeom(rec.daily.map((d) => d.close).filter((v) => v != null), 220, 56);
        const pGeom = chartGeom(rec.daily.map((d) => d.profit_ratio).filter((v) => v != null), 220, 56);
        const up = (rec.totalChange ?? 0) >= 0;
        return (
          <article class="tc-card" data-live-symbol={rec.symbol} data-first-close={rec.firstClose == null ? '' : rec.firstClose} data-latest-date={rec.latestStoredDate || ''} data-first-seen={rec.first_seen || ''} data-total-change={rec.totalChange == null ? 'null' : rec.totalChange} data-roe={rec.entry_financials?.roe ?? ''} data-net-margin={rec.entry_financials?.net_margin ?? ''} data-cash-profit={rec.entry_financials?.cash_profit_ratio ?? ''} data-gross-margin={rec.entry_financials?.gross_margin ?? ''} data-debt-ratio={rec.entry_financials?.debt_ratio ?? ''} data-quality-shareholder={rec.entry_features?.quality_shareholder ? '1' : '0'} data-institutional-shareholder={rec.entry_features?.institutional_shareholder ? '1' : '0'} data-star-market={rec.symbol.split('.')[0].startsWith('688') ? '1' : '0'} data-tracking-status={rec.tracking_complete ? 'history' : 'active'}>
            <div class="tc-head">
              <div class="tc-id">
                <strong class="tc-name">{rec.name || '—'}</strong>
                <span class="tc-code">{rec.symbol.split('.')[0]}</span>
                {rec.industry && <span class="tc-industry">{rec.industry.split('--').pop()}</span>}
              </div>
              <div class="tc-badges">
                <span class="tc-badge tc-badge-join" title={`首次进入观察列表 ${rec.first_seen}`}>加入 {rec.first_seen}</span>
                <span class="tc-badge tc-progress-label">第{rec.daily.length}/20日</span>
              </div>
            </div>
            <div
              class="tc-progress"
              role="progressbar"
              aria-label={`20日追踪进度 ${rec.daily.length}/20`}
              aria-valuemin="0"
              aria-valuemax="20"
              aria-valuenow={Math.min(rec.daily.length, 20)}
            >
              <span class="tc-progress-bar" style={`width:${Math.min(rec.daily.length, 20) / 20 * 100}%`}></span>
            </div>

            <div class="tc-model-tags" aria-label="加入时模型标签">
              {rec.entry_features?.quality_shareholder && (
                <span class="tc-feature tc-feature-quality" title={`加入时优质股东：${(rec.entry_features.quality_shareholder_names || []).join('、') || '已识别'}`}>优质股东 <b aria-hidden="true">✓</b></span>
              )}
              {rec.entry_features?.institutional_shareholder && (
                <span class="tc-feature tc-feature-institutional" title={`加入时机构股东：${(rec.entry_features.institutional_shareholder_names || []).join('、') || '已识别'}`}>机构股东 <b aria-hidden="true">●</b></span>
              )}
              {rec.entry_features?.chip_focus && (
                <span class:list={['tc-feature', 'tc-feature-focus', rec.entry_features.chip_focus.includes('集中') && 'is-concentrated']}><small>筹码集中度</small><strong>{rec.entry_features.chip_focus}</strong></span>
              )}
              {rec.entry_features?.main_force != null && (
                <span class="tc-feature tc-feature-control"><small>主力控盘</small><strong>{fmt(rec.entry_features.main_force)}（{controlLevel(rec.entry_features.main_force_label)}）</strong></span>
              )}
            </div>

            <div class="tc-change-row">
              <span class:list={['tc-change', up ? 'tc-up' : 'tc-down']} data-live-change>{up ? '▲' : '▼'} {fmt(rec.totalChange)}%</span>
              <span class="tc-live-badge" data-live-badge hidden>盘中</span>
              <span
                class="tc-vol-tag-slot vol-tag vol-tag-amber"
                data-price-volume-symbol={`${rec.symbol.split('.')[0].startsWith('6') ? '17' : '33'}_${rec.symbol.split('.')[0]}`}
                aria-label="量价12态"
                hidden
              ></span>
            </div>
            <div class="tc-live-summary-row">
              <span class="tc-change-sub" data-live-summary>加入以来 · ¥{fmt(rec.firstClose)} → ¥{fmt(rec.lastClose)}</span>
            </div>

            <div class="tc-charts">
              <div class="tc-chart tc-price-chart" data-price-closes={JSON.stringify(rec.daily.map((d) => d.close).filter((v) => v != null))} data-chart-anchor={rec.joinClose == null ? '' : rec.joinClose}>
                <div class="tc-chart-title">
                  <span>股价走势</span>
                  <em>最高 ¥{fmt(rec.maxClose)} / 最低 ¥{fmt(rec.minClose)}</em>
                </div>
                <svg viewBox="0 0 220 56" width="100%" height="56" preserveAspectRatio="none" aria-hidden="true">
                  {[0.25, 0.5, 0.75].map((f) => (
                    <line x1="0" x2="220" y1={(56 * f).toFixed(1)} y2={(56 * f).toFixed(1)} stroke={GRID} stroke-width="1" />
                  ))}
                  <path class="tc-price-area" d={cGeom?.area || ''} fill={up ? `${UP}1a` : `${DOWN}1a`} />
                  <polyline class="tc-price-line" points={cGeom?.points || ''} fill="none" stroke={up ? UP : DOWN} stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" />
                  <circle class="tc-price-point" cx={cGeom?.lastX || 0} cy={cGeom?.lastY || 0} r="2.6" fill={up ? UP : DOWN} stroke="#fff" stroke-width="1.2" />
                  <line class="tc-live-connector" x1="0" y1="0" x2="0" y2="0" stroke={up ? UP : DOWN} stroke-width="1.8" stroke-dasharray="4 3" hidden />
                  <circle class="tc-live-point" cx="0" cy="0" r="3" fill="#fff" stroke={up ? UP : DOWN} stroke-width="1.8" hidden />
                  <text class="tc-live-label" x="0" y="0" fill={up ? UP : DOWN} font-size="8" font-weight="800" text-anchor="end" hidden>今</text>
                </svg>
              </div>
              <div class="tc-chart">
                <div class="tc-chart-title">
                  <span>获利盘指数</span>
                  <em>{fmt(rec.firstProfit)}% → {fmt(rec.lastProfit)}%</em>
                </div>
                {pGeom && (
                  <svg viewBox="0 0 220 56" width="100%" height="56" preserveAspectRatio="none" aria-hidden="true">
                    {[0.25, 0.5, 0.75].map((f) => (
                      <line x1="0" x2="220" y1={(56 * f).toFixed(1)} y2={(56 * f).toFixed(1)} stroke={GRID} stroke-width="1" />
                    ))}
                    <path d={pGeom.area} fill={`${PROFIT}1a`} />
                    <polyline points={pGeom.points} fill="none" stroke={PROFIT} stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" />
                    <circle cx={pGeom.lastX} cy={pGeom.lastY} r="2.6" fill={PROFIT} stroke="#fff" stroke-width="1.2" />
                  </svg>
                )}
              </div>
            </div>

            <div class="tc-metrics">
              <div class="tc-metric">
                <span class="tc-label">最高涨幅</span>
                <strong class:list={[(rec.maxGain ?? 0) >= 0 ? 'tc-up' : 'tc-down']}>{(rec.maxGain ?? 0) >= 0 ? '+' : ''}{fmt(rec.maxGain)}%</strong>
              </div>
              <div class="tc-metric">
                <span class="tc-label">最大回撤</span>
                <strong class="tc-down">{fmt(rec.maxDrawdown)}%</strong>
              </div>
              <div class="tc-metric">
                <span class="tc-label">获利盘变化</span>
                <strong class:list={[(rec.profitChange ?? 0) >= 0 ? 'tc-up' : 'tc-down']}>
                  {(rec.profitChange ?? 0) >= 0 ? '+' : ''}{fmt(rec.profitChange)}pp
                </strong>
              </div>
              <div class="tc-metric">
                <span class="tc-label">剩余天数</span>
                <strong>{Math.max(0, 20 - rec.daily.length)}天</strong>
              </div>
            </div>

            <details class="tc-table-details" data-settled-days={rec.daily.length}>
              <summary>每日明细（{rec.daily.length} 天）</summary>
              <table class="tc-table">
                <thead>
                  <tr><th>日期</th><th>收盘价</th><th>涨跌幅</th><th>获利盘 %</th></tr>
                </thead>
                <tbody data-live-table-body>
                  {(rec.daily || []).map((day: any) => (
                    <tr>
                      <td class="tc-date">{day.date}</td>
                      <td>¥{fmt(day.close)}</td>
                      <td class:list={day.change_pct != null && day.change_pct >= 0 ? 'tc-up' : 'tc-down'}>{day.change_pct == null ? '—' : `${day.change_pct >= 0 ? '+' : ''}${fmt(day.change_pct)}%`}</td>
                      <td>{day.profit_ratio == null ? '—' : `${fmt(day.profit_ratio)}%`}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          </article>
        );
      })}
      <div class="tc-empty" id="tc-filter-empty" hidden>
        <strong>没有匹配标的</strong>
        <span>调整状态、搜索词或“包含科创板”后再试。</span>
      </div>
    </section>

    <footer class="data-note">
      <strong>数据来源：腾讯日线（前复权）+ 同花顺市场数据</strong>
      <span>展示加入观察列表后的价格与市场指标变化，模型规则及参数保持私密。</span>
    </footer>
  </main>
  <Footer />
  <script is:inline src="/js/normalize-quote-payload.js"></script>
  <script is:inline src="/js/etf-live-poll.js"></script>
  <script is:inline src="/js/price-volume-tag.js"></script>
  <script is:inline src="/js/low-chip-tracking-live.js"></script>
  <script>
    ;(function() {
      var list = document.getElementById('tc-list');
      var sortDays = document.getElementById('tc-sort-days');
      var sortChange = document.getElementById('tc-sort-change');
      var searchInput = document.getElementById('tc-search-input');
      var starToggle = document.getElementById('tc-star-toggle');
      var filterCount = document.getElementById('tc-filter-count');
      var filterEmpty = document.getElementById('tc-filter-empty');
      var filterButtons = Array.from(document.querySelectorAll('.tc-filter-btn'));
      var filterReset = document.getElementById('tc-filter-reset');
      var filterMeta = document.getElementById('tc-filter-meta');
      var viewActive = document.getElementById('tc-view-active');
      var viewHistory = document.getElementById('tc-view-history');
      var pagination = document.getElementById('tc-pagination');
      var pagePrev = document.getElementById('tc-page-prev');
      var pageNext = document.getElementById('tc-page-next');
      var pageStatus = document.getElementById('tc-page-status');
      if (!list || !sortDays || !sortChange || !starToggle || !viewActive || !viewHistory || !pagination || !pagePrev || !pageNext || !pageStatus) return;
      var items = Array.from(list.querySelectorAll('.tc-card'));
      var PAGE_SIZE = 12;
      var currentPage = 1;
      var filteredItems = [];
      var storageKey = 'low_chip_tracking_include_star';
      var viewStorageKey = 'low_chip_tracking_view';
      var currentView = localStorage.getItem(viewStorageKey) === 'history' ? 'history' : 'active';
      var query = '';
      var activeFilters = new Set();
      var saved = localStorage.getItem(storageKey);
      if (saved === '0') starToggle.checked = false;
      function normalize(value) { return String(value || '').trim().toLowerCase().replace(/\s+/g, ''); }
      function renderPagination() {
        var totalPages = Math.max(1, Math.ceil(filteredItems.length / PAGE_SIZE));
        currentPage = Math.min(Math.max(1, currentPage), totalPages);
        var start = (currentPage - 1) * PAGE_SIZE;
        var visiblePage = new Set(filteredItems.slice(start, start + PAGE_SIZE));
        items.forEach(function(el) { el.hidden = !visiblePage.has(el); });
        pagePrev.disabled = currentPage <= 1;
        pageNext.disabled = currentPage >= totalPages;
        pageStatus.textContent = '第 ' + currentPage + ' / ' + totalPages + ' 页 · 共 ' + filteredItems.length + ' 只';
        pagination.hidden = filteredItems.length === 0;
        if (filterEmpty) filterEmpty.hidden = filteredItems.length > 0;
      }
      function applyFilter(resetPage) {
        filteredItems = items.filter(function(el) {
          var name = normalize(el.querySelector('.tc-name')?.textContent);
          var code = normalize(el.querySelector('.tc-code')?.textContent);
          var searchMatched = !query || name.indexOf(query) !== -1 || code.indexOf(query) !== -1;
          var financialMatched = (!activeFilters.has('roe') || (el.dataset.roe !== '' && Number.isFinite(Number(el.dataset.roe)) && Number(el.dataset.roe) >= 15))
            && (!activeFilters.has('net-margin') || (el.dataset.netMargin !== '' && Number.isFinite(Number(el.dataset.netMargin)) && Number(el.dataset.netMargin) >= 15))
            && (!activeFilters.has('cash-profit') || (el.dataset.cashProfit !== '' && Number.isFinite(Number(el.dataset.cashProfit)) && Number(el.dataset.cashProfit) >= 20))
            && (!activeFilters.has('gross-margin') || (el.dataset.grossMargin !== '' && Number.isFinite(Number(el.dataset.grossMargin)) && Number(el.dataset.grossMargin) >= 15))
            && (!activeFilters.has('debt-ratio') || (el.dataset.debtRatio !== '' && Number.isFinite(Number(el.dataset.debtRatio)) && Number(el.dataset.debtRatio) <= 30))
            && (!activeFilters.has('quality-shareholder') || el.dataset.qualityShareholder === '1')
            && (!activeFilters.has('institutional-shareholder') || el.dataset.institutionalShareholder === '1');
          return el.dataset.trackingStatus === currentView && searchMatched && financialMatched && (starToggle.checked || el.dataset.starMarket !== '1');
        });
        if (resetPage) currentPage = 1;
        if (filterCount) filterCount.textContent = '匹配 ' + filteredItems.length + ' 只';
        if (filterMeta) filterMeta.textContent = activeFilters.size ? '已启用 ' + activeFilters.size + ' 项 · ' + filteredItems.length + ' 只' : '未启用筛选';
        viewActive.classList.toggle('is-active', currentView === 'active');
        viewActive.setAttribute('aria-pressed', currentView === 'active' ? 'true' : 'false');
        viewHistory.classList.toggle('is-active', currentView === 'history');
        viewHistory.setAttribute('aria-pressed', currentView === 'history' ? 'true' : 'false');
        renderPagination();
      }
      function sortByDays() {
        items.sort(function(a, b) {
          return (b.dataset.firstSeen || '').localeCompare(a.dataset.firstSeen || ''); // 最新加入在前（降序）
        });
        items.forEach(function(el) { list.appendChild(el); });
        sortDays.classList.add('is-active'); sortDays.setAttribute('aria-pressed', 'true');
        sortChange.classList.remove('is-active'); sortChange.setAttribute('aria-pressed', 'false');
        applyFilter(false);
      }
      function sortByChange() {
        items.sort(function(a, b) {
          var va = parseFloat(a.dataset.totalChange);
          var vb = parseFloat(b.dataset.totalChange);
          if (isNaN(va)) return 1;
          if (isNaN(vb)) return -1;
          return vb - va; // 涨幅降序
        });
        items.forEach(function(el) { list.appendChild(el); });
        sortChange.classList.add('is-active'); sortChange.setAttribute('aria-pressed', 'true');
        sortDays.classList.remove('is-active'); sortDays.setAttribute('aria-pressed', 'false');
        applyFilter(false);
      }
      sortDays.addEventListener('click', sortByDays);
      sortChange.addEventListener('click', sortByChange);
      document.addEventListener('low-chip-quotes-updated', function() {
        if (sortChange.classList.contains('is-active')) sortByChange();
      });
      if (searchInput) searchInput.addEventListener('input', function() {
        query = normalize(searchInput.value);
        applyFilter(true);
      });
      starToggle.addEventListener('change', function() {
        localStorage.setItem(storageKey, starToggle.checked ? '1' : '0');
        applyFilter(true);
      });
      filterButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          var key = button.dataset.filter;
          if (activeFilters.has(key)) activeFilters.delete(key); else activeFilters.add(key);
          button.classList.toggle('is-active', activeFilters.has(key));
          button.setAttribute('aria-pressed', activeFilters.has(key) ? 'true' : 'false');
          applyFilter(true);
        });
      });
      if (filterReset) filterReset.addEventListener('click', function() {
        activeFilters.clear();
        filterButtons.forEach(function(button) {
          button.classList.remove('is-active');
          button.setAttribute('aria-pressed', 'false');
        });
        applyFilter(true);
      });
      viewActive.addEventListener('click', function() {
        currentView = 'active'; localStorage.setItem(viewStorageKey, currentView); applyFilter(true);
      });
      viewHistory.addEventListener('click', function() {
        currentView = 'history'; localStorage.setItem(viewStorageKey, currentView); applyFilter(true);
      });
      pagePrev.addEventListener('click', function() {
        if (currentPage <= 1) return;
        currentPage -= 1;
        renderPagination();
        list.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      pageNext.addEventListener('click', function() {
        var totalPages = Math.max(1, Math.ceil(filteredItems.length / PAGE_SIZE));
        if (currentPage >= totalPages) return;
        currentPage += 1;
        renderPagination();
        list.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      applyFilter(true);
    })();
  </script>
</body>

