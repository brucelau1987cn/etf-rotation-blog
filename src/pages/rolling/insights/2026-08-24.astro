---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import RollingDailyInsightReport from '../../../components/RollingDailyInsightReport.astro';
import RollingSubnav from '../../../components/RollingSubnav.astro';
import { SITE_TITLE } from '../../../consts';
import { rollingDailyReports } from '../../../data/rolling-daily-insights';

const report = rollingDailyReports['2026-08-24'];
const title = `${report.title} | ${SITE_TITLE}`;
const description = '2026年8月24日滚动信号收盘复盘：A股大幅回调，德福科技5档空方共振，创新医疗双杀，港股澜起科技大跌-8.09%触发10m空方，白银$68.93抗跌。';
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={title} description={description} /></head>
  <body>
    <Header />
    <main id="main-content" class="rolling-insights-main">
      <RollingSubnav active="insights" />
      <RollingDailyInsightReport report={report} />
    </main>
    <Footer />
  </body>
</html>
