---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import RollingDailyInsightReport from '../../../components/RollingDailyInsightReport.astro';
import RollingSubnav from '../../../components/RollingSubnav.astro';
import { SITE_TITLE } from '../../../consts';
import { rollingDailyReports } from '../../../data/rolling-daily-insights';
const report = rollingDailyReports['2026-09-09'];
const title = `${report.title} | ${SITE_TITLE}`;
---
<!doctype html><html lang="zh-CN"><head><BaseHead title={title} description="2026年9月9日滚动信号收盘复盘。" /></head><body><Header /><main id="main-content" class="rolling-insights-main"><RollingSubnav active="insights" /><RollingDailyInsightReport report={report} /></main><Footer /></body></html>
