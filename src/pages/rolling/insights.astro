---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import RollingDailyInsightReport from '../../components/RollingDailyInsightReport.astro';
import RollingSubnav from '../../components/RollingSubnav.astro';
import { SITE_TITLE } from '../../consts';
import { rollingDailyReports } from '../../data/rolling-daily-insights';

const report = rollingDailyReports['2026-10-08'];
const title = `${report.title} | ${SITE_TITLE}`;
const description = 'A股空方主导：长鑫科技10m/60m SELL@¥53.40/¥51.52收¥50.52(-7.79%)双窗下方确认、德福科技10m SELL@¥94.32收¥93.87(-1.45%)确认、国民技术90m SELL@¥19.51收¥19.14(-8.25%)下方但150m-210m三窗被收复；民爆光电10m SELL@¥102.99收¥103.97(+1.46%)站上信号价空方失效；东方明珠60m@¥8.47收¥8.48、华天科技180m/210m@¥16.03/16.00收¥16.03贴价未决；港股中国宏桥/澜起科技信号价与当日区间不符待核；白银现货10m SELL@$59.224收$58.51(-2.10%)确认延续';
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={title} description={description} /></head>
  <body>
    <Header />
    <main id="main-content" class="rolling-insights-main">
      <RollingSubnav active="insights" />
      <RollingDailyInsightReport report={report} />
    </main>
    <Footer />
  </body>
</html>
