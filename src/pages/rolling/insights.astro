---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import RollingSubnav from '../../components/RollingSubnav.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/rolling-insights.css';

const title = `滚动操盘解读｜创新医疗今日买卖计划 | ${SITE_TITLE}`;
const description = '创新医疗滚动信号操盘台：今日信号、当前动作、买入触发、卖出纪律、关键价位及技术指标共振。';

const todaySignals = [
  { time: '11:31', node: '120m', price: '¥19.56', state: '空方确认' },
  { time: '12:01', node: '150m', price: '¥19.56', state: '同价累计确认' },
];

const levels = [
  { price: '¥22.76', name: '历史过热兑现区', action: '反弹至此优先兑现', tone: 'sell' },
  { price: '¥21.12—21.40', name: '前空方密集压力', action: '反弹受阻继续减仓', tone: 'sell' },
  { price: '¥20.44', name: 'MA5确认线', action: '放量站稳才确认修复', tone: 'confirm' },
  { price: '¥19.95', name: '筹码平均成本', action: '收复后进入观察仓', tone: 'watch' },
  { price: '¥19.56', name: '今日空方信号价', action: '价格位于下方，空方有效', tone: 'signal' },
  { price: '¥19.36', name: '今日最低价', action: '再次跌破代表弱势延续', tone: 'risk' },
  { price: '¥18.20—18.60', name: 'MA20支撑区', action: '缩量止跌可小仓试错', tone: 'buy' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={title} description={description} /></head>
  <body>
    <Header />
    <main id="main-content" class="rolling-insights-main">
      <RollingSubnav active="insights" />

      <header class="trade-hero">
        <div class="trade-title-row">
          <div>
            <div class="eyebrow">滚动罗盘 · 专业操盘解读 · 07/30</div>
            <h1>创新医疗 <span>002173</span></h1>
            <p>最新价约 ¥19.44 · 今日 -5.08% · 数据截止 2026-07-30 盘中</p>
          </div>
          <div class="market-bias is-bearish">
            <small>今日策略状态</small>
            <strong>空方占优</strong>
            <span>120m / 150m 同价确认</span>
          </div>
        </div>
      </header>

      <section class="command-board" aria-label="今日操盘指令">
        <div class="command-primary">
          <div class="command-label">今日操作结论</div>
          <h2>空仓继续等待，持仓执行减仓</h2>
          <p>当前价低于空方信号价¥19.56、平均成本¥19.95和MA5 ¥20.44。短线修复尚未得到确认，现阶段不追买。</p>
        </div>
        <div class="command-action is-buy">
          <small>什么时候买</small>
          <strong>收复 ¥19.95 后观察</strong>
          <span>放量站稳¥20.44后确认买入</span>
        </div>
        <div class="command-action is-sell">
          <small>什么时候卖</small>
          <strong>¥19.56 下方维持减仓</strong>
          <span>跌破¥19.36继续降仓；反弹压力位分批兑现</span>
        </div>
      </section>

      <section class="today-panel">
        <div class="section-heading">
          <div><small>今日实时信号</small><h2>两个空方节点指向同一价格</h2></div>
          <span class="status-tag">信号有效</span>
        </div>
        <div class="today-signal-list">
          {todaySignals.map((item, index) => (
            <div class="today-signal">
              <time>{item.time}</time>
              <div><strong>{item.node} 空方</strong><span>{item.state}</span></div>
              <b>{item.price}</b>
              <em>{index === 0 ? '首次动作' : '累计确认'}</em>
            </div>
          ))}
        </div>
        <div class="signal-interpretation">
          <strong>操盘解读：</strong>两个节点均在¥19.56出现，属于同一空方信号簇。首次信号用于执行，后续节点用于加强置信度，不重复卖出同一仓位。当前价约¥19.44，空方信号尚未失效。
        </div>
      </section>

      <section class="execution-grid" id="plan">
        <div class="execution-card buy-card">
          <div class="card-number">01</div>
          <small>激进观察买点</small>
          <h3>¥18.20—18.60</h3>
          <p>接近MA20支撑区。只在缩量止跌、RSI6拐头、滚动空方节点停止增加时试仓。</p>
          <ul><li>建议仓位：10%—20%</li><li>止损：有效跌破¥18.18</li><li>性质：左侧试错</li></ul>
        </div>
        <div class="execution-card confirm-card">
          <div class="card-number">02</div>
          <small>稳健确认买点</small>
          <h3>先收复¥19.95，再站稳¥20.44</h3>
          <p>¥19.95是筹码平均成本，¥20.44是MA5。量比维持1.2以上且MACD止跌时，修复才成立。</p>
          <ul><li>首次收复¥19.95：观察仓</li><li>站稳¥20.44：增加仓位</li><li>性质：右侧确认</li></ul>
        </div>
        <div class="execution-card sell-card">
          <div class="card-number">03</div>
          <small>持仓卖出纪律</small>
          <h3>¥19.56下方减仓</h3>
          <p>当前价格位于今日空方信号下方。反抽无法收复¥19.56时，维持弱势判断。</p>
          <ul><li>跌破¥19.36：继续减仓</li><li>跌破¥18.18：退出修复仓</li><li>性质：趋势风控</li></ul>
        </div>
      </section>

      <section class="price-map" id="levels">
        <div class="section-heading"><div><small>价格作战地图</small><h2>从上到下看压力、信号与支撑</h2></div></div>
        <div class="level-table">
          {levels.map((item) => (
            <div class:list={['level-row', item.tone]}>
              <strong>{item.price}</strong><span>{item.name}</span><b>{item.action}</b>
            </div>
          ))}
        </div>
      </section>

      <div class="detail-layout">
        <article class="detail-column">
          <section id="evidence">
            <div class="section-heading"><div><small>今日证据链</small><h2>为什么现在不买</h2></div></div>
            <div class="evidence-grid">
              <div><small>最新价</small><strong>¥19.44</strong><span>低于空方信号¥19.56</span></div>
              <div><small>MA5</small><strong>¥20.44</strong><span>短线趋势压制</span></div>
              <div><small>MA20</small><strong>¥18.25</strong><span>中期支撑仍在下方</span></div>
              <div><small>平均成本</small><strong>¥19.95</strong><span>高位筹码处于浮亏</span></div>
              <div><small>RSI6</small><strong>50.89</strong><span>已经降温，尚未超卖</span></div>
              <div><small>量比</small><strong>2.12</strong><span>放量下跌，抛压明显</span></div>
              <div><small>换手率</small><strong>18.71%</strong><span>筹码继续交换</span></div>
              <div><small>获利盘</small><strong>40.9%</strong><span>上方套牢压力形成</span></div>
            </div>
            <p class="desk-note">价格低于成本与MA5，同时放量下跌。RSI位于中性区，缺少超卖反转条件。专业操盘的优先事项是等待价格确认，而非在下跌过程中提前猜底。</p>
          </section>

          <section id="scenarios">
            <div class="section-heading"><div><small>盘中应对</small><h2>三种走势，三套动作</h2></div></div>
            <div class="scenario-list">
              <div><b>A</b><strong>反弹收复¥19.95</strong><span>停止主动减仓，转入观察；继续站上¥20.44并放量，建立确认仓。</span></div>
              <div><b>B</b><strong>围绕¥19.36—19.95震荡</strong><span>保持轻仓或空仓，等待方向选择；不在区间中部频繁交易。</span></div>
              <div><b>C</b><strong>跌破¥19.36</strong><span>空方延续，持仓继续降仓；下一观察区下移至¥18.20—18.60。</span></div>
            </div>
          </section>

          <section id="history">
            <div class="section-heading"><div><small>历史教训</small><h2>¥22.76多方信号为什么不适合追买</h2></div></div>
            <div class="history-line"><span>07/28 多方信号簇</span><strong>¥22.76</strong><em>次日相对信号价 -10.02%</em></div>
            <p>当时RSI6达到81.75，价格高于MA20约26.1%、高于平均成本约25.2%，获利盘100%，量比仅0.64。趋势信号虽然持续点亮，资金确认不足且筹码过热。今后遇到相同组合，应将多方信号标记为“持仓兑现”，暂停新增追买。</p>
          </section>

          <section id="rules">
            <div class="section-heading"><div><small>系统优化</small><h2>滚动信号过滤规则</h2></div></div>
            <div class="rule-list">
              <div><strong>过热多方降级</strong><span>RSI6≥80、距MA20≥15%、距平均成本≥15%、获利盘≥90%</span></div>
              <div><strong>低位空方降级</strong><span>低于MA20≥15%、MACD绿柱收缩、RSI回升、量比≤1.1</span></div>
              <div><strong>同价节点合并</strong><span>同日同方向、价格差≤1%，首次用于执行，后续只累计确认</span></div>
            </div>
          </section>
        </article>

        <aside class="trade-sidebar" aria-label="今日执行清单">
          <div class="sidebar-status"><small>当前动作</small><strong>等待 / 减仓</strong><span>空方信号有效</span></div>
          <h3>盘中检查清单</h3>
          <label><input type="checkbox" disabled /> 收复¥19.95</label>
          <label><input type="checkbox" disabled /> 站稳MA5 ¥20.44</label>
          <label><input type="checkbox" disabled /> MACD动能转强</label>
          <label><input type="checkbox" disabled /> RSI6重新向上</label>
          <label><input type="checkbox" checked disabled /> 价格低于空方信号</label>
          <label><input type="checkbox" checked disabled /> 今日放量下跌</label>
          <div class="sidebar-bottom"><small>执行原则</small><p>信号先于预测，确认先于加仓，止损先于补仓。</p></div>
        </aside>
      </div>

      <section class="final-order" id="conclusion">
        <small>今日操盘结论</small>
        <h2>¥19.95以下不主动买；站稳¥20.44才确认买入；¥19.56以下持仓减仓；跌破¥18.18退出修复交易。</h2>
        <p>该计划用于滚动信号研究与交易纪律展示，价格与指标会随行情变化。</p>
      </section>
    </main>
    <Footer />
  </body>
</html>
