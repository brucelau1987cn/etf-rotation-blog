---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import RollingDailyInsightReport from '../../components/RollingDailyInsightReport.astro';
import RollingSubnav from '../../components/RollingSubnav.astro';
import { SITE_TITLE } from '../../consts';
import { rollingDailyReports } from '../../data/rolling-daily-insights';

const report = rollingDailyReports['2026-10-09'];
const title = `${report.title} | ${SITE_TITLE}`;
const description = 'A股空方全面失效：上海电力10m/15m@¥12.82/12.77收¥12.87、三安光电10m/15m@¥11.50/11.25收¥11.78、创新医疗10m@¥16.41收¥16.77、深科技15m@¥31.05收¥32.03、民爆光电15m@¥95.60收¥95.81、国民技术120m@¥18.36收¥18.99六窗全被收复；德福科技150m@85.70收复/210m@87.16未收复多窗分歧；港股澜起科技1h45m/2h BUY@261.20/266.60收HK$268.20多方确认、120m SELL@266.60被收复';
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={title} description={description} /></head>
  <body>
    <Header />
    <main id="main-content" class="rolling-insights-main">
      <RollingSubnav active="insights" />
      <RollingDailyInsightReport report={report} />
    </main>
    <Footer />
  </body>
</html>
