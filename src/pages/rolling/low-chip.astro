---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import RollingSubnav from '../../components/RollingSubnav.astro';
import { SITE_TITLE } from '../../consts';
import lowChipData from '../../../public/data/a-low-chip-stocks.json';

const title = `低筹码股｜周月季收盘获利筛选 | ${SITE_TITLE}`;
const description = 'A股收盘获利比例低于3%的周线、月线、季线筛选结果。';
const periodSections = [
  { key: 'week', label: '周线', rows: lowChipData.periods.week },
  { key: 'month', label: '月线', rows: lowChipData.periods.month },
  { key: 'quarter', label: '季线', rows: lowChipData.periods.quarter },
];
const allRows = periodSections.flatMap((period) => period.rows);
const intersectionRows = allRows.filter((row, index, rows) =>
  lowChipData.intersection.includes(row.symbol) && rows.findIndex((item) => item.symbol === row.symbol) === index
);
const valuesBySymbol = Object.fromEntries(
  lowChipData.intersection.map((symbol) => [
    symbol,
    Object.fromEntries(periodSections.map((period) => [period.key, period.rows.find((row) => row.symbol === symbol)?.value])),
  ])
);
const fmt = (value: number, digits = 2) => Number(value).toFixed(digits);
const fmtInt = (value: number) => Math.round(Number(value)).toLocaleString('zh-CN');
const fmtMetric = (value: number | null | undefined, digits = 1, suffix = '') => value == null ? '—' : `${Number(value).toFixed(digits)}${suffix}`;

const CHAR_INITIAL: Record<string, string> = {
  上:'s',海:'h',电:'d',力:'l',创:'c',新:'x',医:'y',疗:'l',
  三:'s',安:'a',光:'g',深:'s',科:'k',技:'j',德:'d',福:'f',
  民:'m',爆:'b',信:'x',息:'x',东:'d',方:'f',明:'m',珠:'z',
  长:'c',鑫:'x',国:'g',术:'s',澜:'l',起:'q',华:'h',天:'t',
  中:'z',宏:'h',桥:'q',特:'t',斯:'s',拉:'l',
  武:'w',汉:'h',天:'t',源:'y',千:'q',岸:'a',宝:'b',明:'m',
  易:'y',龙:'l',曙:'s',光:'g',数:'s',永:'y',光:'g',学:'x',
  技:'j',源:'y',集:'j',团:'t',金:'j',戈:'g',汇:'h',通:'t',
  康:'k',美:'m',特:'t',海:'h',新:'x',天:'t',灿:'c',勤:'q',
  欧:'o',林:'l',生:'s',物:'w',必:'b',贝:'b',恒:'h',运:'y',
  中:'z',关:'g',村:'c',禾:'h',元:'y',上:'s',海:'h',谊:'y',
  众:'z',三:'s',维:'w',股:'g',份:'f',吉:'j',和:'h',昌:'c',
  璞:'p',源:'y',材:'c',料:'l',乔:'q',路:'l',铭:'m',奥:'a',
  好:'h',莱:'l',客:'k',合:'h',兴:'x',华:'h',大:'d',九:'j',
  长:'c',进:'j',光:'g',子:'z',坤:'k',材:'c',
};
const nameInitials = (name: string) => {
  const raw = String(name || '').trim();
  if (!raw) return '';
  return Array.from(raw).map((ch) => /[A-Za-z0-9]/.test(ch) ? ch.toLowerCase() : CHAR_INITIAL[ch] || '').join('');
};

const PAGE_SIZE = 6;
const rows = intersectionRows.map((row) => ({
  ...row,
  week: fmt(valuesBySymbol[row.symbol].week, 1),
  month: fmt(valuesBySymbol[row.symbol].month, 1),
  quarter: fmt(valuesBySymbol[row.symbol].quarter, 1),
  nameInitials: nameInitials(row.name),
  industry: lowChipData.enrichments?.[row.symbol]?.industry || '待补充',
  sector: lowChipData.enrichments?.[row.symbol]?.sector || '待补充',
  qualityShareholder: Boolean(lowChipData.enrichments?.[row.symbol]?.quality_shareholder),
  qualityShareholderNames: lowChipData.enrichments?.[row.symbol]?.quality_shareholder_names || [],
  institutionalShareholder: Boolean(lowChipData.enrichments?.[row.symbol]?.institutional_shareholder),
  institutionalShareholderNames: lowChipData.enrichments?.[row.symbol]?.institutional_shareholder_names || [],
  financials: lowChipData.enrichments?.[row.symbol]?.financials || {},
  shareholderMetrics: lowChipData.enrichments?.[row.symbol]?.shareholder_metrics || {},
}));
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={title} description={description} /></head>
  <body>
    <Header />
    <main id="main-content" class="low-chip-main site-shell">
      <RollingSubnav active="low-chip" />

      <header class="low-chip-hero">
        <div>
          <p class="eyebrow">A股滚动 · 低筹码筛选</p>
          <h1>低筹码股</h1>
          <p>筛选条件：沪深A股、非ST、非退市，收盘获利比例低于3%；剔除北交所及未来3个月存在限售股解禁的标的。</p>
        </div>
        <dl>
          <div><dt>筛选日期</dt><dd>{lowChipData.data_as_of}</dd></div>
          <div><dt>过滤后标的</dt><dd>{rows.length}只</dd></div>
        </dl>
      </header>

      <section class="chip-section" aria-labelledby="chip-title">
        <div class="chip-toolbar">
          <div class="chip-toolbar-left">
            <p class="eyebrow">三个周期同时满足</p>
            <h2 id="chip-title">周线、月线、季线均低于3%</h2>
          </div>
          <div class="chip-toolbar-right">
            <div class="chip-pager" id="chip-pager" data-page-size={PAGE_SIZE}>
              <button type="button" class="chip-page-btn" id="chip-page-prev" aria-label="上一页">上一页</button>
              <div class="chip-page-nums" id="chip-page-nums" role="navigation" aria-label="页码"></div>
              <button type="button" class="chip-page-btn" id="chip-page-next" aria-label="下一页">下一页</button>
              <span class="chip-page-meta" id="chip-page-meta">第 1 页</span>
            </div>
            <label class="chip-search-wrap">
              <span class="chip-search-label">检索</span>
              <input id="chip-search-input" class="chip-search-input" type="search" inputmode="search" autocomplete="off" spellcheck="false" placeholder="代码 / 名称 / 首字母" />
            </label>
          </div>
        </div>

        <div class="chip-financial-filters" id="chip-financial-filters" aria-label="财务条件筛选">
          <button type="button" class="chip-filter-btn" data-filter="roe" aria-pressed="false">ROE ≥ 30%</button>
          <button type="button" class="chip-filter-btn" data-filter="net-margin" aria-pressed="false">净利率 ≥ 25%</button>
          <button type="button" class="chip-filter-btn" data-filter="cash-profit" aria-pressed="false">现金流/净利润 ≥ 20%</button>
          <button type="button" class="chip-filter-btn" data-filter="gross-margin" aria-pressed="false">毛利率 ≥ 15%</button>
          <button type="button" class="chip-filter-btn" data-filter="debt-ratio" aria-pressed="false">负债率 ≤ 10%</button>
          <button type="button" class="chip-filter-reset" id="chip-filter-reset">清除</button>
          <span class="chip-filter-meta" id="chip-filter-meta">未启用财务筛选</span>
        </div>

        <div class="chip-list" id="chip-list">
          {rows.map((row, index) => (
            <div
              class="chip-row"
              data-symbol={row.symbol}
              data-name={row.name}
              data-initials={row.nameInitials}
              data-industry={row.industry}
              data-roe={row.financials.roe ?? ''}
              data-net-margin={row.financials.net_margin ?? ''}
              data-cash-profit={row.financials.cash_profit_ratio ?? ''}
              data-gross-margin={row.financials.gross_margin ?? ''}
              data-debt-ratio={row.financials.debt_ratio ?? ''}
              data-board-index={index}
              hidden={index >= PAGE_SIZE}
            >
              <div class="chip-row-top">
                <div class="chip-row-main">
                  <div class="chip-identity"><strong class="chip-row-name">{row.name}</strong><span class="chip-row-code">{row.symbol}</span></div>
                  <span class="chip-industry" title={row.industry}>{row.sector}</span>
                  {row.qualityShareholder ? (
                    <span class="chip-quality" title={`优质股东：${row.qualityShareholderNames.join('、')}`}>优质股东 ✓</span>
                  ) : row.institutionalShareholder ? (
                    <span class="chip-institutional" title={`机构股东：${row.institutionalShareholderNames.join('、')}`}>机构股东 ●</span>
                  ) : null}
                </div>
                <div class="chip-row-metrics" aria-label="三周期收盘获利比例">
                  <span class="chip-metric"><em class="chip-val">{row.week}%</em><small>周线</small></span>
                  <span class="chip-metric"><em class="chip-val">{row.month}%</em><small>月线</small></span>
                  <span class="chip-metric"><em class="chip-val">{row.quarter}%</em><small>季线</small></span>
                </div>
                <div class="chip-row-footer">
                  <span class="chip-price">¥{fmt(row.price)}</span>
                  <span class:list={['chip-change', row.change_percent >= 0 ? 'chip-up' : 'chip-down']}>{row.change_percent >= 0 ? '+' : ''}{fmt(row.change_percent)}%</span>
                </div>
              </div>
              <div class="chip-row-shareholders" aria-label={`${row.name}股东与筹码指标`}>
                <div class="chip-shr-head" aria-hidden="true">
                  <span>股东人数</span><span>人均流通股</span><span>较上期变化</span><span>90%筹码集中度</span><span>十大流通股东</span>
                </div>
                <div class="chip-shr-body">
                  <span><strong>{fmtInt(row.shareholderMetrics.shareholder_count)}</strong></span>
                  <span><strong>{fmtInt(row.shareholderMetrics.average_holding)}</strong></span>
                  <span><strong class:list={[row.shareholderMetrics.shareholder_change_pct <= 0 ? 'is-concentrating' : 'is-dispersing']}>{fmtMetric(row.shareholderMetrics.shareholder_change_pct, 2, '%')}</strong></span>
                  <span><strong>{fmtMetric(row.shareholderMetrics.concentration90, 1, '%')}</strong></span>
                  <span><strong>{fmtMetric(row.shareholderMetrics.top10_float_ratio, 1, '%')}</strong></span>
                </div>
              </div>
            </div>
          ))}
          <div class="chip-row chip-row-empty" id="chip-search-empty" hidden>
            <strong>没有匹配标的</strong>
            <span>换个代码、名称或首字母试试</span>
          </div>
        </div>
      </section>

      <footer class="data-note">
        <strong>数据来源：iWenCai</strong>
        <span>筛选日期：2026-08-03 · 指标：收盘获利比例 · 阈值：低于3% · 范围：沪深A股</span>
        <p>已剔除北交所与未来3个月存在限售股解禁的标的。股东分级：优质股东为社保、养老、国家大基金、国新及主权资金等长期资本；机构股东覆盖公募、保险、阳光私募、QFII/外资、香港中央结算及产业资本。标记属于股东结构观察项。</p>
      </footer>
    </main>
    <Footer />

    <script is:inline>
    (function() {
      var list = document.getElementById('chip-list');
      var pager = document.getElementById('chip-pager');
      var nums = document.getElementById('chip-page-nums');
      var meta = document.getElementById('chip-page-meta');
      var prevBtn = document.getElementById('chip-page-prev');
      var nextBtn = document.getElementById('chip-page-next');
      var searchInput = document.getElementById('chip-search-input');
      var empty = document.getElementById('chip-search-empty');
      var filterButtons = Array.from(document.querySelectorAll('.chip-filter-btn'));
      var filterReset = document.getElementById('chip-filter-reset');
      var filterMeta = document.getElementById('chip-filter-meta');
      if (!list || !pager || !nums || !meta || !prevBtn || !nextBtn) return;

      var PAGE_SIZE = Math.max(1, Number(pager.dataset.pageSize || 6));
      var rows = Array.from(list.querySelectorAll('.chip-row:not(.chip-row-empty)'));
      if (!rows.length) return;

      var page = 1;
      var query = '';
      var activeFilters = new Set();

      function normalize(v) { return String(v || '').trim().toLowerCase().replace(/\s+/g, ''); }

      function filtered() {
        return rows.filter(function(c) {
          var sym = String(c.dataset.symbol || '').toLowerCase();
          var name = String(c.dataset.name || '').toLowerCase();
          var initials = String(c.dataset.initials || '').toLowerCase();
          var industry = String(c.dataset.industry || '').toLowerCase();
          var searchMatched = !query || sym.indexOf(query) !== -1 || name.indexOf(query) !== -1 || initials.indexOf(query) !== -1 || initials.indexOf(query) === 0 || industry.indexOf(query) !== -1;
          if (!searchMatched) return false;
          if (activeFilters.has('roe') && Number(c.dataset.roe) < 30) return false;
          if (activeFilters.has('net-margin') && Number(c.dataset.netMargin) < 25) return false;
          if (activeFilters.has('cash-profit') && (c.dataset.cashProfit === '' || Number(c.dataset.cashProfit) < 20)) return false;
          if (activeFilters.has('gross-margin') && Number(c.dataset.grossMargin) < 15) return false;
          if (activeFilters.has('debt-ratio') && Number(c.dataset.debtRatio) > 10) return false;
          return true;
        });
      }

      function render() {
        var matched = filtered();
        var totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
        if (page > totalPages) page = totalPages;
        if (page < 1) page = 1;
        var start = (page - 1) * PAGE_SIZE;
        var end = start + PAGE_SIZE;
        var visible = matched.slice(start, end);

        rows.forEach(function(c) { c.hidden = true; });
        visible.forEach(function(c) { c.hidden = false; });
        if (empty) empty.hidden = matched.length > 0;

        var showPager = matched.length > PAGE_SIZE;
        pager.hidden = !showPager;
        meta.textContent = matched.length ? '\u7B2C ' + page + '/' + totalPages + ' \u9875 \u00B7 ' + matched.length + ' \u53EA' : '\u65E0\u5339\u914D';
        if (filterMeta) filterMeta.textContent = activeFilters.size ? '\u5DF2\u542F\u7528 ' + activeFilters.size + ' \u9879 \u00B7 ' + matched.length + ' \u53EA' : '\u672A\u542F\u7528\u8D22\u52A1\u7B5B\u9009';

        nums.replaceChildren();
        if (showPager) {
          for (var i = 1; i <= totalPages; i++) {
            (function(p) {
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'chip-page-num' + (i === page ? ' is-active' : '');
              btn.textContent = String(i);
              btn.setAttribute('aria-label', '\u7B2C ' + i + ' \u9875');
              if (i === page) btn.setAttribute('aria-current', 'page');
              btn.addEventListener('click', function() { page = p; render(); });
              nums.appendChild(btn);
            })(i);
          }
        }
        prevBtn.disabled = page <= 1 || matched.length === 0;
        nextBtn.disabled = page >= totalPages || matched.length === 0;
      }

      prevBtn.addEventListener('click', function() { if (page > 1) { page--; render(); } });
      nextBtn.addEventListener('click', function() { page++; render(); });
      if (searchInput) {
        searchInput.addEventListener('input', function() { query = normalize(searchInput.value); page = 1; render(); });
      }
      filterButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var key = btn.dataset.filter;
          if (!key) return;
          if (activeFilters.has(key)) activeFilters.delete(key); else activeFilters.add(key);
          btn.classList.toggle('is-active', activeFilters.has(key));
          btn.setAttribute('aria-pressed', activeFilters.has(key) ? 'true' : 'false');
          page = 1;
          render();
        });
      });
      if (filterReset) filterReset.addEventListener('click', function() {
        activeFilters.clear();
        filterButtons.forEach(function(btn) { btn.classList.remove('is-active'); btn.setAttribute('aria-pressed', 'false'); });
        page = 1;
        render();
      });
      render();
    })();
    </script>
  </body>
</html>

<style is:global>
  .low-chip-main{padding-bottom:3rem;color:#14243b}
  .low-chip-hero,.chip-section,.data-note{border:1px solid #dbe3ec;border-radius:14px;background:#fff}
  .low-chip-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.25rem;padding:1.35rem}
  .eyebrow{margin:0 0 .35rem;color:#64748b;font-size:.75rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
  h1,h2,p{margin-top:0}.low-chip-hero h1{margin-bottom:.45rem;font-size:2rem}.low-chip-hero p:last-child{max-width:720px;margin-bottom:0;color:#526176;line-height:1.7}
  .low-chip-hero dl{display:grid;grid-template-columns:repeat(2,minmax(82px,1fr));gap:.5rem;margin:0}
  .low-chip-hero dl div{padding:.65rem .8rem;border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc}
  dt{color:#64748b;font-size:.72rem;font-weight:800}dd{margin:.2rem 0 0;font-size:1rem;font-weight:900}

  .chip-section{margin-top:1rem;overflow:hidden}
  .chip-toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.2rem;border-left:4px solid #d97706;border-bottom:1px solid #e2e8f0}
  .chip-toolbar h2{margin:0;font-size:1.15rem}
  .chip-toolbar-right{display:flex;align-items:center;justify-content:flex-end;gap:.75rem;flex-wrap:wrap}
  .chip-search-wrap{display:flex;align-items:center;gap:.5rem}
  .chip-search-label{color:#64748b;font-size:.82rem;font-weight:800}
  .chip-search-input{width:180px;height:2.1rem;padding:0 .9rem;border:1px solid #dbe3ec;border-radius:999px;font-size:.82rem;font-weight:650;outline:0;transition:border-color .15s}
  .chip-search-input:focus{border-color:#93c5fd;box-shadow:0 0 0 3px rgba(59,130,246,.12)}

  .chip-pager{display:inline-flex;align-items:center;gap:.35rem;flex-wrap:wrap}
  .chip-page-btn,.chip-page-num{min-width:2rem;height:1.95rem;padding:0 .7rem;border:1px solid #dbe3ec;border-radius:999px;background:#fff;color:#334155;font-size:.74rem;font-weight:750;cursor:pointer;transition:all .12s}
  .chip-page-btn:hover:not(:disabled),.chip-page-num:hover:not(.is-active){background:#f0f2f5;border-color:#b0bec5}
  .chip-page-btn:disabled{opacity:.4;cursor:default}
  .chip-page-nums{display:inline-flex;align-items:center;gap:.25rem}
  .chip-page-num{display:inline-flex;align-items:center;justify-content:center;padding:0 .35rem}
  .chip-page-num.is-active{color:#1d4ed8;border-color:#93c5fd;background:#eff6ff}
  .chip-page-meta{margin-left:.15rem;color:#64748b;font-size:.72rem;font-weight:700;white-space:nowrap}
  .chip-pager[hidden],.chip-row[hidden]{display:none!important}
  .chip-financial-filters{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;padding:.65rem 1.2rem;border-bottom:1px solid #e2e8f0;background:#fafbfc}
  .chip-filter-btn,.chip-filter-reset{height:1.95rem;padding:0 .7rem;border:1px solid #dbe3ec;border-radius:999px;background:#fff;color:#475569;font-size:.72rem;font-weight:750;cursor:pointer}
  .chip-filter-btn.is-active{border-color:#93c5fd;background:#eff6ff;color:#1d4ed8}
  .chip-filter-reset{color:#64748b}
  .chip-filter-meta{margin-left:auto;color:#64748b;font-size:.72rem;font-weight:700;white-space:nowrap}

  .chip-list{display:flex;flex-direction:column}
  .chip-row{display:flex;flex-direction:column;gap:.55rem;padding:.7rem 1.2rem;border-bottom:1px solid #edf1f5;transition:background .1s}
  .chip-row:hover{background:#f8fafc}
  .chip-row:last-child{border-bottom:0}
  .chip-row-top{display:grid;grid-template-columns:minmax(210px,1.25fr) minmax(150px,auto) auto;align-items:center;gap:.9rem;width:100%}
  .chip-row-main{display:flex;align-items:center;gap:.45rem;min-width:0;flex-wrap:wrap}
  .chip-identity{display:flex;align-items:baseline;gap:.4rem}
  .chip-row-name{font-size:.95rem;color:#14243b}
  .chip-row-code{color:#64748b;font-size:.78rem}
  .chip-industry,.chip-quality,.chip-institutional{padding:.18rem .45rem;border:1px solid #dbe3ec;border-radius:999px;background:#f8fafc;color:#475569;font-size:.66rem;font-weight:750;white-space:nowrap}
  .chip-quality{border-color:#bfdbfe;background:#eff6ff;color:#1d4ed8}
  .chip-institutional{border-color:#cbd5e1;background:#f8fafc;color:#475569}
  .chip-quality.is-none{border-color:#e2e8f0;background:#fff;color:#94a3b8}
  .chip-row-metrics{display:inline-flex;align-items:center;justify-content:flex-end;gap:0;border:1px solid #e7ecf2;border-radius:10px;background:#fafbfc;overflow:hidden}
  .chip-metric{display:flex;align-items:baseline;justify-content:center;gap:.32rem;min-width:64px;padding:.38rem .55rem;border-left:1px solid #edf1f5}
  .chip-metric:first-child{border-left:0}
  .chip-metric small{color:#8b98a9;font-size:.62rem;font-weight:700;letter-spacing:.02em}
  .chip-val{font-style:normal;font-size:.88rem;font-weight:850;color:#9a3412}
  .chip-row-footer{display:flex;align-items:center;gap:.75rem;margin-left:auto}
  .chip-price{color:#14243b;font-size:1.02rem;font-weight:850;font-variant-numeric:tabular-nums}
  .chip-change{font-size:.8rem;font-weight:800;min-width:56px;padding:.22rem .5rem;border-radius:999px;text-align:center;background:#f1f5f9}
  .chip-up{color:#b91c1c}
  .chip-down{color:#047857}
  .chip-up{background:#fdecec}.chip-down{background:#e7f5f0}
  .chip-row-shareholders{width:100%;padding-top:.5rem;border-top:1px dashed #e2e8f0}
  .chip-shr-head,.chip-shr-body{display:grid;grid-template-columns:1.25fr 1fr 1fr 1.15fr 1fr;gap:.45rem;width:100%}
  .chip-shr-head span{color:#8b98a9;font-size:.62rem;font-weight:750;letter-spacing:.03em;padding:0 .45rem;white-space:nowrap}
  .chip-shr-body span{display:flex;align-items:center;min-width:0;padding:.3rem .45rem 0;border-top:0}
  .chip-shr-body strong{color:#14243b;font-size:.82rem;font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}
  .chip-shr-body .is-concentrating{color:#b91c1c}
