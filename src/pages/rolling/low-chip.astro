---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import LowChipModeNav from '../../components/LowChipModeNav.astro';
import RollingSubnav from '../../components/RollingSubnav.astro';
import { SITE_TITLE } from '../../consts';
import lowChipData from '../../../public/data/a-low-chip-stocks.json';
import lowChipHistoryIndex from '../../../public/data/low-chip-history-index.json';
const historyDates = lowChipHistoryIndex.dates || [];
const historyItems = lowChipHistoryIndex.items || [];
const clientHistoryIndex = {
  dates: historyDates,
  items: historyItems.map((item) => ({ date: item.date, intersection_count: item.intersection_count })),
};

const title = `低筹码股 | ${SITE_TITLE}`;
const description = 'A股低筹码内部模型观察列表。';
const periodSections = [
  { key: 'week', label: '周线', rows: lowChipData.periods.week },
  { key: 'month', label: '月线', rows: lowChipData.periods.month },
  { key: 'quarter', label: '季线', rows: lowChipData.periods.quarter },
];
const allRows = periodSections.flatMap((period) => period.rows);
const intersectionRows = allRows.filter((row, index, rows) =>
  lowChipData.intersection.includes(row.symbol) && rows.findIndex((item) => item.symbol === row.symbol) === index
);

const fmt = (value: number, digits = 2) => Number(value).toFixed(digits);
const fmtInt = (value: number) => Math.round(Number(value)).toLocaleString('zh-CN');
const fmtMetric = (value: number | null, digits = 2, suffix = '') => value == null ? '—' : Number(value).toFixed(digits) + suffix;
const shrinkControlLabel = (label: string | null) => {
  if (!label) return '';
  const map: Record<string, string> = { '轻度控盘': '轻度', '中度控盘': '中度', '高度控盘': '完全', '不控盘': '不控', '无控盘': '不控' };
  return map[label] || label;
};
const chipFocusClass = (focus: string | null) => {
  if (!focus) return '';
  if (focus === '非常集中' || focus === '较集中') return 'is-concentrating';
  if (focus === '分散') return 'is-dispersing';
  return '';
};
const reportPeriodLabel = (rp: string | null) => rp || '—';

const CHAR_INITIAL: Record<string, string> = {
  上:'s',海:'h',电:'d',力:'l',创:'c',新:'x',医:'y',疗:'l',
  三:'s',安:'a',光:'g',深:'s',科:'k',技:'j',德:'d',福:'f',
  民:'m',爆:'b',信:'x',息:'x',东:'d',方:'f',明:'m',珠:'z',
  长:'c',鑫:'x',国:'g',术:'s',澜:'l',起:'q',华:'h',天:'t',
  中:'z',宏:'h',桥:'q',特:'t',斯:'s',拉:'l',
  武:'w',汉:'h',天:'t',源:'y',千:'q',岸:'a',宝:'b',明:'m',
  易:'y',龙:'l',曙:'s',光:'g',数:'s',永:'y',光:'g',学:'x',
  技:'j',源:'y',集:'j',团:'t',金:'j',戈:'g',汇:'h',通:'t',
  康:'k',美:'m',特:'t',海:'h',新:'x',天:'t',灿:'c',勤:'q',
  欧:'o',林:'l',生:'s',物:'w',必:'b',贝:'b',恒:'h',运:'y',
  中:'z',关:'g',村:'c',禾:'h',元:'y',上:'s',海:'h',谊:'y',
  众:'z',三:'s',维:'w',股:'g',份:'f',吉:'j',和:'h',昌:'c',
  璞:'p',源:'y',材:'c',料:'l',乔:'q',路:'l',铭:'m',奥:'a',
  好:'h',莱:'l',客:'k',合:'h',兴:'x',华:'h',大:'d',九:'j',
  长:'c',进:'j',光:'g',子:'z',坤:'k',材:'c',
};
const nameInitials = (name: string) => {
  const raw = String(name || '').trim();
  if (!raw) return '';
  return Array.from(raw).map((ch) => /[A-Za-z0-9]/.test(ch) ? ch.toLowerCase() : CHAR_INITIAL[ch] || '').join('');
};

const PAGE_SIZE = 6;
const asOfLabel = String(lowChipData.data_as_of || '').replace(/^(\d{4})-(\d{2})-(\d{2})$/, '$1/$2/$3');
const rows = intersectionRows.map((row) => {
  const enr = lowChipData.enrichments?.[row.symbol] || {};
  const sector = enr.sector || '待补充';
  const themes = Array.isArray(enr.theme_concepts)
    ? enr.theme_concepts.filter(Boolean).slice(0, 3)
    : (enr.theme_concept ? String(enr.theme_concept).split(/[、,，]/).map((s) => s.trim()).filter(Boolean).slice(0, 3) : []);
  const themeText = themes.join('、');
  return {
    symbol: row.symbol,
    name: row.name,
    price: row.price,
    change_percent: row.change_percent,
    nameInitials: nameInitials(row.name),
    industry: enr.industry || '待补充',
    sector,
    sectorWithTheme: enr.sector_with_theme || (themeText ? `${sector}（${themeText}）` : sector),
    themeConcept: themeText,
    themeConcepts: themes,
    qualityShareholder: Boolean(enr.quality_shareholder),
    qualityShareholderNames: enr.quality_shareholder_names || [],
    institutionalShareholder: Boolean(enr.institutional_shareholder),
    institutionalShareholderNames: enr.institutional_shareholder_names || [],
    financials: enr.financials || {},
    shareholderMetrics: enr.shareholder_metrics || {},
  };
});
const initialClientData = { data_as_of: lowChipData.data_as_of, rows };
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={title} description={description} /></head>
  <body>
    <Header />
    <main id="main-content" class="low-chip-main site-shell">
      <RollingSubnav active="low-chip" />
      <LowChipModeNav active="screen" />

      <header class="low-chip-hero">
        <div>
          <p class="eyebrow">A股滚动 · 模型观察</p>
          <h1>低筹码股</h1>
          <p>基于内部模型生成的授权观察列表，具体规则与参数保持私密。</p>
        </div>
        <dl>
          <div><dt>筛选日期</dt><dd id="chip-as-of">{lowChipData.data_as_of}</dd></div>
          <div><dt>过滤后标的</dt><dd id="chip-count">{rows.length}只</dd></div>
          <div><dt>历史存档</dt><dd>{historyDates.length}天</dd></div>
        </dl>
      </header>

      <section class="chip-section" aria-labelledby="chip-title">
        <div class="chip-toolbar">
          <div class="chip-toolbar-left">
            <p class="eyebrow">授权用户专属</p>
            <h2 id="chip-title">内部模型观察列表</h2>
            <div class="chip-history" id="chip-history" aria-label="历史日期查询">
              <span class="chip-history-label">历史日期</span>
              <button type="button" class="chip-history-btn" id="chip-history-prev" aria-label="更早日期">‹</button>
              <div class="chip-calendar-wrap">
                <button type="button" class="chip-history-calendar-btn" id="chip-history-calendar-btn" aria-label="选择历史筛选日期" aria-haspopup="dialog" aria-expanded="false">
                  <span id="chip-history-calendar-value">{lowChipData.data_as_of}</span><i aria-hidden="true">▾</i>
                </button>
                <div class="chip-history-calendar" id="chip-history-calendar" role="dialog" aria-label="历史快照月历" hidden>
                  <div class="chip-calendar-head">
                    <button type="button" id="chip-calendar-month-prev" aria-label="上个月">‹</button>
                    <strong id="chip-calendar-month-title"></strong>
                    <button type="button" id="chip-calendar-month-next" aria-label="下个月">›</button>
                  </div>
                  <div class="chip-calendar-weekdays" aria-hidden="true"><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span></div>
                  <div class="chip-calendar-grid" id="chip-calendar-grid"></div>
                  <div class="chip-calendar-legend"><i></i> 有标的日期；数字为当日标的数</div>
                </div>
                <div class="chip-calendar-data" hidden>
                  {historyItems.map((item) => (
                    <span data-calendar-date={item.date} data-calendar-count={item.intersection_count} class="chip-calendar-count">{item.intersection_count}</span>
                  ))}
                </div>
              </div>
              <button type="button" class="chip-history-btn" id="chip-history-next" aria-label="更新日期">›</button>
              <span class="chip-history-status" id="chip-history-status">最新快照</span>
            </div>
          </div>
          <div class="chip-toolbar-right">
            <div class="chip-pager" id="chip-pager" data-page-size={PAGE_SIZE}>
              <button type="button" class="chip-page-btn" id="chip-page-prev" aria-label="上一页">上一页</button>
              <div class="chip-page-nums" id="chip-page-nums" role="navigation" aria-label="页码"></div>
              <button type="button" class="chip-page-btn" id="chip-page-next" aria-label="下一页">下一页</button>
              <span class="chip-page-meta" id="chip-page-meta">第 1 页</span>
            </div>
            <label class="chip-search-wrap">
              <span class="chip-search-label">检索</span>
              <input id="chip-search-input" class="chip-search-input" type="search" inputmode="search" autocomplete="off" spellcheck="false" placeholder="代码 / 名称 / 首字母" />
            </label>
          </div>
        </div>

        <div class="chip-financial-filters" id="chip-financial-filters" aria-label="财务条件筛选">
          <button type="button" class="chip-filter-btn" data-filter="roe" aria-pressed="false">ROE ≥ 30%</button>
          <button type="button" class="chip-filter-btn" data-filter="net-margin" aria-pressed="false">净利率 ≥ 25%</button>
          <button type="button" class="chip-filter-btn" data-filter="cash-profit" aria-pressed="false">现金流/净利润 ≥ 20%</button>
          <button type="button" class="chip-filter-btn" data-filter="gross-margin" aria-pressed="false">毛利率 ≥ 15%</button>
          <button type="button" class="chip-filter-btn" data-filter="debt-ratio" aria-pressed="false">负债率 ≤ 10%</button>
          <button type="button" class="chip-filter-reset" id="chip-filter-reset">清除</button>
          <span class="chip-filter-meta" id="chip-filter-meta">未启用财务筛选</span>
        </div>

        <div class="chip-list" id="chip-list">
          {rows.map((row, index) => (
            <div
              class="chip-row"
              data-symbol={row.symbol}
              data-name={row.name}
              data-initials={row.nameInitials}
              data-industry={row.industry}
              data-roe={row.financials.roe ?? ''}
              data-net-margin={row.financials.net_margin ?? ''}
              data-cash-profit={row.financials.cash_profit_ratio ?? ''}
              data-gross-margin={row.financials.gross_margin ?? ''}
              data-debt-ratio={row.financials.debt_ratio ?? ''}
              data-board-index={index}
              hidden={index >= PAGE_SIZE}
            >
              <div class="chip-row-top">
                <div class="chip-row-main">
                  <div class="chip-identity"><strong class="chip-row-name">{row.name}</strong><span class="chip-row-code">{row.symbol}</span></div>
                  <span class="chip-industry" title={row.themeConcepts.length ? `${row.industry} · 近期贴合：${row.themeConcepts.join('、')}` : row.industry}>
                    {row.sector}{row.themeConcepts.length ? <em class="chip-theme">（{row.themeConcepts.join('、')}）</em> : null}
                  </span>
                  {row.qualityShareholder ? (
                    <span class="chip-quality" title={`优质股东：${row.qualityShareholderNames.join('、')}`}>优质股东 ✓</span>
                  ) : row.institutionalShareholder ? (
                    <span class="chip-institutional" title={`机构股东：${row.institutionalShareholderNames.join('、')}`}>机构股东 ●</span>
                  ) : null}
                </div>
                <div class="chip-row-metrics" aria-label="观察日期">
                  <span class="chip-metric chip-metric-asof" title="查询日期股价"><em class="chip-val chip-asof-val">{asOfLabel || lowChipData.data_as_of}</em><small>日期</small></span>
                </div>
                <div class="chip-row-footer">
                  <span class="chip-price">¥{fmt(row.price)}</span>
                  <span class:list={['chip-change', row.change_percent >= 0 ? 'chip-up' : 'chip-down']}>{row.change_percent >= 0 ? '+' : ''}{fmt(row.change_percent)}%</span>
                </div>
              </div>
              <div class="chip-row-shareholders" aria-label={`${row.name}股东与筹码指标`}>
                <button type="button" class="chip-shr-toggle" aria-expanded="false">
                  <span>股东与筹码指标</span><i class="chip-shr-chev" aria-hidden="true">▾</i>
                </button>
                <div class="chip-shr-head" aria-hidden="true">
                  <span>股东人数</span><span>股东变化</span><span>筹码集中度</span><span>主力控盘</span><span>十大流通股东</span><span>报告期</span>
                </div>
                <div class="chip-shr-body">
                  <span><strong>{fmtInt(row.shareholderMetrics.shareholder_count)}</strong></span>
                  <span><strong class:list={[row.shareholderMetrics.shareholder_change_pct <= 0 ? 'is-concentrating' : 'is-dispersing']}>{fmtMetric(row.shareholderMetrics.shareholder_change_pct, 2, '%')}</strong></span>
                  <span><strong class:list={[chipFocusClass(row.shareholderMetrics.chip_focus)]}>{row.shareholderMetrics.chip_focus || '—'}</strong></span>
                  <span><strong>{row.shareholderMetrics.main_force || '—'}{row.shareholderMetrics.main_force && row.shareholderMetrics.main_force_label ? '（' + shrinkControlLabel(row.shareholderMetrics.main_force_label) + '）' : ''}</strong></span>
                  <span><strong>{row.shareholderMetrics.top10_float_ratio ? fmtMetric(row.shareholderMetrics.top10_float_ratio, 1, '%') : '—'}</strong></span>
                  <span><strong>{reportPeriodLabel(row.shareholderMetrics.report_period)}</strong></span>
                </div>
              </div>
            </div>
          ))}
          {rows.length === 0 && (
            <div class="chip-row chip-row-empty">
              <strong>今日无符合标的</strong>
              <span>内部模型当前未生成观察标的。</span>
            </div>
          )}
          <div class="chip-row chip-row-empty" id="chip-search-empty" hidden>
            <strong>没有匹配标的</strong>
            <span>换个代码、名称或首字母试试</span>
          </div>
        </div>
      </section>

      <footer class="data-note">
        <strong>数据来源：同花顺</strong>
        <span id="chip-data-note">观察日期：{lowChipData.data_as_of} · 范围：沪深A股</span>
        <p>模型规则与参数属于内部研究信息，仅展示观察结果与公开市场数据。</p>
      </footer>
    </main>
    <Footer />

    <script is:inline define:vars={{ initialData: initialClientData, historyIndex: clientHistoryIndex, pageSize: PAGE_SIZE }}>
    (function() {
      var list = document.getElementById('chip-list');
      var pager = document.getElementById('chip-pager');
      var nums = document.getElementById('chip-page-nums');
      var meta = document.getElementById('chip-page-meta');
      var prevBtn = document.getElementById('chip-page-prev');
      var nextBtn = document.getElementById('chip-page-next');
      var searchInput = document.getElementById('chip-search-input');
      var empty = document.getElementById('chip-search-empty');
      var filterButtons = Array.from(document.querySelectorAll('.chip-filter-btn'));
      var filterReset = document.getElementById('chip-filter-reset');
      var filterMeta = document.getElementById('chip-filter-meta');

      var calendarBtn = document.getElementById('chip-history-calendar-btn');
      var calendarValue = document.getElementById('chip-history-calendar-value');
      var calendarPanel = document.getElementById('chip-history-calendar');
      var calendarGrid = document.getElementById('chip-calendar-grid');
      var calendarTitle = document.getElementById('chip-calendar-month-title');
      var calendarMonthPrev = document.getElementById('chip-calendar-month-prev');
      var calendarMonthNext = document.getElementById('chip-calendar-month-next');
      var historyPrev = document.getElementById('chip-history-prev');
      var historyNext = document.getElementById('chip-history-next');
      var historyStatus = document.getElementById('chip-history-status');
      var asOfEl = document.getElementById('chip-as-of');
      var countEl = document.getElementById('chip-count');
      var dataNote = document.getElementById('chip-data-note');
      if (!list || !pager || !nums || !meta || !prevBtn || !nextBtn) return;

      var PAGE_SIZE = Math.max(1, Number(pageSize || pager.dataset.pageSize || 6));
      var page = 1;
      var query = '';
      var activeFilters = new Set();

      var currentDate = String((initialData && initialData.data_as_of) || '');
      var dates = (historyIndex && historyIndex.dates) || [];
      var historyItemsByDate = Object.fromEntries(((historyIndex && historyIndex.items) || []).map(function(item) { return [item.date, item]; }));
      var calendarMonth = (currentDate || dates[0] || new Date().toISOString().slice(0, 10)).slice(0, 7);
      var cache = {};
      if (initialData && initialData.data_as_of) cache[initialData.data_as_of] = initialData;
      var loading = false;

      var CHAR_INITIAL = {
        上:'s',海:'h',电:'d',力:'l',创:'c',新:'x',医:'y',疗:'l',
        三:'s',安:'a',光:'g',深:'s',科:'k',技:'j',德:'d',福:'f',
        民:'m',爆:'b',信:'x',息:'x',东:'d',方:'f',明:'m',珠:'z',
        长:'c',鑫:'x',国:'g',术:'s',澜:'l',起:'q',华:'h',天:'t',
        中:'z',宏:'h',桥:'q',特:'t',斯:'s',拉:'l',汇:'h',通:'t',
        能:'n',源:'y',集:'j',团:'t',金:'j',股:'g',份:'f'
      };

      function normalize(v) { return String(v || '').trim().toLowerCase().replace(/\s+/g, ''); }
      function nameInitials(name) {
        return Array.from(String(name || '').trim()).map(function(ch) {
          return /[A-Za-z0-9]/.test(ch) ? ch.toLowerCase() : (CHAR_INITIAL[ch] || '');
        }).join('');
      }
      function fmt(value, digits) {
        digits = digits == null ? 2 : digits;
        var n = Number(value);
        return Number.isFinite(n) ? n.toFixed(digits) : '—';
      }
      function fmtInt(value) {
        var n = Math.round(Number(value));
        return Number.isFinite(n) ? n.toLocaleString('zh-CN') : '—';
      }
      function fmtMetric(value, digits, suffix) {
        if (value == null || value === '') return '—';
        var n = Number(value);
        if (!Number.isFinite(n)) return '—';
        return n.toFixed(digits == null ? 1 : digits) + (suffix || '');
      }
      function esc(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }
      function chipFocusClass(focus) {
        if (!focus) return '';
        if (focus === '非常集中' || focus === '较集中') return 'is-concentrating';
        if (focus === '分散') return 'is-dispersing';
        return '';
      }

      function buildRows(data) {
        return (Array.isArray(data.rows) ? data.rows : []).map(function(row) {
          return Object.assign({}, row, {
            nameInitials: row.nameInitials || nameInitials(row.name || row.symbol)
          });
        });
      }

      function rowHtml(row, index, asOf) {
        var change = Number(row.change_percent);
        var changeCls = change >= 0 ? 'chip-up' : 'chip-down';
        var changeText = (change >= 0 ? '+' : '') + fmt(change) + '%';
        var badge = '';
        if (row.qualityShareholder) {
          badge = '<span class="chip-quality" title="优质股东：' + esc((row.qualityShareholderNames || []).join('、')) + '">优质股东 ✓</span>';
        } else if (row.institutionalShareholder) {
          badge = '<span class="chip-institutional" title="机构股东：' + esc((row.institutionalShareholderNames || []).join('、')) + '">机构股东 ●</span>';
        }
        var themes = Array.isArray(row.themeConcepts)
          ? row.themeConcepts.filter(Boolean).slice(0, 3)
          : (row.themeConcept ? String(row.themeConcept).split(/[、,，]/).map(function(s){return s.trim();}).filter(Boolean).slice(0, 3) : []);
        var themeText = themes.join('、');
        var themeTitle = themeText
          ? esc(row.industry) + ' · 近期贴合：' + esc(themeText)
          : esc(row.industry);
        var themeHtml = themeText ? '<em class="chip-theme">（' + esc(themeText) + '）</em>' : '';
        var asOfLabel = String(asOf || '').replace(/^(\d{4})-(\d{2})-(\d{2})$/, '$1/$2/$3') || String(asOf || '');
        var sm = row.shareholderMetrics || {};
        var changePct = sm.shareholder_change_pct;
        var changeClass = Number(changePct) <= 0 ? 'is-concentrating' : 'is-dispersing';
        var shrinkLabel = function(label) {
          var map = { '轻度控盘': '轻度', '中度控盘': '中度', '高度控盘': '完全', '不控盘': '不控', '无控盘': '不控' };
          return map[label] || label || '';
        };
        return (
          '<div class="chip-row" data-symbol="' + esc(row.symbol) + '" data-name="' + esc(row.name) + '" data-initials="' + esc(row.nameInitials) + '" data-industry="' + esc(row.industry) + '" data-theme="' + esc(themeText) + '" data-roe="' + esc(row.financials.roe ?? '') + '" data-net-margin="' + esc(row.financials.net_margin ?? '') + '" data-cash-profit="' + esc(row.financials.cash_profit_ratio ?? '') + '" data-gross-margin="' + esc(row.financials.gross_margin ?? '') + '" data-debt-ratio="' + esc(row.financials.debt_ratio ?? '') + '" data-board-index="' + index + '"' + (index >= PAGE_SIZE ? ' hidden' : '') + '>' +
            '<div class="chip-row-top">' +
              '<div class="chip-row-main">' +
                '<div class="chip-identity"><strong class="chip-row-name">' + esc(row.name) + '</strong><span class="chip-row-code">' + esc(row.symbol) + '</span></div>' +
                '<span class="chip-industry" title="' + themeTitle + '">' + esc(row.sector) + themeHtml + '</span>' +
                badge +
              '</div>' +
              '<div class="chip-row-metrics" aria-label="观察日期">' +
                '<span class="chip-metric chip-metric-asof" title="查询日期股价"><em class="chip-val chip-asof-val">' + esc(asOfLabel) + '</em><small>日期</small></span>' +
              '</div>' +
              '<div class="chip-row-footer">' +
                '<span class="chip-price">¥' + fmt(row.price) + '</span>' +
                '<span class="chip-change ' + changeCls + '">' + changeText + '</span>' +
              '</div>' +
            '</div>' +
            '<div class="chip-row-shareholders" aria-label="' + esc(row.name) + '股东与筹码指标">' +
              '<button type="button" class="chip-shr-toggle" aria-expanded="false"><span>股东与筹码指标</span><i class="chip-shr-chev" aria-hidden="true">▾</i></button>' +
              '<div class="chip-shr-head" aria-hidden="true"><span>股东人数</span><span>股东变化</span><span>筹码集中度</span><span>主力控盘</span><span>十大流通股东</span><span>报告期</span></div>' +
              '<div class="chip-shr-body">' +
                '<span><strong>' + fmtInt(sm.shareholder_count) + '</strong></span>' +
                '<span><strong class="' + changeClass + '">' + fmtMetric(changePct, 2, '%') + '</strong></span>' +
                '<span><strong class="' + chipFocusClass(sm.chip_focus) + '">' + esc(sm.chip_focus || '—') + '</strong></span>' +
                '<span><strong>' + esc(sm.main_force || '—') + (sm.main_force && sm.main_force_label ? '（' + esc(shrinkLabel(sm.main_force_label)) + '）' : '') + '</strong></span>' +
                '<span><strong>' + fmtMetric(sm.top10_float_ratio, 1, '%') + '</strong></span>' +
                '<span><strong>' + esc(sm.report_period || '—') + '</strong></span>' +
              '</div>' +
            '</div>' +
          '</div>'
        );
      }

      function bindShareholderToggles() {
        Array.from(list.querySelectorAll('.chip-shr-toggle')).forEach(function(btn) {
          btn.addEventListener('click', function() {
            var row = btn.closest('.chip-row');
            if (!row) return;
            var open = row.classList.toggle('is-shr-open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        });
      }

      function rowsEls() {
        return Array.from(list.querySelectorAll('.chip-row:not(.chip-row-empty)'));
      }

      function filtered() {
        return rowsEls().filter(function(c) {
          var sym = String(c.dataset.symbol || '').toLowerCase();
          var name = String(c.dataset.name || '').toLowerCase();
          var initials = String(c.dataset.initials || '').toLowerCase();
          var industry = String(c.dataset.industry || '').toLowerCase();
          var searchMatched = !query || sym.indexOf(query) !== -1 || name.indexOf(query) !== -1 || initials.indexOf(query) !== -1 || initials.indexOf(query) === 0 || industry.indexOf(query) !== -1;
          if (!searchMatched) return false;
          if (activeFilters.has('roe') && (c.dataset.roe === '' || !Number.isFinite(Number(c.dataset.roe)) || Number(c.dataset.roe) < 30)) return false;
          if (activeFilters.has('net-margin') && (c.dataset.netMargin === '' || !Number.isFinite(Number(c.dataset.netMargin)) || Number(c.dataset.netMargin) < 25)) return false;
          if (activeFilters.has('cash-profit') && (c.dataset.cashProfit === '' || !Number.isFinite(Number(c.dataset.cashProfit)) || Number(c.dataset.cashProfit) < 20)) return false;
          if (activeFilters.has('gross-margin') && (c.dataset.grossMargin === '' || !Number.isFinite(Number(c.dataset.grossMargin)) || Number(c.dataset.grossMargin) < 15)) return false;
          if (activeFilters.has('debt-ratio') && (c.dataset.debtRatio === '' || !Number.isFinite(Number(c.dataset.debtRatio)) || Number(c.dataset.debtRatio) > 10)) return false;
          return true;
        });
      }

      function renderPager() {
        var matched = filtered();
        var totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
        if (page > totalPages) page = totalPages;
        if (page < 1) page = 1;
        var start = (page - 1) * PAGE_SIZE;
        var end = start + PAGE_SIZE;
        var visible = matched.slice(start, end);
        rowsEls().forEach(function(c) { c.hidden = true; });
        visible.forEach(function(c) { c.hidden = false; });
        if (empty) empty.hidden = matched.length > 0;
        var showPager = matched.length > PAGE_SIZE;
        pager.hidden = !showPager;
        meta.textContent = matched.length ? ('第 ' + page + '/' + totalPages + ' 页 · ' + matched.length + ' 只') : '无匹配';
        if (filterMeta) filterMeta.textContent = activeFilters.size ? ('已启用 ' + activeFilters.size + ' 项 · ' + matched.length + ' 只') : '未启用财务筛选';

        nums.replaceChildren();
        if (showPager) {
          for (var i = 1; i <= totalPages; i++) {
            (function(p) {
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'chip-page-num' + (i === page ? ' is-active' : '');
              btn.textContent = String(i);
              btn.setAttribute('aria-label', '第 ' + i + ' 页');
              if (i === page) btn.setAttribute('aria-current', 'page');
              btn.addEventListener('click', function() { page = p; renderPager(); });
              nums.appendChild(btn);
            })(i);
          }
        }
        prevBtn.disabled = page <= 1 || matched.length === 0;
        nextBtn.disabled = page >= totalPages || matched.length === 0;
      }

      function setStatus(text, isError) {
        if (!historyStatus) return;
        historyStatus.textContent = text;
        historyStatus.classList.toggle('is-error', !!isError);
      }

      function monthShift(month, delta) {
        var parts = month.split('-').map(Number);
        var d = new Date(parts[0], parts[1] - 1 + delta, 1);
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
      }

      function renderCalendar() {
        if (!calendarGrid || !calendarTitle) return;
        var parts = calendarMonth.split('-').map(Number);
        var year = parts[0];
        var month = parts[1];
        var first = new Date(year, month - 1, 1);
        var daysInMonth = new Date(year, month, 0).getDate();
        var leading = (first.getDay() + 6) % 7;
        calendarTitle.textContent = year + '年' + month + '月';
        calendarGrid.replaceChildren();
        for (var blank = 0; blank < leading; blank++) {
          var spacer = document.createElement('span');
          spacer.className = 'chip-calendar-day is-empty';
          calendarGrid.appendChild(spacer);
        }
        for (var day = 1; day <= daysInMonth; day++) {
          var date = calendarMonth + '-' + String(day).padStart(2, '0');
          var item = historyItemsByDate[date];
          var cell = document.createElement(item ? 'button' : 'span');
          cell.className = 'chip-calendar-day' + (item ? ' has-snapshot' + (item.intersection_count > 0 ? ' has-results' : ' is-zero') : '') + (date === currentDate ? ' is-selected' : '');
          if (item) {
            cell.type = 'button';
            cell.dataset.date = date;
            cell.setAttribute('aria-label', date + '，' + item.intersection_count + '只');
            cell.innerHTML = '<b>' + day + '</b><small>' + item.intersection_count + '只</small>';
            cell.addEventListener('click', function() {
              closeCalendar();
              loadDate(this.dataset.date);
            });
          } else {
            cell.innerHTML = '<b>' + day + '</b>';
          }
          calendarGrid.appendChild(cell);
        }
        var availableMonths = dates.map(function(d) { return d.slice(0, 7); });
        if (calendarMonthPrev) calendarMonthPrev.disabled = !availableMonths.some(function(m) { return m < calendarMonth; });
        if (calendarMonthNext) calendarMonthNext.disabled = !availableMonths.some(function(m) { return m > calendarMonth; });
      }

      function closeCalendar() {
        if (!calendarPanel || !calendarBtn) return;
        calendarPanel.hidden = true;
        calendarBtn.setAttribute('aria-expanded', 'false');
      }

      function toggleCalendar() {
        if (!calendarPanel || !calendarBtn) return;
        var willOpen = calendarPanel.hidden;
        calendarPanel.hidden = !willOpen;
        calendarBtn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        if (willOpen) {
          calendarMonth = currentDate.slice(0, 7);
          renderCalendar();
        }
      }

      function updateMeta(data) {
        var day = data.data_as_of || currentDate;
        var count = (data.rows || []).length;
        if (asOfEl) asOfEl.textContent = day;
        if (countEl) countEl.textContent = count + '只';
        if (dataNote) dataNote.textContent = '观察日期：' + day + ' · 范围：沪深A股';
        if (calendarValue) calendarValue.textContent = day;
        calendarMonth = day.slice(0, 7);
        var latest = dates[0] || day;
        setStatus(day === latest ? '最新快照' : ('历史 · ' + day), false);
        var idx = dates.indexOf(day);
        if (historyPrev) historyPrev.disabled = idx < 0 || idx >= dates.length - 1 || loading;
        if (historyNext) historyNext.disabled = idx <= 0 || loading;
        if (calendarBtn) calendarBtn.disabled = loading;
        if (calendarPanel && !calendarPanel.hidden) renderCalendar();
      }

      function paint(data) {
        currentDate = data.data_as_of || currentDate;
        var rows = buildRows(data);
        var html = rows.map(function(row, index) { return rowHtml(row, index, currentDate); }).join('') +
          '<div class="chip-row chip-row-empty" id="chip-search-empty" hidden><strong>没有匹配标的</strong><span>换个代码、名称或首字母试试</span></div>';
        list.innerHTML = html;
        empty = document.getElementById('chip-search-empty');
        bindShareholderToggles();
        page = 1;
        updateMeta(data);
        renderPager();
      }

      function loadDate(day) {
        if (!day || day === currentDate || loading) return;
        if (cache[day]) {
          paint(cache[day]);
          return;
        }
        loading = true;
        setStatus('加载中…', false);
        if (calendarBtn) calendarBtn.disabled = true;
        closeCalendar();
        if (historyPrev) historyPrev.disabled = true;
        if (historyNext) historyNext.disabled = true;
        fetch('/api/public/v1/low-chip-metrics?date=' + day)
          .then(function(r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .then(function(resp) {
            var data = { data_as_of: day, rows: [] };
            if (resp.results) {
              resp.results.forEach(function(row) {
                var code = row.stock_code;
                var stockName = row.stock_name || '';
                var themes = row.theme_concepts ? JSON.parse(row.theme_concepts) : [];
                data.rows.push({
                  symbol: code,
                  name: stockName || code,
                  nameInitials: nameInitials(stockName || code),
                  price: row.price,
                  change_percent: row.change_percent,
                  industry: row.industry || '待补充',
                  sector: row.sector || '待补充',
                  themeConcept: themes.slice(0, 3).join('、'),
                  themeConcepts: themes.slice(0, 3),
                  financials: row.financials ? JSON.parse(row.financials) : {},
                  qualityShareholder: Boolean(row.shareholder_nature?.quality_shareholder ?? row.quality_shareholder),
                  qualityShareholderNames: row.shareholder_nature?.quality_shareholder_names || [],
                  institutionalShareholder: Boolean(row.shareholder_nature?.institutional_shareholder),
                  institutionalShareholderNames: row.shareholder_nature?.institutional_shareholder_names || [],
                  shareholderMetrics: {
                    shareholder_count: row.shareholder_count,
                    shareholder_change_pct: row.shareholder_change_pct,
                    chip_focus: row.chip_focus,
                    main_force: row.main_force,
                    main_force_label: row.main_force_label,
                    top10_float_ratio: row.top10_float_ratio,
                    report_period: row.report_period,
                    price: row.price,
                  }
                });
              });
            }
            cache[day] = data;
            loading = false;
            paint(data);
          })
          .catch(function(err) {
            loading = false;
            setStatus('加载失败', true);
            if (calendarBtn) calendarBtn.disabled = false;
            if (calendarValue) calendarValue.textContent = currentDate;
            updateMeta(cache[currentDate] || { data_as_of: currentDate, rows: [] });
            console.error(err);
          });
      }

      prevBtn.addEventListener('click', function() { if (page > 1) { page--; renderPager(); } });
      nextBtn.addEventListener('click', function() { page++; renderPager(); });
      if (searchInput) {
        searchInput.addEventListener('input', function() { query = normalize(searchInput.value); page = 1; renderPager(); });
      }
      filterButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var key = btn.dataset.filter;
          if (!key) return;
          if (activeFilters.has(key)) activeFilters.delete(key); else activeFilters.add(key);
          btn.classList.toggle('is-active', activeFilters.has(key));
          btn.setAttribute('aria-pressed', activeFilters.has(key) ? 'true' : 'false');
          page = 1;
          renderPager();
        });
      });
      if (filterReset) filterReset.addEventListener('click', function() {
        activeFilters.clear();
        filterButtons.forEach(function(btn) {
          btn.classList.remove('is-active');
          btn.setAttribute('aria-pressed', 'false');
        });
        page = 1;
        renderPager();
      });

      if (calendarBtn) calendarBtn.addEventListener('click', function(event) { event.stopPropagation(); toggleCalendar(); });
      if (calendarPanel) calendarPanel.addEventListener('click', function(event) { event.stopPropagation(); });
      if (calendarMonthPrev) calendarMonthPrev.addEventListener('click', function() { calendarMonth = monthShift(calendarMonth, -1); renderCalendar(); });
      if (calendarMonthNext) calendarMonthNext.addEventListener('click', function() { calendarMonth = monthShift(calendarMonth, 1); renderCalendar(); });
      document.addEventListener('click', closeCalendar);
      document.addEventListener('keydown', function(event) { if (event.key === 'Escape') closeCalendar(); });
      if (historyPrev) historyPrev.addEventListener('click', function() {
        var idx = dates.indexOf(currentDate);
        if (idx >= 0 && idx < dates.length - 1) loadDate(dates[idx + 1]);
      });
      if (historyNext) historyNext.addEventListener('click', function() {
        var idx = dates.indexOf(currentDate);
        if (idx > 0) loadDate(dates[idx - 1]);
      });

      // support ?date=YYYY-MM-DD deep link
      try {
        var params = new URLSearchParams(window.location.search);
        var qDate = params.get('date');
        if (qDate && dates.indexOf(qDate) !== -1 && qDate !== currentDate) {
          loadDate(qDate);
        } else {
          bindShareholderToggles();
          updateMeta(initialData);
          renderPager();
        }
      } catch (e) {
        bindShareholderToggles();
        updateMeta(initialData);
        renderPager();
      }
    })();
    </script>
  </body>
</html>

