---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import RollingSubnav from '../../components/RollingSubnav.astro';
import { SITE_TITLE } from '../../consts';
import lowChipData from '../../../public/data/a-low-chip-stocks.json';

const title = `低筹码股｜周月季收盘获利筛选 | ${SITE_TITLE}`;
const description = 'A股收盘获利比例低于3%的周线、月线、季线筛选结果。';
const periodSections = [
  { key: 'week', label: '周线', rows: lowChipData.periods.week },
  { key: 'month', label: '月线', rows: lowChipData.periods.month },
  { key: 'quarter', label: '季线', rows: lowChipData.periods.quarter },
];
const allRows = periodSections.flatMap((period) => period.rows);
const intersectionRows = allRows.filter((row, index, rows) =>
  lowChipData.intersection.includes(row.symbol) && rows.findIndex((item) => item.symbol === row.symbol) === index
);
const valuesBySymbol = Object.fromEntries(
  lowChipData.intersection.map((symbol) => [
    symbol,
    Object.fromEntries(periodSections.map((period) => [period.key, period.rows.find((row) => row.symbol === symbol)?.value])),
  ])
);
const fmt = (value: number, digits = 2) => Number(value).toFixed(digits);
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={title} description={description} /></head>
  <body>
    <Header />
    <main id="main-content" class="low-chip-main site-shell">
      <RollingSubnav active="low-chip" />

      <header class="low-chip-hero">
        <div>
          <p class="eyebrow">A股滚动 · 低筹码筛选</p>
          <h1>低筹码股</h1>
          <p>筛选条件：A股、非ST、非退市，收盘获利比例低于3%。该比例表示按对应周期筹码成本模型估算，收盘时处于盈利状态的筹码占比。</p>
        </div>
        <dl>
          <div><dt>筛选日期</dt><dd>{lowChipData.data_as_of}</dd></div>
          <div><dt>三周期均低于3%</dt><dd>{intersectionRows.length}只</dd></div>
        </dl>
      </header>

      <section class="intersection-panel" aria-labelledby="intersection-title">
        <div class="panel-head">
          <p class="eyebrow">三个周期同时满足</p>
          <h2 id="intersection-title">周线、月线、季线均低于3%</h2>
        </div>
        <div class="table-wrap">
          <table class="low-chip-table">
            <thead><tr><th>股票</th><th>代码</th><th>周线</th><th>月线</th><th>季线</th><th>最新价</th><th>涨跌幅</th></tr></thead>
            <tbody>
              {intersectionRows.map((row) => (
                <tr>
                  <td><strong>{row.name}</strong></td>
                  <td>{row.symbol}</td>
                  <td>{fmt(valuesBySymbol[row.symbol].week, 1)}%</td>
                  <td>{fmt(valuesBySymbol[row.symbol].month, 1)}%</td>
                  <td>{fmt(valuesBySymbol[row.symbol].quarter, 1)}%</td>
                  <td>¥{fmt(row.price)}</td>
                  <td class:list={[row.change_percent >= 0 ? 'up' : 'down']}>{row.change_percent >= 0 ? '+' : ''}{fmt(row.change_percent)}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <footer class="data-note">
        <strong>数据来源：iWenCai</strong>
        <span>筛选日期：2026-07-31 · 指标：收盘获利比例 · 阈值：低于3%</span>
        <p>收盘获利比例属于筹码成本模型估算值。低于3%表示对应周期内绝大多数筹码处于浮亏状态，页面用于超跌与套牢盘观察。</p>
      </footer>
    </main>
    <Footer />
  </body>
</html>

<style>
  .low-chip-main{padding-bottom:3rem;color:#14243b}
  .low-chip-hero,.intersection-panel,.period-section,.data-note{border:1px solid #dbe3ec;border-radius:14px;background:#fff}
  .low-chip-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.25rem;padding:1.35rem}
  .eyebrow{margin:0 0 .35rem;color:#64748b;font-size:.75rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
  h1,h2,p{margin-top:0}.low-chip-hero h1{margin-bottom:.45rem;font-size:2rem}.low-chip-hero p:last-child{max-width:720px;margin-bottom:0;color:#526176;line-height:1.7}
  .low-chip-hero dl{display:grid;grid-template-columns:repeat(2,minmax(82px,1fr));gap:.5rem;margin:0}
  .low-chip-hero dl div{padding:.65rem .8rem;border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc}
  dt{color:#64748b;font-size:.72rem;font-weight:800}dd{margin:.2rem 0 0;font-size:1rem;font-weight:900}
  .intersection-panel{display:block;margin-top:1rem;border:1px solid #dbe3ec;border-radius:14px;background:#fff;overflow:hidden}
  .panel-head{padding:1rem 1.2rem;border-left:4px solid #d97706;border-bottom:1px solid #e2e8f0}
  .panel-head h2{margin:0;font-size:1.15rem}
  .table-wrap{overflow-x:auto}
  .low-chip-table{width:100%;border-collapse:collapse;font-size:.9rem}
  .low-chip-table th,.low-chip-table td{padding:.75rem 1rem;border-bottom:1px solid #edf1f5;text-align:right;white-space:nowrap}
  .low-chip-table th:first-child,.low-chip-table td:first-child{text-align:left}
  .low-chip-table th{color:#64748b;background:#f8fafc;font-size:.75rem}
  .low-chip-table tbody tr:last-child td{border-bottom:0}
  .up{color:#b91c1c;font-weight:800}.down{color:#047857;font-weight:800}
  .data-note{margin-top:1rem;padding:1rem 1.1rem;color:#526176;font-size:.82rem;line-height:1.65}.data-note strong,.data-note span{display:block}.data-note strong{color:#14243b}.data-note p{margin:.35rem 0 0}
  @media(max-width:720px){.low-chip-hero{grid-template-columns:1fr}.low-chip-table th,.low-chip-table td{padding:.7rem .75rem}}
</style>
