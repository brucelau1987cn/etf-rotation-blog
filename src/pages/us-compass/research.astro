---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import UsSubnav from '../../components/UsSubnav.astro';
import UsResearchHero from '../../components/us-research/UsResearchHero.astro';
import UsResearchHealthStrip from '../../components/us-research/UsResearchHealthStrip.astro';
import UsRankIcPanel from '../../components/us-research/UsRankIcPanel.astro';
import UsShadowHealthPanel from '../../components/us-research/UsShadowHealthPanel.astro';
import UsResearchArchive from '../../components/us-research/UsResearchArchive.astro';

const archive = JSON.parse(readFileSync(join(process.cwd(), 'public/data/us-compass-research.json'), 'utf8'));
const reports = archive.reports || [];
const latest = reports[0] || {};
const metricRows = ['t1', 't5', 't20'].map((key) => ({ key: key.toUpperCase().replace('T', 'T+'), ...(latest.metrics?.[key] || {}) }));
const formatPct = (value: unknown, suffix = '%') => Number.isFinite(Number(value)) ? `${Number(value) > 0 ? '+' : ''}${Number(value).toFixed(2)}${suffix}` : '—';
const formatPlainPct = (value: unknown) => Number.isFinite(Number(value)) ? `${Number(value).toFixed(2)}%` : '—';
const formatDate = (value: string) => value || '—';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <BaseHead title="美股ETF罗盘｜模型学习" description="美股ETF罗盘前向学习与模型审计：T+1/T+5/T+20 RankIC、影子组合归因、风险预算和问财外部验证。" />
  <style is:inline>
    :root{--research-navy:#13243a;--research-blue:#2b6cb0;--research-green:#247a52;--research-amber:#a76600;--research-red:#b53a3a;--research-line:#dce5ee;--research-muted:#65758a}
    main.research-page{width:var(--shell-width);max-width:none;margin:auto;padding:1rem 0 3.5rem}.panel{background:#fff;border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--box-shadow)}
    .research-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;padding:1.35rem 1.5rem;color:#fff;background:var(--research-navy)}.eyebrow,.section-kicker{font-size:.69rem;font-weight:950;letter-spacing:.12em}.eyebrow{color:#9ac5ee}.research-hero h1{margin:.35rem 0 .3rem;color:#fff;font-size:clamp(2rem,5vw,3rem);letter-spacing:-.04em}.research-hero p{max-width:68ch;margin:0;color:#c9d7e5;line-height:1.6}.hero-status{min-width:180px;align-self:start;padding:.8rem 1rem;border:1px solid rgba(255,255,255,.18);border-radius:14px;background:rgba(255,255,255,.08)}.hero-status span,.hero-status small{display:block;color:#b9ccdd;font-size:.7rem}.hero-status strong{display:block;margin:.3rem 0;color:#fff;font-size:1.2rem}
    .summary-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin:.8rem 0}.summary-card{padding:.9rem;border-left:4px solid var(--research-blue)}.summary-card:nth-child(2){border-left-color:var(--research-amber)}.summary-card:nth-child(3){border-left-color:var(--research-green)}.summary-card:nth-child(4){border-left-color:var(--research-red)}.summary-card span{display:block;color:var(--research-muted);font-size:.7rem;font-weight:850}.summary-card strong{display:block;margin:.35rem 0;color:#18263a;font-size:1.45rem}.summary-card small{color:#7b8a9d;font-size:.68rem;line-height:1.4}
    .section-head{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin:1.45rem 0 .65rem}.section-head h2{margin:.2rem 0 0;font-size:1.35rem}.section-head p{margin:0;color:var(--research-muted);font-size:.75rem}.section-kicker{color:var(--research-blue)}
    .table-wrap{overflow-x:auto}.research-table{width:100%;border-collapse:collapse;font-size:.77rem}.research-table th,.research-table td{padding:.72rem .75rem;border-bottom:1px solid var(--research-line);text-align:right;white-space:nowrap}.research-table th:first-child,.research-table td:first-child{text-align:left}.research-table th{color:#536477;background:#f6f8fb;font-size:.68rem}.research-table tr:last-child td{border-bottom:0}.positive{color:var(--research-red);font-weight:850}.negative{color:var(--research-green);font-weight:850}
    .analysis-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:.8rem}.analysis-card{padding:1rem}.analysis-card h3{margin:0 0 .7rem;font-size:1rem}.attribution-list,.observation-list{display:grid;gap:.5rem;margin:0;padding:0;list-style:none}.attribution-row{display:grid;grid-template-columns:1fr auto;gap:.7rem;padding:.65rem .7rem;border-radius:11px;background:#f6f8fb}.attribution-row span{color:var(--research-muted);font-size:.73rem}.attribution-row b{font-size:.8rem}.iwencai-note{padding:1rem;border-left:4px solid #d89a12}.iwencai-note h3{margin:0}.iwencai-note p{margin:.45rem 0 0;color:#506176;font-size:.78rem;line-height:1.65}.source-tag{display:inline-flex;margin-top:.65rem;padding:.25rem .48rem;border-radius:999px;background:#fff4d8;color:#825800;font-size:.68rem;font-weight:900}
    .top10-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem}.top10-row{display:grid;grid-template-columns:52px 1fr auto;gap:.55rem;align-items:center;padding:.65rem .7rem;border:1px solid var(--research-line);border-radius:11px}.top10-row strong{font-size:.8rem}.top10-row span{color:var(--research-muted);font-size:.7rem}.top10-row b{font-size:.72rem}
    .observation-list li{padding:.7rem .8rem;border-radius:11px;background:#f7f9fc;color:#45566b;font-size:.77rem;line-height:1.55}.method-note{margin-top:.8rem;padding:.85rem 1rem;border:1px solid #e5cf9f;border-radius:13px;background:#fff9e9;color:#6f5728;font-size:.75rem;line-height:1.6}
    .archive-list{display:grid;gap:.55rem}.archive-item{padding:.85rem 1rem}.archive-item summary{display:grid;grid-template-columns:110px 1fr auto;gap:.75rem;align-items:center;cursor:pointer;list-style:none}.archive-item summary::-webkit-details-marker{display:none}.archive-item summary strong{font-size:.85rem}.archive-item summary span{color:var(--research-muted);font-size:.73rem}.archive-body{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem;margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--research-line)}.archive-body div{padding:.6rem;border-radius:10px;background:#f6f8fb}.archive-body span{display:block;color:var(--research-muted);font-size:.65rem}.archive-body b{font-size:.78rem}
    @media(max-width:820px){.research-hero{grid-template-columns:1fr}.hero-status{min-width:0}.summary-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.analysis-grid{grid-template-columns:1fr}}@media(max-width:560px){.research-hero{padding:1rem}.summary-strip,.top10-grid{grid-template-columns:1fr}.section-head{align-items:start}.archive-item summary{grid-template-columns:1fr auto}.archive-item summary span{grid-column:1}.archive-body{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <Header />
  <main class="site-shell research-page">
    <UsSubnav active="research" />
    <UsResearchHero archive={archive} latest={latest} />
    <UsResearchHealthStrip latest={latest} />
    <UsRankIcPanel latest={latest} metricRows={metricRows} />
    <UsShadowHealthPanel latest={latest} />

    <div class="section-head"><div><span class="section-kicker">EXTERNAL VALIDATION</span><h2>问财验证</h2></div><p>外部证据补充，本地前向指标为主</p></div>
    <section class="iwencai-note panel"><h3>{latest.iwencai?.status === 'ok' ? '外部验证已完成' : '外部验证暂不可用'}</h3><p>{latest.iwencai?.summary || '问财验证暂不可用'}</p><span class="source-tag">数据来源：同花顺问财</span></section>

    <div class="section-head"><div><span class="section-kicker">RESEARCH NOTES</span><h2>观察与边界</h2></div><p>周报不自动调整生产参数</p></div>
    <section class="analysis-card panel"><ul class="observation-list">{(latest.observations || ['样本积累中']).map((item: string) => <li>{item}</li>)}</ul><div class="method-note">模型学习页面属于前向验证与审计层。达到样本门槛后仅进入实验讨论；生产权重、仓位阈值和正式动作规则仍需人工确认。</div></section>

    <UsResearchArchive reports={reports} />
  </main>
  <Footer />
</body>
</html>