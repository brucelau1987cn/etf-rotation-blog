---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import UsSubnav from '../../components/UsSubnav.astro';
import WeeklyStockRecommendations from '../../components/WeeklyStockRecommendations.astro';
import weeklyData from '../../../public/data/weekly-stock-recommendations.json';
const items = weeklyData.markets.US.items;
---
<!doctype html><html lang="zh-CN"><head><BaseHead title="美股每周推荐 | ETF罗盘" description="美股主题股票每周推荐与加入以来持续追踪。" /></head><body><Header /><main class="site-shell weekly-page"><UsSubnav active="weekly" /><WeeklyStockRecommendations market="US" label="美股" items={items} weekOf={weeklyData.week_of} generatedAt={weeklyData.generated_at} /></main><Footer /><style>.weekly-page{padding:1rem 0 3rem}</style></body></html>
