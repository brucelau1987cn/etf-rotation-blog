---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FuturesSubnav from '../../components/FuturesSubnav.astro';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <BaseHead title="金银持仓｜黄金白银ETF持仓报告 | ETF罗盘" description="黄金与白银ETF每日持仓变动（吨）：总持仓走势、增减持明细与净变化。" />
  <style is:global>
    main{width:var(--shell-width);padding:1rem 0 3rem}
    .page-head{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;padding:.7rem 0 1rem;border-bottom:1px solid var(--border);margin-bottom:1.15rem}
    .page-head h1{margin:.25rem 0;font-size:clamp(1.8rem,4.5vw,2.75rem)}
    .page-head p{margin:0;color:rgb(var(--gray));max-width:620px;line-height:1.55;font-size:.86rem}
    .page-head small{display:block;color:var(--accent-dark);font-size:.68rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.12rem}
    .holdings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem}
    .holdings-panel{padding:1rem;border:1px solid var(--border);border-radius:14px;background:#fff;box-shadow:var(--box-shadow)}
    .holdings-panel.gold{border-top:5px solid #f59e0b}
    .holdings-panel.silver{border-top:5px solid #8a8f98}
    .panel-top{display:flex;justify-content:space-between;align-items:flex-start;gap:.75rem}
    .panel-title h2{margin:0;font-size:1.25rem}
    .panel-title p{margin:.15rem 0 0;color:rgb(var(--gray));font-size:.74rem}
    .asset-tag{padding:.22rem .55rem;border-radius:999px;font-size:.68rem;font-weight:850;background:var(--warm-2);color:rgb(var(--gray-dark));border:1px solid var(--border);white-space:nowrap}
    .asset-tag.up{background:var(--green-soft);color:var(--green);border-color:transparent}
    .asset-tag.down{background:var(--accent-soft);color:var(--accent-dark);border-color:transparent}
    .latest-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.4rem;margin:.75rem 0}
    .latest-cell{padding:.6rem .55rem;background:var(--warm-2);border-radius:9px;min-width:0}
    .latest-cell span{display:block;color:rgb(var(--gray));font-size:.62rem;font-weight:750}
    .latest-cell strong{display:block;margin-top:.15rem;font-size:.86rem;overflow:hidden;text-overflow:ellipsis}
    .latest-cell strong.up{color:var(--green)}
    .latest-cell strong.down{color:var(--accent-dark)}
    .holdings-status{margin:.4rem 0 .6rem;color:rgb(var(--gray));font-size:.74rem}
    .trust-chart{width:100%;height:100px;max-height:100px;margin:.5rem 0;border-radius:8px;background:var(--warm-2)}
    .holdings-list{display:grid;gap:0;border:1px solid var(--border);border-radius:11px;overflow:hidden}
    .holdings-header{display:grid;grid-template-columns:82px 1fr 68px;gap:.5rem;padding:.5rem .65rem;background:var(--warm-2);font-size:.66rem;font-weight:850;color:rgb(var(--gray-dark));border-bottom:1px solid var(--border)}
    .holdings-header span:last-child{text-align:right}
    .holdings-row{display:grid;grid-template-columns:82px 1fr 68px;gap:.5rem;padding:.45rem .65rem;border-bottom:1px solid var(--border);font-size:.7rem;align-items:center}
    .holdings-row:last-child{border-bottom:0}
    .holdings-week{font-weight:850;color:rgb(var(--black));white-space:nowrap}
    .holdings-bars{display:flex;gap:3px;align-items:center;min-height:22px;overflow:hidden}
    .holdings-bar{display:flex;align-items:center;min-width:4px;height:18px;border-radius:4px;padding:0 4px;box-sizing:border-box;transition:width .2s;flex-shrink:0}
    .holdings-bar span{font-size:.58rem;font-weight:850;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .holdings-bar.inc{background:var(--green);margin-right:2px}
    .holdings-bar.dec{background:var(--accent)}
    .holdings-net{text-align:right;font-weight:850;font-variant-numeric:tabular-nums;white-space:nowrap}
    .holdings-net.up{color:var(--green)}
    .holdings-net.down{color:var(--accent-dark)}
    .empty{text-align:center;padding:1.5rem;color:rgb(var(--gray));font-size:.78rem}
    .source-note{margin:1.5rem 0 0;color:rgb(var(--gray));font-size:.72rem;line-height:1.55;padding:1rem 0;border-top:1px solid var(--border)}
    @media(max-width:820px){.holdings-grid{grid-template-columns:1fr}}
    @media(max-width:680px){
      .page-head{display:block}
      .page-head p{font-size:.82rem}
      .holdings-header,.holdings-row{grid-template-columns:72px 1fr 60px}
      .holdings-bar span{font-size:.52rem}
    }
  </style>
</head>
<body>
  <Header />
  <FuturesSubnav active="holdings" />
  <main id="main-content">
    <div class="page-head">
      <div>
        <small>Gold & silver ETF holdings</small>
        <h1>金银持仓</h1>
        <p>黄金与白银ETF每日持仓变动（吨）。绿色=增持，红色=减持；净变化为当日变化差值。</p>
      </div>
    </div>
    <div class="holdings-grid" id="holdings-grid">
      <section class="holdings-panel gold" aria-label="黄金ETF持仓">
        <div class="panel-top">
          <div class="panel-title"><h2>黄金ETF</h2><p>近2周持仓变动</p></div>
          <span class="asset-tag" id="gold-tag">加载中…</span>
        </div>
        <div class="latest-grid" id="gold-latest"></div>
        <div class="holdings-status" id="gold-status">加载中…</div>
        <div id="gold-chart"></div>
        <div class="holdings-list" id="gold-list"></div>
      </section>
      <section class="holdings-panel silver" aria-label="白银ETF持仓">
        <div class="panel-top">
          <div class="panel-title"><h2>白银ETF</h2><p>近2周持仓变动</p></div>
          <span class="asset-tag" id="silver-tag">加载中…</span>
        </div>
        <div class="latest-grid" id="silver-latest"></div>
        <div class="holdings-status" id="silver-status">加载中…</div>
        <div id="silver-chart"></div>
        <div class="holdings-list" id="silver-list"></div>
      </section>
    </div>
    <p class="source-note">来源：金十App ETF持仓报告，经本站 Cloudflare Pages Function 只读代理与短时缓存。数据版权归原始提供方所有。</p>
  </main>
  <Footer />
  <script is:inline src="/js/jin10-holdings-app.js"></script>
</body>
</html>