---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FuturesSubnav from '../../components/FuturesSubnav.astro';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <BaseHead title="宏观数据｜宏观日历与重要事件 | ETF罗盘" description="按日期查看全球宏观数据、央行决议、重要事件及公布值与预期差。" />
  <style is:global>
    main{width:var(--shell-width);padding:1rem 0 3rem}
    .page-head{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;padding:.7rem 0 1rem;border-bottom:1px solid var(--border);margin-bottom:1.15rem}
    .page-head h1{margin:.25rem 0;font-size:clamp(1.8rem,4.5vw,2.75rem)}
    .page-head p{margin:0;color:rgb(var(--gray));max-width:620px;line-height:1.55;font-size:.86rem}
    .page-head small{display:block;color:var(--accent-dark);font-size:.68rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.12rem}
    .calendar-controls{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin:0 0 1.2rem}
    .date-field{display:grid;gap:.3rem}
    .date-field label{color:rgb(var(--gray));font-size:.72rem;font-weight:800}
    .date-field input{min-height:44px;padding:.55rem .7rem;border:1px solid var(--border);border-radius:10px;background:#fff;color:rgb(var(--black));font:inherit;font-weight:750}
    .calendar-actions{display:flex;gap:.5rem}
    .calendar-actions button{min-height:44px;padding:.55rem .8rem;border:1px solid var(--border);border-radius:10px;background:#fff;font:inherit;font-size:.8rem;font-weight:850;cursor:pointer;transition:all .12s}
    .calendar-actions button:hover{background:var(--warm-2)}
    .calendar-actions button.primary{border-color:rgb(var(--black));background:rgb(var(--black));color:#fff}
    .calendar-actions button.primary:hover{background:rgb(var(--gray-dark))}
    .calendar-tabs{display:flex;gap:.4rem;margin:0 0 .9rem;flex-wrap:wrap}
    .calendar-tabs button{padding:.45rem .72rem;border:1px solid var(--border);border-radius:8px;background:var(--warm-2);color:rgb(var(--gray-dark));font:inherit;font-size:.74rem;font-weight:850;cursor:pointer;transition:all .12s}
    .calendar-tabs button:hover{background:#fff;border-color:rgb(var(--gray))}
    .calendar-tabs button.active{border-color:rgb(var(--black));background:rgb(var(--black));color:#fff}
    .summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.62rem;margin-bottom:1rem}
    .summary-card{padding:.8rem .85rem;border:1px solid var(--border);border-radius:12px;background:#fff}
    .summary-card span{display:block;color:rgb(var(--gray));font-size:.66rem;font-weight:750}
    .summary-card strong{display:block;margin-top:.15rem;font-size:1.08rem}
    .calendar-status{margin:0 0 .85rem;color:rgb(var(--gray));font-size:.76rem}
    .calendar-list{display:grid;gap:.62rem}
    .calendar-item{display:grid;grid-template-columns:84px minmax(0,1fr);gap:.25rem .7rem;align-items:start;padding:.85rem .95rem;border:1px solid var(--border);border-radius:12px;background:#fff;border-left:4px solid transparent;position:relative}
    .calendar-item[data-type="data"]{border-left-color:var(--accent)}
    .calendar-item[data-type="event"]{border-left-color:#1b67b2}
    .calendar-item[data-type="holiday"]{border-left-color:var(--action-sell)}
    .calendar-time{font-size:.74rem;font-weight:850;font-variant-numeric:tabular-nums;grid-row:span 2;padding-top:.1rem}
    .calendar-time small{display:block;margin-top:.2rem;color:rgb(var(--gray));font-weight:750;font-size:.64rem}
    .calendar-meta{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem .55rem;margin-bottom:.2rem}
    .calendar-meta .type-badge{padding:.12rem .42rem;border-radius:6px;font-size:.62rem;font-weight:850;background:var(--warm-2);color:rgb(var(--gray-dark));border:1px solid var(--border)}
    .calendar-item[data-type="data"] .type-badge{background:var(--accent-soft);color:var(--accent-dark);border-color:transparent}
    .calendar-item[data-type="event"] .type-badge{background:#e8f2ff;color:#174ea6;border-color:transparent}
    .calendar-title{font-size:.88rem;font-weight:850;line-height:1.4;margin:0}
    .calendar-values{display:flex;flex-wrap:wrap;gap:.35rem .55rem;margin-top:.35rem}
    .calendar-values span{font-size:.72rem;color:rgb(var(--gray));white-space:nowrap;padding:.2rem .5rem;background:var(--warm-2);border-radius:7px;border:1px solid var(--border)}
    .calendar-values b{color:rgb(var(--black));font-weight:850}
    .pm-prob{display:inline-flex;align-items:center;gap:.35rem;margin-top:.35rem;padding:.2rem .55rem;border-radius:999px;background:#1b2a4a;color:#fff;font-size:.72rem;font-weight:850;white-space:nowrap}
    .pm-prob .pm-label{color:#93c5fd;font-size:.64rem;font-weight:900;letter-spacing:.05em}
    .pm-prob .pm-value{font-variant-numeric:tabular-nums}
    .pm-prob .pm-value[title]{cursor:help}
    .calendar-star-switch{display:flex;align-items:center;gap:.5rem;margin-top:.55rem;padding:.35rem .6rem;background:var(--warm-2);border:1px solid var(--border);border-radius:9px;width:max-content}
    .calendar-star-switch .switch-label{font-size:.74rem;font-weight:850;color:rgb(var(--black))}
    .calendar-star-switch .switch-hint{font-size:.7rem;color:rgb(var(--gray))}
    .calendar-star-switch .switch{position:relative;display:inline-block;width:34px;height:19px}
    .calendar-star-switch .switch input{opacity:0;width:0;height:0}
    .calendar-star-switch .slider{position:absolute;cursor:pointer;inset:0;background:#cbd5e1;border-radius:999px;transition:.2s}
    .calendar-star-switch .slider::before{content:"";position:absolute;height:15px;width:15px;left:2px;top:2px;background:#fff;border-radius:50%;transition:.2s}
    .calendar-star-switch .switch input:checked + .slider{background:#2563eb}
    .calendar-star-switch .switch input:checked + .slider::before{transform:translateX(15px)}
    .impact-row{display:inline-flex;flex-wrap:wrap;gap:.3rem;margin-top:.32rem}
    .impact-tag{display:inline-flex;padding:.2rem .5rem;border-radius:6px;font-size:.65rem;font-weight:900;line-height:1.4}
    .impact-tag.impact-bearish{background:var(--green-soft);color:var(--green)}
    .impact-tag.impact-bullish{background:var(--accent-soft);color:var(--accent-dark)}
    .impact-tag.impact-neutral{background:var(--warm-2);color:rgb(var(--gray-dark))}
    .stars{font-size:.72rem;letter-spacing:.08em;color:#f59e0b;grid-column:3;justify-self:end;white-space:nowrap}
    .source-note{margin:1.5rem 0 0;color:rgb(var(--gray));font-size:.72rem;line-height:1.55;padding:1rem 0;border-top:1px solid var(--border)}
    @media(max-width:680px){
      .page-head{display:block}
      .page-head p{font-size:.82rem}
      .calendar-controls{display:grid}
      .calendar-actions{width:100%}
      .calendar-actions button{flex:1}
      .summary{grid-template-columns:repeat(2,minmax(0,1fr))}
      .calendar-item{grid-template-columns:72px minmax(0,1fr)}
    }
  </style>
</head>
<body>
  <Header />
  <main id="main-content">
    <FuturesSubnav active="jin10" />
    <div class="page-head">
      <div>
        <small>Macro calendar · 宏观数据</small>
        <h1>宏观数据</h1>
        <p>按北京时间查看中国与美国宏观数据、央行决议和重要事件。其余国家已屏蔽；影响方向按金十口径同时标注金银与美元（如：利多金银 + 利空美元）。</p>
      </div>
    </div>
    <section aria-label="宏观数据查询">
      <div class="calendar-controls">
        <div class="date-field"><label for="calendar-date">查询日期</label><input id="calendar-date" type="date" /></div>
        <div class="calendar-actions"><button id="calendar-prev" type="button">前一天</button><button id="calendar-today" type="button">今天</button><button id="calendar-refresh" class="primary" type="button">刷新</button><button id="calendar-mcp" type="button">加载影响方向</button></div>
      </div>
      <div class="calendar-tabs" aria-label="日历分类"><button data-calendar-filter="important" type="button">重要总览</button><button class="active" data-calendar-filter="star4" type="button">四星以上</button><button data-calendar-filter="important-data" type="button">重要数据</button><button data-calendar-filter="important-event" type="button">重要事件</button><button data-calendar-filter="all" type="button">全部</button></div>
      <div class="calendar-star-switch"><span class="switch-label">四星以上开关</span><label class="switch"><input id="star4-toggle" type="checkbox" checked /><span class="slider"></span></label><span class="switch-hint" id="star4-hint">只看四星以上</span></div>
      <div class="summary" aria-label="日历统计"><div class="summary-card"><span>全部</span><strong id="calendar-count">—</strong></div><div class="summary-card"><span>宏观数据</span><strong id="calendar-data-count">—</strong></div><div class="summary-card"><span>事件总数</span><strong id="calendar-event-count">—</strong></div><div class="summary-card"><span>三星以上</span><strong id="calendar-important-count">—</strong></div><div class="summary-card"><span>四星以上</span><strong id="calendar-star4-count">—</strong></div></div>
      <div class="calendar-status" id="calendar-status" role="status" aria-live="polite">正在加载宏观数据…</div>
      <div class="calendar-list" id="calendar-list"></div>
      <p class="source-note">来源：金十财经日历，经本站 Cloudflare Pages Function 只读代理与短时缓存。数据版权归原始提供方所有；<a href="https://rili.jin10.com/" target="_blank" rel="noopener noreferrer">查看金十原始日历</a>。</p>
    </section>
  </main>
  <Footer />
  <script is:inline src="/js/jin10-calendar-app.js"></script>
</body>
</html>