---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import QuoteLiveScripts from '../../components/QuoteLiveScripts.astro';
import FuturesSubnav from '../../components/FuturesSubnav.astro';

type ReceiptPoint = { trade_date?: string | null; receipt?: number; change?: number | null; source?: string; derived?: boolean };
type Receipt = { status?: string; today?: ReceiptPoint | null; prev?: ReceiptPoint | null };
type Fvg = { direction?: string; lower?: number; upper?: number; status?: string };
type FutureItem = {
  code: string; continuous: string; name: string; exchange: string;
  contract_code?: string; contract_name?: string; price?: number; change_pct?: number;
  open?: number; high?: number; low?: number; prev_close?: number; amplitude_pct?: number;
  volume?: number; open_interest?: number; open_interest_change?: number;
  open_interest_change_pct?: number; capital_state?: string; quote_time?: string; is_main?: boolean;
  ma5?: number; ma10?: number; ma20?: number; atr14?: number; volume_ratio_20d?: number;
  range_20d_position_pct?: number; support?: number; resistance?: number; invalidation?: number;
  trend_state?: string; structure?: string; signal_label?: string; fvg?: Fvg;
  warehouse_receipt?: Receipt;
  unit?: string; tick?: number;
};
type Leader = { code?: string; name?: string; change_pct?: number; open_interest_change_pct?: number; capital_state?: string } | null;
type Summary = { strongest?: Leader; weakest?: Leader; largest_oi_increase?: Leader; largest_oi_decrease?: Leader; capital_counts?: Record<string, number>; ranking?: string[] };
type FuturesPayload = {
  generated_at?: string; source?: string; stale?: boolean; count?: number; expected_count?: number;
  iwencai_review?: { reviewed_at?: string; review_slot?: string; status?: string; row_count?: number };
  summary?: Summary; items: FutureItem[];
};
type Briefing = {
  generated_at?: string;
  index_delivery?: { month?: string; date?: string; weekday?: string; days_note?: string; symbols?: string[] };
  industry_policy?: Array<{ title?: string; scope?: string; impact?: string; as_of?: string; source?: string; url?: string }>;
  fed_watch?: { latest?: Array<{ time?: string; event?: string; result?: string; impact?: string }>; next_focus?: string; source?: string; calendar_url?: string };
};

const fallbackItems: FutureItem[] = [
  { code: 'LC', continuous: 'LC0', name: '碳酸锂', exchange: '广期所' },
  { code: 'PS', continuous: 'PS0', name: '多晶硅', exchange: '广期所' },
  { code: 'SI', continuous: 'SI0', name: '工业硅', exchange: '广期所' },
  { code: 'AU', continuous: 'AU0', name: '黄金', exchange: '上期所' },
  { code: 'AG', continuous: 'AG0', name: '白银', exchange: '上期所' },
  { code: 'CU', continuous: 'CU0', name: '铜', exchange: '上期所' },
  { code: 'AL', continuous: 'AL0', name: '铝', exchange: '上期所' },
  { code: 'SC', continuous: 'SC0', name: '原油', exchange: '能源中心' },
  { code: 'LH', continuous: 'LH0', name: '猪肉', exchange: '大商所' },
];
let snapshot: FuturesPayload = { items: fallbackItems };
try { snapshot = JSON.parse(readFileSync(join(process.cwd(), 'public/data/futures-compass.json'), 'utf8')); } catch {}
let briefing: Briefing = {};
try { briefing = JSON.parse(readFileSync(join(process.cwd(), 'public/data/futures-compass-briefing.json'), 'utf8')); } catch {}
const items = snapshot.items?.length ? snapshot.items : fallbackItems;
const summary = snapshot.summary || {};
const number = (value?: number | null, digits = 2) => value !== null && value !== undefined && Number.isFinite(Number(value)) ? Number(value).toLocaleString('zh-CN', { minimumFractionDigits: digits, maximumFractionDigits: digits }) : '—';
const priceDigits = (tick?: number) => Number(tick) >= 1 ? 0 : Number(tick) >= 0.1 ? 1 : 2;
const quote = (value?: number, tick?: number) => number(value, priceDigits(tick));
const pct = (value?: number) => Number.isFinite(Number(value)) ? `${Number(value) > 0 ? '+' : ''}${Number(value).toFixed(2)}%` : '—';
const multiple = (value?: number) => Number.isFinite(Number(value)) ? `${Number(value).toFixed(2)}×` : '—';
const tone = (value?: number) => Number(value) > 0 ? 'up' : Number(value) < 0 ? 'down' : 'flat';
const stateTone = (value?: string) => value?.includes('增仓上涨') ? 'bull' : value?.includes('增仓下跌') ? 'bear' : value?.includes('减仓') ? 'caution' : 'neutral';
const snapshotTime = (snapshot.generated_at || '').replace('T', ' ').replace('+08:00', '') || '等待刷新';
const deliveryDate = briefing.index_delivery?.date ? new Date(`${briefing.index_delivery.date}T00:00:00+08:00`) : null;
const now = new Date();
const deliveryDays = deliveryDate ? Math.max(0, Math.ceil((deliveryDate.getTime() - now.getTime()) / 86400000)) : null;
const reviewSlot: Record<string, string> = { preopen: '盘前', 'day-close': '日盘收盘', night: '夜盘' };
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title="期货罗盘 | ETF罗盘" description="期货罗盘跟踪中国商品期货主力行情、量仓结构、BOS与CHoCH、关键位、FVG及交易所仓单。" />
    <style>
      main{width:var(--shell-width);padding:1rem 0 3rem}.terminal{margin-top:.7rem;padding:1.25rem 1.35rem;border:1px solid #d9dfe6;border-radius:14px;background:linear-gradient(145deg,#fbfcfe 0%,#fff 58%,#f7f3ed 100%);color:#182235;box-shadow:0 4px 14px rgba(15,23,42,.07)}
      .terminal-top{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:end}.terminal h1{margin:.25rem 0 .35rem;color:#182235;font-size:clamp(1.65rem,3vw,2rem);line-height:1.18;letter-spacing:0}.terminal p{margin:0;color:#687386;font-size:.82rem;line-height:1.55;max-width:830px}.terminal-top .eyebrow{color:#335f8a}.data-stamp{display:flex;align-items:center;gap:.45rem;padding-bottom:.14rem;text-align:right;color:#7d8795;font-size:.7rem;white-space:nowrap;font-variant-numeric:tabular-nums}.data-stamp strong{color:#465267;font-size:.72rem}.data-stamp span+span:before{content:'·';margin-right:.45rem;color:#a4adba}
      .briefing-grid{display:grid;grid-template-columns:.72fr 1.14fr 1.14fr;margin-top:1rem;padding:1rem 1.05rem;border-radius:17px;background:#17243a;color:#fff}.briefing-panel{padding:.1rem 1.2rem .05rem;background:transparent;min-width:0;color:#f8fafc}.briefing-panel:first-child{padding-left:0}.briefing-panel:last-child{padding-right:0}.briefing-panel+.briefing-panel{border-left:1px solid rgba(255,255,255,.14)}.briefing-panel .eyebrow{color:#aebacc;font-size:.58rem;letter-spacing:.07em}.briefing-panel h2{margin:.08rem 0 0;color:#f8fafc;font-size:1rem;line-height:1.5}.briefing-panel>p{margin:.3rem 0 0;color:#b9c6d7;font-size:.72rem;line-height:1.55}.delivery-date{display:flex;align-items:baseline;flex-wrap:wrap;gap:.38rem;margin-top:.65rem}.delivery-date strong{color:#fff;font-size:1.45rem;line-height:1;font-variant-numeric:tabular-nums}.delivery-date span{color:#e1a13c;font-size:.72rem;font-weight:800}.delivery-countdown{display:block;margin-top:.45rem;color:#fff;font-size:1.45rem;line-height:1;font-weight:800;font-variant-numeric:tabular-nums}.briefing-panel .delivery-countdown .delivery-days{color:#fff;font-size:1.45rem;line-height:1;font-weight:800;font-variant-numeric:tabular-nums}.briefing-panel .delivery-countdown.is-urgent,.briefing-panel .delivery-countdown.is-urgent .delivery-days{color:#e1a13c}.brief-list{display:grid;gap:.48rem;margin-top:.55rem}.brief-item{padding-top:.48rem;border-top:1px solid rgba(255,255,255,.14)}.brief-item:first-child{padding-top:0;border-top:0}.brief-item a,.brief-item strong{display:block;color:#f3f6f9;font-size:.78rem;line-height:1.4;font-weight:650;text-decoration:none}.brief-item small{display:block;margin-top:.1rem;color:#9daabd;font-size:.63rem}.brief-item p{display:-webkit-box;margin:.18rem 0 0;overflow:hidden;color:#c4cedb;font-size:.7rem;line-height:1.48;-webkit-box-orient:vertical;-webkit-line-clamp:2}.fed-result{font-weight:600!important;color:#e9eef4!important}.source-line{margin-top:.5rem!important;padding-top:.45rem;border-top:1px solid rgba(255,255,255,.14)}.source-line a{color:#e1a13c}
      .section-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-end;margin:1.35rem 0 .65rem}.section-head h2{margin:0;font-size:1.3rem}.section-head p{margin:0;color:rgb(var(--gray));font-size:.78rem}.eyebrow{display:block;color:var(--amber);font-size:.65rem;font-weight:900;text-transform:uppercase}
      .refresh-row{display:flex;align-items:center;justify-content:space-between;gap:.8rem;margin:.65rem 0}.refresh-status{color:rgb(var(--gray));font-size:.75rem}.refresh-status strong{color:rgb(var(--gray-dark))}.refresh-button{display:inline-flex;align-items:center;gap:.35rem;padding:.45rem .65rem;border:1px solid var(--border);border-radius:8px;background:#fff;font:inherit;font-size:.74rem;font-weight:800;cursor:pointer}.refresh-button.loading .refresh-icon{animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
      .watch-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem}.future-card{padding:.88rem;border:1px solid var(--border);border-radius:10px;background:#fff;box-shadow:var(--box-shadow);min-width:0}.future-card.up{border-top:4px solid var(--market-up)}.future-card.down{border-top:4px solid var(--market-down)}.future-card.flat{border-top:4px solid #999}
      .future-top{display:flex;justify-content:space-between;gap:.5rem;align-items:flex-start}.future-top strong{display:block;font-size:.98rem}.future-top small{display:block;color:rgb(var(--gray));font-size:.66rem}.state-tag{padding:.18rem .42rem;border-radius:6px;font-size:.64rem;font-weight:850;white-space:nowrap}.state-tag.bull{background:#fff0ee;color:#bb3023}.state-tag.bear{background:#e8f7ef;color:#08733b}.state-tag.caution{background:#fff6df;color:#8d5c00}.state-tag.neutral{background:#f0f1f2;color:#596169}
      .quote{display:flex;align-items:flex-end;justify-content:space-between;gap:.6rem;margin:.72rem 0}.price{font-size:1.48rem;font-weight:900;line-height:1}.price-unit{display:block;margin-top:.2rem;color:rgb(var(--gray));font-size:.62rem;font-weight:700}.change{font-size:.86rem;font-weight:900}.up .change{color:var(--market-up)}.down .change{color:var(--market-down)}
      .quote-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.34rem}.quote-cell{padding:.46rem;background:var(--warm-2);border-radius:7px;min-width:0}.quote-cell span{display:block;color:rgb(var(--gray));font-size:.57rem}.quote-cell strong{display:block;margin-top:.1rem;font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .evidence-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.34rem;margin-top:.42rem}.evidence{padding:.44rem;border:1px solid var(--border);border-radius:7px;min-width:0}.evidence span{display:block;color:rgb(var(--gray));font-size:.57rem}.evidence strong{display:block;margin-top:.1rem;font-size:.69rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.warehouse-strip{display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin-top:.42rem;padding:.42rem .55rem;border-radius:7px;background:var(--warm-2);font-size:.68rem}.warehouse-strip span{color:rgb(var(--gray))}.warehouse-strip strong{font-weight:800}.warehouse-strip .wh-change{font-weight:700}.warehouse-strip .wh-change.up{color:var(--market-up)}.warehouse-strip .wh-change.down{color:var(--market-down)}.card-foot{display:flex;justify-content:space-between;gap:.45rem;margin-top:.45rem;color:rgb(var(--gray));font-size:.64rem}.card-foot b{color:rgb(var(--gray-dark))}
      .matrix{display:grid;grid-template-columns:1.05fr .95fr;gap:.75rem}.matrix-panel,.supply-panel{padding:.9rem;border:1px solid var(--border);border-radius:10px;background:#fff}.matrix-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem}.matrix-cell{padding:.65rem;border-radius:8px;background:var(--warm-2)}.matrix-cell span{display:block;color:rgb(var(--gray));font-size:.62rem}.matrix-cell strong{display:block;margin-top:.14rem;font-size:.82rem}.matrix-cell.bull{border-left:4px solid var(--market-up)}.matrix-cell.bear{border-left:4px solid var(--market-down)}.matrix-cell.caution{border-left:4px solid var(--amber)}
      .supply-list{display:grid;gap:.4rem}.supply-row{display:grid;grid-template-columns:1fr auto auto;gap:.5rem;align-items:center;padding:.58rem;border-bottom:1px solid var(--border);font-size:.75rem}.supply-row:last-child{border-bottom:0}.supply-row span{color:rgb(var(--gray))}.review-box{margin-top:.6rem;padding:.65rem;border-radius:8px;background:#172129;color:#dbe2e6;font-size:.72rem;line-height:1.55}.review-box strong{color:#fff}
      .legend{margin-top:.85rem;padding:.75rem;border:1px solid var(--border);border-radius:9px;background:var(--warm-2);font-size:.72rem;color:rgb(var(--gray));line-height:1.55}.legend b{color:rgb(var(--gray-dark))}
      @media(max-width:940px){.terminal-top{grid-template-columns:1fr}.data-stamp{padding:0;text-align:left}.briefing-grid{grid-template-columns:1fr 1fr}.briefing-panel{padding:0 1rem}.briefing-panel.delivery{grid-column:1/-1;padding:0 0 1rem;border-bottom:1px solid rgba(255,255,255,.14)}.briefing-panel:nth-child(2){padding-left:0;border-left:0}.watch-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.matrix{grid-template-columns:1fr}}
      @media(max-width:620px){main{width:var(--shell-width);padding-top:.6rem}.terminal{padding:1rem;border-radius:12px}.terminal-top{gap:.7rem}.terminal h1{font-size:1.65rem}.terminal p{font-size:.76rem}.data-stamp{flex-wrap:wrap;margin-top:.2rem}.briefing-grid{grid-template-columns:1fr;padding:.85rem}.briefing-panel,.briefing-panel:nth-child(2),.briefing-panel:last-child{padding:.85rem 0;border-left:0;border-bottom:1px solid rgba(255,255,255,.14)}.briefing-panel.delivery{grid-column:auto}.briefing-panel:first-child{padding-top:0}.briefing-panel:last-child{border-bottom:0;padding-bottom:0}.watch-grid{grid-template-columns:1fr}.section-head{display:block}.section-head p{margin-top:.2rem}.refresh-row{align-items:center}.refresh-button{min-width:44px;min-height:44px}.refresh-status{max-width:72%}.quote-grid,.evidence-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.matrix-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.supply-row{grid-template-columns:1fr auto}.supply-row span:last-child{grid-column:1/-1}}
    </style>
  </head>
  <body>
    <Header />
    <main>
      <FuturesSubnav active="home" />
      <section class="terminal" aria-label="期货罗盘决策总览">
        <div class="terminal-top"><div><span class="eyebrow">Futures market terminal</span><h1>商品期货趋势与供需雷达</h1><p>先验价格与持仓方向，再核验结构、关键位、成交活跃度及仓单；缺失数据标记为未知。</p></div><div class="data-stamp"><strong id="data-time">{snapshotTime.slice(0,16)}</strong><span id="source-label">{snapshot.source || '新浪期货'}</span><span>{snapshot.stale ? '最近有效快照' : '当前快照'}</span></div></div>
        <div class="briefing-grid" aria-label="期货事件提示">
          <article class="briefing-panel delivery">
          <span class="eyebrow">Index delivery</span><h2>股指期货交割提示</h2>
          <div class="delivery-date"><strong id="delivery-date" data-delivery-date={briefing.index_delivery?.date || ''}>{briefing.index_delivery?.date || '待更新'}</strong><span>{briefing.index_delivery?.weekday || ''}</span></div>
          {deliveryDays !== null ? (
            <span
              class={`delivery-countdown${deliveryDays <= 7 ? ' is-urgent' : ''}`}
              id="delivery-countdown"
              data-days={String(deliveryDays)}
            >
              {deliveryDays === 0 ? '今日交割' : (
                <>距交割 <strong class="delivery-days">{deliveryDays}</strong> 天</>
              )}
            </span>
          ) : null}
          <p>{briefing.index_delivery?.symbols?.join(' / ') || 'IF / IH / IC / IM'} · {briefing.index_delivery?.days_note || '到期月第三个周五，节假日顺延。'}</p>
        </article>
        <article class="briefing-panel">
          <span class="eyebrow">Industry policy</span><h2>标的行业政策利好</h2>
          <div class="brief-list">
            {(briefing.industry_policy || []).slice(0, 3).map((item) => <div class="brief-item"><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a><small>{item.scope} · {item.as_of}</small><p>{item.impact}</p></div>)}
          </div>
        </article>
        <article class="briefing-panel">
          <span class="eyebrow">Fed watch · Jin10</span><h2>美联储关键信息</h2>
          <div class="brief-list">
            {(briefing.fed_watch?.latest || []).slice(0, 2).map((item) => <div class="brief-item"><strong>{item.event}</strong><small>{item.time}</small><p class="fed-result">{item.result}</p><p>{item.impact}</p></div>)}
          </div>
          <p class="source-line">{briefing.fed_watch?.next_focus} <a href="/futures-compass/jin10/">查看本站宏观数据</a> · <a href={briefing.fed_watch?.calendar_url || 'https://rili.jin10.com/'} target="_blank" rel="noopener noreferrer">查看金十财经日历</a></p>
          </article>
        </div>
      </section>

      <section aria-label="期货观察池">
        <div class="section-head"><div><span class="eyebrow">Main contracts</span><h2>主力合约观察池</h2></div><p>实时行情每60秒检查；结构与关键位使用已收盘日线。</p></div>
        <div class="refresh-row"><div class="refresh-status" id="refresh-status" role="status" aria-live="polite"><strong>静态快照</strong> · 正在连接实时数据</div><button class="refresh-button" id="refresh-button" type="button" aria-label="刷新期货行情"><span class="refresh-icon" aria-hidden="true">↻</span>刷新</button></div>
        <div class="watch-grid" id="futures-grid">
          {items.map((item) => (
            <article class={`future-card ${tone(item.change_pct)}`} data-code={item.code}>
              <div class="future-top"><div><strong>{item.name} · 主连 {item.continuous}</strong><small class="contract-name">实际主力 {item.contract_code || '待确认'} · {item.exchange}</small></div><span class={`state-tag ${stateTone(item.capital_state)}`}>{item.signal_label || item.capital_state || '等待确认'}</span></div>
              <div class="quote"><div><strong class="price">{quote(item.price,item.tick)}</strong><small class="price-unit">{item.unit || ''}</small></div><span class="change">{pct(item.change_pct)}</span></div>
              <div class="quote-grid">
                <div class="quote-cell"><span>开盘</span><strong class="open">{quote(item.open,item.tick)}</strong></div><div class="quote-cell"><span>日内高</span><strong class="high">{quote(item.high,item.tick)}</strong></div><div class="quote-cell"><span>日内低</span><strong class="low">{quote(item.low,item.tick)}</strong></div>
                <div class="quote-cell"><span>成交量 · 手</span><strong class="volume">{number(item.volume,0)}</strong></div><div class="quote-cell"><span>持仓量 · 手</span><strong class="open-interest">{number(item.open_interest,0)}</strong></div><div class="quote-cell"><span>较昨持仓</span><strong class="oi-change">{number(item.open_interest_change,0)} · {pct(item.open_interest_change_pct)}</strong></div>
              </div>
              <div class="evidence-grid">
                <div class="evidence"><span>趋势</span><strong class="trend-state">{item.trend_state || '未知'}</strong></div><div class="evidence"><span>结构</span><strong class="structure">{item.structure || '未知'}</strong></div><div class="evidence"><span>20日位置</span><strong class="range-position">{pct(item.range_20d_position_pct)}</strong></div>
                <div class="evidence"><span>支撑 · {item.unit || ''}</span><strong class="support">{quote(item.support,item.tick)}</strong></div><div class="evidence"><span>压力 · {item.unit || ''}</span><strong class="resistance">{quote(item.resistance,item.tick)}</strong></div><div class="evidence"><span>量比20日</span><strong class="volume-ratio">{multiple(item.volume_ratio_20d)}</strong></div>
              </div>
              {item.warehouse_receipt?.status === 'known' && item.warehouse_receipt?.today ? (
                <div class="warehouse-strip">
                  <span>仓单</span>
                  <span class="wh-date">{item.warehouse_receipt.today.trade_date || ''}</span>
                  <strong>{number(item.warehouse_receipt.today.receipt, 0)}</strong>
                  <span class={`wh-change ${tone(item.warehouse_receipt.today.change)}`}>日变 {number(item.warehouse_receipt.today.change, 0)}</span>
                  {item.warehouse_receipt.prev ? (
                    <>
                      <span class="wh-date">{item.warehouse_receipt.prev.trade_date || '上个交易日'}</span>
                      <strong>{number(item.warehouse_receipt.prev.receipt, 0)}</strong>
                    </>
                  ) : null}
                </div>
              ) : (
                <div class="warehouse-strip">
                  <span>仓单</span>
                  <span style="color:rgb(var(--gray))">暂无数据</span>
                </div>
              )}
              <div class="card-foot"><span><b class="capital-state">{item.capital_state || '量仓未知'}</b> · <span class="fvg-state">{item.fvg?.direction || 'FVG未知'}</span></span><span class="quote-time">{item.quote_time || '—'}</span></div>
            </article>
          ))}
        </div>
      </section>

      <section aria-label="结构与供需">
        <div class="section-head"><div><span class="eyebrow">Evidence matrix</span><h2>强弱矩阵与供需复查</h2></div><p>量仓四象限、交易所仓单和定时复查分别保留来源时间。</p></div>
        <div class="matrix">
          <article class="matrix-panel"><div class="matrix-grid"><div class="matrix-cell bull"><span>增仓上涨</span><strong>{summary.capital_counts?.['增仓上涨'] || 0} 个 · 趋势资金确认</strong></div><div class="matrix-cell bear"><span>增仓下跌</span><strong>{summary.capital_counts?.['增仓下跌'] || 0} 个 · 空头资金确认</strong></div><div class="matrix-cell caution"><span>减仓上涨</span><strong>{summary.capital_counts?.['减仓上涨'] || 0} 个 · 空头回补</strong></div><div class="matrix-cell caution"><span>减仓下跌</span><strong>{summary.capital_counts?.['减仓下跌'] || 0} 个 · 多头离场</strong></div></div><div class="legend"><b>排序：</b>{summary.ranking?.join(' → ') || '等待足够数据'}。排序综合当日涨跌、持仓变化率和20日量比，仅作横向证据比较。</div></article>
          <article class="supply-panel">
            <div class="review-box"><strong>定时复查：</strong>{reviewSlot[snapshot.iwencai_review?.review_slot || ''] || '待首次复查'} · {snapshot.iwencai_review?.status === 'ok' ? `覆盖 ${snapshot.iwencai_review?.row_count || 0} 行` : '状态未知'}<br />时间 {(snapshot.iwencai_review?.reviewed_at || '—').replace('T',' ').replace('+08:00','')}</div>
          </article>
        </div>
        <div class="legend"><b>口径：</b>红涨绿跌；价格摘要显示涨跌幅，持仓摘要显示较昨持仓变化率；"支撑/压力"由20日区间和ATR14计算并按合约最小变动单位取整；BOS/CHoCH使用最近已收盘K线；仓单数据已合并至每个品种卡片内（来源：广期所/上期所 akShare）。实时失败时页面保留最近有效快照并明确标记。</div>
      </section>
    </main>
