---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const title = `订阅管理后台 | ${SITE_TITLE}`;
const description = '管理订阅密码：创建、查看、撤销订阅。';
---
<BaseHead title={title} description={description} />
<body>
  <Header />
  <main class="admin-main site-shell">
    <div class="admin-header">
      <div>
        <p class="admin-eyebrow">ETF 罗盘 · 管理后台</p>
        <h1>订阅管理</h1>
        <p class="admin-desc">创建带有效期的订阅密码、查看全部订阅、撤销不再续订的账号。密码只显示一次，请及时保存。</p>
      </div>
    </div>

    <!-- 登录态区块 -->
    <section class="admin-login" id="admin-login" hidden>
      <h2>管理员登录</h2>
      <form id="admin-login-form" novalidate>
        <label for="admin-password">管理员密码</label>
        <input id="admin-password" type="password" autocomplete="current-password" placeholder="管理员密码" required />
        <button type="submit">登录 →</button>
        <p class="admin-msg" id="admin-login-msg" role="status"></p>
      </form>
    </section>

    <!-- 管理面板 -->
    <section class="admin-panel" id="admin-panel" hidden>
      <div class="admin-panel-top">
        <h2>创建订阅</h2>
        <form id="create-form" class="create-form" novalidate>
          <input id="create-label" placeholder="备注（订阅者名）" />
          <select id="create-days">
            <option value="7">7 天</option>
            <option value="30" selected>30 天</option>
            <option value="90">90 天</option>
            <option value="180">180 天</option>
            <option value="365">365 天</option>
          </select>
          <button type="submit">生成密码</button>
        </form>
        <div class="create-result" id="create-result" hidden>
          <strong>新订阅密码（只显示一次）</strong>
          <code id="create-pass"></code>
          <span id="create-meta"></span>
        </div>
      </div>

      <div class="admin-list">
        <h2>全部订阅（<span id="sub-count">0</span>）</h2>
        <table class="admin-table">
          <thead>
            <tr><th>备注</th><th>到期</th><th>状态</th><th>创建时间</th><th>操作</th></tr>
          </thead>
          <tbody id="sub-tbody"></tbody>
        </table>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const loginBox = $('admin-login'), panel = $('admin-panel');

      async function api(path, opts = {}) {
        const res = await fetch(path, {
          headers: { 'Content-Type': 'application/json' },
          ...opts,
        });
        return { status: res.status, data: await res.json().catch(() => ({})) };
      }

      function loadList() {
        api('/api/admin/subscriptions').then(({ status, data }) => {
          if (status === 401) {
            loginBox.hidden = false; panel.hidden = true;
            return;
          }
          loginBox.hidden = true; panel.hidden = false;
          const items = data.items || [];
          $('sub-count').textContent = items.length;
          $('sub-tbody').innerHTML = items.map((it) => `
            <tr class="${it.revoked ? 'row-revoked' : ''}">
              <td>${it.label || '—'}</td>
              <td>${it.expires_at || '—'}</td>
              <td>${it.revoked ? '已撤销' : (it.expires_at < new Date().toISOString().slice(0, 10) ? '已过期' : '有效')}</td>
              <td>${it.created_at ? String(it.created_at).slice(0, 10) : '—'}</td>
              <td>${it.revoked ? '<span class="muted">—</span>' : `<button class="mini-btn" data-id="${it.id}">撤销</button>`}</td>
            </tr>`).join('');
          document.querySelectorAll('.mini-btn').forEach((btn) => {
            btn.addEventListener('click', async () => {
              if (!confirm('确认撤销该订阅？')) return;
              await api('/api/admin/subscriptions?action=revoke', { method: 'POST', body: JSON.stringify({ id: btn.dataset.id }) });
              loadList();
            });
          });
        });
      }

      $('admin-login-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = $('admin-login-msg');
        msg.textContent = ''; msg.className = 'admin-msg';
        const { status, data } = await api('/api/admin/login', {
          method: 'POST',
          body: JSON.stringify({ password: $('admin-password').value }),
        });
        if (status === 200 && data.ok) { msg.textContent = '✔ 登录成功'; msg.className = 'admin-msg ok'; loadList(); }
        else { msg.textContent = data.error || '登录失败'; msg.className = 'admin-msg error'; }
      });

      $('create-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const { status, data } = await api('/api/admin/subscriptions', {
          method: 'POST',
          body: JSON.stringify({ label: $('create-label').value, days: Number($('create-days').value) }),
        });
        if (status === 200 && data.ok) {
          $('create-pass').textContent = data.passphrase;
          $('create-meta').textContent = `备注 ${data.label || '—'} · ${data.days} 天 · 到期 ${data.expires_at}`;
          $('create-result').hidden = false;
          $('create-label').value = '';
          loadList();
        } else {
          alert(data.error || '创建失败');
        }
      });

      loadList();
    })();
  </script>
</body>

<style>
  .admin-main { padding-bottom: 3rem; }
  .admin-header { margin: 1.2rem 0 1.4rem; }
  .admin-eyebrow { font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: rgb(var(--gray-mid)); margin: 0 0 .35rem; }
  .admin-header h1 { font-size: 1.6rem; margin: 0 0 .45rem; }
  .admin-desc { color: rgb(var(--gray-mid)); font-size: .85rem; max-width: 52rem; line-height: 1.55; margin: 0; }

  .admin-login, .admin-panel {
    border: 1px solid var(--border); border-radius: 14px; background: #fff; padding: 1.4rem 1.5rem; margin-bottom: 1rem;
  }
  .admin-login { max-width: 400px; }
  .admin-login h2, .admin-panel h2 { font-size: 1.05rem; margin: 0 0 .9rem; }
  .admin-login label { display: block; font-size: .78rem; font-weight: 800; margin-bottom: .4rem; }
  .admin-login input {
    width: 100%; box-sizing: border-box; font-size: 1rem; padding: .6rem .8rem;
    border: 1px solid var(--border); border-radius: 10px; margin-bottom: .8rem; outline: none;
  }
  .admin-login button {
    padding: .6rem 1.2rem; font-weight: 800; color: #fff; background: #1e3a8a;
    border: none; border-radius: 10px; cursor: pointer;
  }
  .admin-msg { font-size: .82rem; margin: .8rem 0 0; }
  .admin-msg.ok { color: #0aa869; }
  .admin-msg.error { color: #e04444; }

  .admin-panel-top { margin-bottom: 1.4rem; }
  .create-form { display: flex; gap: .6rem; flex-wrap: wrap; align-items: center; }
  .create-form input { flex: 1 1 200px; padding: .55rem .8rem; border: 1px solid var(--border); border-radius: 10px; font-size: .9rem; }
  .create-form select { padding: .55rem .6rem; border: 1px solid var(--border); border-radius: 10px; font-size: .9rem; }
  .create-form button {
    padding: .55rem 1.1rem; font-weight: 800; color: #fff; background: #0aa869;
    border: none; border-radius: 10px; cursor: pointer;
  }
  .create-result {
    margin-top: 1rem; padding: 1rem; border: 1px dashed #34d399; border-radius: 12px; background: #f0fdf4;
  }
  .create-result strong { display: block; font-size: .8rem; margin-bottom: .5rem; }
  .create-result code {
    display: block; font-size: 1.3rem; font-weight: 900; letter-spacing: .12em;
    padding: .6rem .8rem; background: #fff; border-radius: 8px; margin-bottom: .4rem;
  }
  .create-result span { font-size: .78rem; color: rgb(var(--gray-mid)); }

  .admin-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  .admin-table th, .admin-table td { text-align: left; padding: .55rem .6rem; border-top: 1px solid var(--border); }
  .admin-table th { color: rgb(var(--gray-mid)); font-size: .72rem; }
  .admin-table tbody tr:hover { background: #f8fafc; }
  .row-revoked { opacity: .5; }
  .mini-btn {
    padding: .3rem .7rem; font-size: .74rem; font-weight: 700; color: #e04444;
    background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; cursor: pointer;
  }
  .muted { color: rgb(var(--gray-mid)); }
</style>
