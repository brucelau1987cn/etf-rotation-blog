---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <BaseHead title="财经日历｜宏观数据与重要事件 | ETF罗盘" description="按日期查看全球宏观数据、央行决议、重要事件及公布值与预期差。" />
  <style>
    main{width:var(--shell-width);padding:1rem 0 3rem}.calendar-hero{margin:.7rem 0 1rem;padding:1.2rem 1.3rem;border:1px solid var(--border);border-radius:16px;background:#fff;box-shadow:var(--box-shadow)}.eyebrow{color:var(--accent-dark);font-size:.67rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.calendar-hero h1{margin:.25rem 0 .35rem;font-size:clamp(1.7rem,3vw,2.2rem)}.calendar-hero p{max-width:780px;margin:0;color:rgb(var(--gray));font-size:.86rem;line-height:1.6}.calendar-controls{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin:1rem 0}.date-field{display:grid;gap:.3rem}.date-field label{color:rgb(var(--gray));font-size:.72rem;font-weight:800}.date-field input{min-height:44px;padding:.55rem .7rem;border:1px solid var(--border);border-radius:9px;background:#fff;color:rgb(var(--black));font:inherit;font-weight:750}.calendar-actions{display:flex;gap:.5rem}.calendar-actions button{min-height:44px;padding:.55rem .8rem;border:1px solid var(--border);border-radius:9px;background:#fff;font:inherit;font-size:.8rem;font-weight:850;cursor:pointer}.calendar-actions button.primary{border-color:rgb(var(--black));background:rgb(var(--black));color:#fff}.summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.55rem;margin-bottom:.9rem}.summary div{padding:.7rem .75rem;border:1px solid var(--border);border-radius:10px;background:#fff}.summary span{display:block;color:rgb(var(--gray));font-size:.65rem}.summary strong{display:block;margin-top:.12rem;font-size:1.05rem}.calendar-status{margin:.4rem 0 .8rem;color:rgb(var(--gray));font-size:.76rem}.calendar-list{display:grid;gap:.55rem}.calendar-item{display:grid;grid-template-columns:84px minmax(0,1fr) auto;gap:.75rem;align-items:start;padding:.8rem .9rem;border:1px solid var(--border);border-radius:11px;background:#fff}.calendar-time{font-size:.74rem;font-weight:850;font-variant-numeric:tabular-nums}.calendar-time small{display:block;margin-top:.18rem;color:rgb(var(--gray));font-size:.62rem}.calendar-title{font-size:.85rem;font-weight:850;line-height:1.45}.calendar-meta{margin-top:.22rem;color:rgb(var(--gray));font-size:.67rem}.calendar-values{display:flex;gap:.6rem;margin-top:.45rem}.calendar-values span{color:rgb(var(--gray));font-size:.66rem}.calendar-values b{color:rgb(var(--black));font-size:.72rem}.impact-tag{display:inline-flex;margin-top:.42rem;padding:.2rem .42rem;border-radius:6px;background:#e8f7ef;color:#08733b;font-size:.65rem;font-weight:900}.stars{color:#df8d16;font-size:.72rem;white-space:nowrap}.type-tag{display:inline-block;margin-right:.35rem;color:var(--accent-dark);font-size:.62rem;font-weight:900}.empty{padding:1.4rem;border:1px dashed var(--border);border-radius:11px;text-align:center;color:rgb(var(--gray));background:#fff}.source-note{margin-top:1rem;padding:.7rem .8rem;border-radius:9px;background:var(--warm-2);color:rgb(var(--gray));font-size:.7rem;line-height:1.55}.source-note a{color:var(--accent-dark);font-weight:800}.calendar-item[data-type="event"]{border-left:4px solid #335f8a}.calendar-item[data-type="data"]{border-left:4px solid var(--accent)}
    .calendar-tabs{display:flex;gap:.4rem;margin:0 0 .85rem}.calendar-tabs button{padding:.45rem .68rem;border:1px solid var(--border);border-radius:8px;background:#fff;color:rgb(var(--gray-dark));font:inherit;font-size:.74rem;font-weight:850;cursor:pointer}.calendar-tabs button.active{border-color:rgb(var(--black));background:rgb(var(--black));color:#fff}
    @media(max-width:680px){.calendar-controls{display:grid}.calendar-actions{width:100%}.calendar-actions button{flex:1}.summary{grid-template-columns:repeat(2,minmax(0,1fr))}.calendar-item{grid-template-columns:68px minmax(0,1fr)}.stars{grid-column:2}.calendar-values{flex-wrap:wrap}}
  </style>
</head>
<body>
  <Header />
  <main id="main-content">
    <section class="calendar-hero">
      <span class="eyebrow">Macro calendar · Jin10</span>
      <h1>财经日历</h1>
      <p>按北京时间查看全球宏观数据、央行决议和重要事件。优先关注三星以上项目及“公布值—预期值”的偏离。</p>
    </section>
    <section aria-label="财经日历查询">
      <div class="calendar-controls">
        <div class="date-field"><label for="calendar-date">查询日期</label><input id="calendar-date" type="date" /></div>
        <div class="calendar-actions"><button id="calendar-prev" type="button">前一天</button><button id="calendar-today" type="button">今天</button><button id="calendar-refresh" class="primary" type="button">刷新</button></div>
      </div>
      <div class="calendar-tabs" aria-label="日历分类"><button class="active" data-calendar-filter="important" type="button">重要总览</button><button data-calendar-filter="important-data" type="button">重要数据</button><button data-calendar-filter="important-event" type="button">重要事件</button><button data-calendar-filter="all" type="button">全部</button></div>
      <div class="summary" aria-label="日历统计"><div><span>全部</span><strong id="calendar-count">—</strong></div><div><span>宏观数据</span><strong id="calendar-data-count">—</strong></div><div><span>事件总数</span><strong id="calendar-event-count">—</strong></div><div><span>三星以上</span><strong id="calendar-important-count">—</strong></div></div>
      <div class="calendar-status" id="calendar-status" role="status" aria-live="polite">正在加载财经日历…</div>
      <div class="calendar-list" id="calendar-list"></div>
      <p class="source-note">来源：金十财经日历，经本站 Cloudflare Pages Function 只读代理与短时缓存。数据版权归原始提供方所有；<a href="https://rili.jin10.com/" target="_blank" rel="noopener noreferrer">查看金十原始日历</a>。</p>
    </section>
  </main>
  <Footer />
  <script is:inline src="/js/jin10-calendar-app.js"></script>
</body>
</html>
