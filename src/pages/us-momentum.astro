---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UsSubnav from '../components/UsSubnav.astro';
import UsMomentumHero from '../components/UsMomentumHero.astro';
import UsMomentumMatrix from '../components/UsMomentumMatrix.astro';
import UsMomentumLines from '../components/UsMomentumLines.astro';
import UsMomentumUniverse from '../components/UsMomentumUniverse.astro';
import '../styles/us-momentum.css';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <BaseHead title="美股趋势风控雷达｜ETF池市场结构与风险过滤" description="美股趋势风控雷达：通过市场广度、相对SPY强度、趋势质量和交易风险，为左侧轮动与右侧动量提供确认和过滤。" />
</head>
<body>
  <Header />
  <main class="us-momentum-main">
    <UsSubnav active="trend" />
    <UsMomentumHero />
    <UsMomentumMatrix />
    <UsMomentumLines />
    <div class="section-head">
      <div>
        <span class="kicker">TREND × MACRO</span>
        <h2>趋势与宏观联动</h2>
      </div>
      <p>强趋势遇到宏观约束时，降级为等待回踩</p>
    </div>
    <section class="macro-map card" id="macro-map"><p>正在读取宏观雷达…</p></section>
    <UsMomentumUniverse />
    <details class="quality card">
      <summary>数据时间、口径与限制</summary>
      <p id="scope">模型快照与行情检查时间分开显示。趋势风控用于确认和过滤，不构成买入建议。</p>
      <a href="/us-compass/history/">查看历史成绩与审计口径</a>
    </details>
  </main>
  <Footer />
  <script is:inline src="/js/momentum-shared.js"></script>
  <script is:inline src="/js/us-momentum-app.js"></script>
</body>
</html>
