---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UsSubnav from '../components/UsSubnav.astro';
import UsMacroHero from '../components/UsMacroHero.astro';
import UsMacroDimensions from '../components/UsMacroDimensions.astro';
import UsMacroFundGrid from '../components/UsMacroFundGrid.astro';
import UsMacroEvents from '../components/UsMacroEvents.astro';
import UsMacroPulse from '../components/UsMacroPulse.astro';
import '../styles/us-macro.css';

const data = JSON.parse(readFileSync(join(process.cwd(), 'public/data/us-macro-dashboard.json'), 'utf8'));
const toneIcon = (tone: string) => tone === 'danger' ? '🔴' : tone === 'warning' ? '🟠' : tone === 'positive' ? '🟢' : tone === 'missing' ? '⚪' : '🟡';
const riskIcon = data.risk.key === 'danger' ? '🔴' : data.risk.key === 'tight' ? '🟠' : data.risk.key === 'slightly-tight' ? '🟡' : '🟢';
const dateTime = (raw: string) => raw ? raw.replace('T', ' ').replace(/\.\d+/, '').replace(/-\d\d:\d\d$/, ' ET') : '—';
const calendarDate = (raw: string) => raw ? new Intl.DateTimeFormat('zh-CN', { month: 'short', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(`${raw}T12:00:00-04:00`)) : '—';
const marketCards = [
  { key:'dollar', label:'美元指数', symbol:'DXY', impact:'全球流动性' },
  { key:'oil', label:'原油代理', symbol:'USO', impact:'能源与通胀' },
  { key:'gold', label:'黄金', symbol:'GLD', impact:'避险与实际利率' },
  { key:'copper', label:'铜矿代理', symbol:'COPX', impact:'工业周期' },
].map((item) => ({...item, ...(data.market[item.key] || {})}));
---
<!doctype html>
<html lang="zh-CN">
<head>
  <BaseHead title="美股宏观雷达｜风险与事件终端" description="美股宏观风险雷达：波动率、利率曲线、流动性、信用广度、事件日历及ETF影响映射。" />
</head>
<body>
  <Header />
  <main class="us-macro-main site-shell">
    <UsSubnav active="macro" />
    <UsMacroHero
      riskIcon={riskIcon}
      risk={data.risk}
      generatedAtText={dateTime(data.generated_at)}
    />
    <UsMacroDimensions dimensions={data.dimensions || []} toneIcon={toneIcon} />
    <UsMacroFundGrid
      kicker="LIQUIDITY LEDGER"
      title="利率与流动性底表"
      note="SOFR与ON RRP来自纽约联储，Fed资产来自H.4.1，TGA来自财政部；频率不同，不伪装成盘中实时流量。"
      items={data.liquidity_components || []}
    />
    <UsMacroFundGrid
      kicker="ECONOMIC FUNDAMENTALS"
      title="就业、通胀与增长景气"
      note="月度与季度数据只调整风险预算，不替代ETF价格触发。"
      items={data.fundamentals || []}
    />
    <UsMacroEvents
      events={data.events || []}
      impacts={data.impacts || []}
      calendarDate={calendarDate}
    />
    <UsMacroPulse marketCards={marketCards} />
    <details class="quality card">
      <summary>数据质量、来源与口径</summary>
      <div class="quality-grid">
        <div><span>免费来源</span><b>{data.sources.join(' · ')}</b></div>
        <div><span>本轮缺失</span><b>{data.data_quality.failed}项</b></div>
        <div><span>风险口径</span><b>波动＋利率＋信用，不机械数灯</b></div>
      </div>
      <p>{data.data_quality.note} 缺失值显示N/A，不使用模型猜测补值。</p>
      <div class="links">
        <a href="/us-compass/">返回今日动作</a>
        <a href="/us-momentum/">查看趋势风控</a>
        <a href="/us-compass/history/">历史成绩</a>
      </div>
    </details>
  </main>
  <Footer />
</body>
</html>
