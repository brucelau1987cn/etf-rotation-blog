---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildUsTradeLinks, paperTradeAnchor, usSignalAnchor } from '../lib/us-paper-trade-links.mjs';

const data = JSON.parse(readFileSync(join(process.cwd(), 'public/data/paper-trading.json'), 'utf8'));
const usHistory = JSON.parse(readFileSync(join(process.cwd(), 'public/data/us-etf-flower-history.json'), 'utf8'));
const accounts = Object.values(data.accounts) as any[];
const money = (n: number, c: string) => new Intl.NumberFormat('zh-CN', { style: 'currency', currency: c, maximumFractionDigits: 2 }).format(n || 0);
const pct = (n: number) => `${((n || 0) * 100).toFixed(2)}%`;
const tone = (n: number) => n > 0 ? 'positive' : n < 0 ? 'negative' : 'neutral';
const formatTime = (value?: string) => value ? new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date(value)) : '尚未开始';
const label = (market: string) => market === 'A' ? '🇨🇳 A股账户' : '🇺🇸 美股账户';
const pending = (a: any) => a.public_pending_signals ?? a.pending_signals ?? [];
const usTradeLinks = buildUsTradeLinks(data.accounts?.US?.events || [], usHistory.records || []);
const usTradeById = new Map(usTradeLinks.map((trade: any) => [trade.event.id, trade]));
const recentEvents = accounts
  .flatMap((a: any) => (a.events || []).map((e: any) => ({ ...e, currency: a.currency, trade: a.market === 'US' ? usTradeById.get(e.id) : null })))
  .sort((a: any, b: any) => b.timestamp.localeCompare(a.timestamp))
  .slice(0, 20);
const reasonLabel = (event: any) => event.trade?.reasonLabel || ({ plant: '正式伏击买入', target: '触及兑现位卖出', stop: '触及防守线卖出', harvest: '兑现信号卖出', exit: '破位撤退卖出' } as Record<string,string>)[event.reason] || event.reason;
const signalKindLabel = (kind?: string) => ({ plant: '伏击', harvest: '兑现', exit: '破位撤退' } as Record<string,string>)[kind || ''] || '关联信号';
const positionSignalHref = (account: any, position: any) => account.market === 'US' && position.signal_date
  ? `/us-compass/history/#${usSignalAnchor(position.signal_date, position.symbol, position.signal_kind || 'plant')}`
  : account.market === 'A' ? '/a-compass/history/' : null;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title="ETF模拟盘｜前向交易验证" description="A股与美股ETF模拟盘的规则化交易、持仓、净值和前向验证记录。" />
    <style>
      main{width: var(--shell-width);padding:1rem 0 3rem}.card{border:1px solid var(--border);box-shadow:0 10px 30px rgba(26,36,30,.05)}
      .hero{padding:1.1rem;background:linear-gradient(135deg,#eef7f1,#fffaf1)}h1{margin:.3rem 0}.hero p{margin:.35rem 0}.muted{color:rgb(var(--gray));font-size:.8rem}
      .accounts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem;margin-top:1rem}.account{padding:1rem}.account-head{display:flex;justify-content:space-between;align-items:flex-start;gap:.5rem}.account h2{margin:.1rem 0}.account-head small{color:rgb(var(--gray))}
      .metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem;margin:.8rem 0}.metric{padding:.65rem;background:var(--warm-2);border-radius:10px}.metric span{display:block;font-size:.68rem;color:rgb(var(--gray));margin-bottom:.16rem}.metric b{font-size:.94rem}.positive{color:var(--market-up)}.negative{color:var(--market-down)}.neutral{color:rgb(var(--gray))}
      .subhead{display:flex;justify-content:space-between;align-items:center;margin:1rem 0 .35rem}.subhead h3{margin:0}.position,.pending{display:grid;grid-template-columns:1fr auto;gap:.25rem .65rem;padding:.65rem 0;border-top:1px solid var(--border)}.position small,.pending small{display:block;color:rgb(var(--gray));margin-top:.18rem}.position .levels{grid-column:1/-1;font-size:.72rem;color:rgb(var(--gray))}
      .empty{padding:.8rem;background:var(--warm-2);border-radius:10px;color:rgb(var(--gray));font-size:.82rem}.history{margin-top:.85rem;overflow-x:auto}.history table{width:100%;border-collapse:collapse;font-size:.76rem}.history th,.history td{padding:.48rem .35rem;border-bottom:1px solid var(--border);text-align:right;white-space:nowrap}.history th:first-child,.history td:first-child{text-align:left}
      .events{margin-top:1rem;padding:1rem}.trade-table-wrap{overflow-x:auto}.trade-table{width:100%;border-collapse:collapse;font-size:.76rem}.trade-table th,.trade-table td{padding:.62rem .5rem;border-top:1px solid var(--border);text-align:left;vertical-align:top;white-space:nowrap}.trade-table th{border-top:0;color:rgb(var(--gray));font-size:.68rem}.trade-table td:nth-child(3){min-width:180px;white-space:normal}.trade-table small{display:block;margin-top:.16rem;color:rgb(var(--gray));font-size:.66rem}.trade-action{font-weight:900}.trade-action.buy{color:var(--market-up)}.trade-action.sell{color:var(--market-down)}.signal-link{color:#245c94;font-weight:800;text-decoration:none}.position-signal-link{margin-left:.35rem;color:#245c94;font-weight:800;text-decoration:none}.disclaimer{margin-top:1rem;padding:.85rem;border:1px dashed #d99a00;background:#fff8e8;border-radius:12px;font-size:.8rem}
      @media(max-width:760px){.accounts{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.hero,.account,.events{padding:.85rem}.trade-table{min-width:940px}}
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="hero card">
        <span class="pill">PAPER TRADING · FORWARD TEST</span>
        <h1>ETF模拟盘</h1>
        <p>严格按罗盘正式信号撮合；“准备”信号不成交。同一根K线同时触发时，先按失效处理。</p>
        <small class="muted">更新：{formatTime(data.updated_at)}（北京时间） · A股 ¥150,000｜美股 US$20,000 · 行情：🔴上涨 / 🟢下跌</small>
      </section>

      <div class="accounts">
        {accounts.map((a: any) => (
          <section class="account card" id={a.market === 'A' ? 'a-share' : 'us'}>
            <div class="account-head"><div><h2>{label(a.market)}</h2><small>起始 {a.inception_date || '待首次运行'} · 持仓 {Object.keys(a.positions || {}).length}/10</small></div><a href={a.market === 'A' ? '/a-compass/' : '/us-compass/'}>返回罗盘 →</a></div>
            <div class="metrics">
              <div class="metric"><span>账户权益</span><b>{money(a.equity,a.currency)}</b></div>
              <div class="metric"><span>当日收益</span><b class={tone(a.daily_return)}>{pct(a.daily_return)}</b></div>
              <div class="metric"><span>累计收益</span><b class={tone(a.cumulative_return)}>{pct(a.cumulative_return)}</b></div>
              <div class="metric"><span>最大回撤</span><b class={tone(a.max_drawdown)}>{pct(a.max_drawdown)}</b></div>
              <div class="metric"><span>可用现金</span><b>{money(a.cash,a.currency)}</b></div>
              <div class="metric"><span>现金占比</span><b>{pct(a.cash_ratio ?? (a.cash/a.equity))}</b></div>
            </div>

            <div class="subhead"><h3>当前持仓</h3><small>未实现 <b class={tone(a.unrealized_pnl)}>{money(a.unrealized_pnl,a.currency)}</b></small></div>
            {Object.values(a.positions || {}).length ? Object.values(a.positions).map((p: any) => (
              <div class="position"><div><b>{p.symbol} · {p.name}</b><small>{p.quantity}份 · 买入均价 {money(p.entry_price,a.currency)} · 现价 {money(p.last_price,a.currency)}{positionSignalHref(a,p) && <a class="position-signal-link" href={positionSignalHref(a,p)}>查看买入信号 →</a>}</small></div><b>{money(p.quantity*p.last_price,a.currency)}</b><div class="levels">买入时间 {formatTime(p.entry_at)}｜目标 {p.target ?? '—'}｜失效 {p.stop ?? '—'}｜信号日 {p.signal_date ?? '—'}</div></div>
            )) : <p class="empty">暂无持仓，等待正式伏击信号触发。</p>}

            <div class="subhead"><h3>待触发</h3><small>{pending(a).length}项</small></div>
            {pending(a).length ? pending(a).map((p: any) => (
              <div class="pending"><div><b>{p.symbol} · {p.name}</b><small>回踩 {p.support ?? '—'}｜目标 {p.target ?? '—'}｜失效 {p.stop ?? '—'}</small></div><span>观察</span></div>
            )) : <p class="empty">当前没有正式待成交信号；准备信号不会进入订单。</p>}

            <div class="subhead"><h3>每日净值</h3><small>前向记录</small></div>
            {(a.history || []).length ? <div class="history"><table><thead><tr><th>日期</th><th>权益</th><th>当日</th><th>累计</th><th>回撤</th></tr></thead><tbody>{a.history.slice(-10).reverse().map((h: any) => <tr><td>{h.date}</td><td>{money(h.equity,a.currency)}</td><td class={tone(h.daily_return)}>{pct(h.daily_return)}</td><td class={tone(h.cumulative_return)}>{pct(h.cumulative_return)}</td><td class={tone(h.max_drawdown)}>{pct(h.max_drawdown)}</td></tr>)}</tbody></table></div> : <p class="empty">首个交易日收盘后开始形成净值序列。</p>}
          </section>
        ))}
      </div>

      <section class="events card" id="trades">
        <div class="subhead"><h2>最近虚拟成交</h2><small>时间、方向、价格、数量、金额、费用与罗盘来源逐笔对应</small></div>
        {recentEvents.length ? <div class="trade-table-wrap"><table class="trade-table">
          <thead><tr><th>成交时间</th><th>动作</th><th>标的 / 原因</th><th>罗盘信号</th><th>成交价</th><th>数量</th><th>成交额</th><th>费用</th><th>卖出盈亏</th></tr></thead>
          <tbody>{recentEvents.map((e: any) => {
            const tradeAnchor = e.trade?.tradeAnchor || paperTradeAnchor(e.id);
            const gross = e.trade?.gross ?? Number(e.quantity || 0) * Number(e.price || 0);
            return <tr id={tradeAnchor}>
              <td>{e.trade ? <><b>{e.trade.executionDate}</b><small>{e.trade.executionTime}</small><small>北京 {formatTime(e.timestamp)}</small></> : <b>{formatTime(e.timestamp)}</b>}</td>
              <td><span class:list={['trade-action', e.side]}>{e.side === 'buy' ? '买入' : '卖出'}</span></td>
              <td><b>{e.symbol} · {e.name}</b><small>{reasonLabel(e)}</small></td>
              <td>{e.trade?.linkedSignal ? <a class="signal-link" href={e.trade.signalHref}>{e.trade.linkedSignal.date} · {signalKindLabel(e.trade.linkedSignal.kind)} →</a> : <span class="muted">账户规则</span>}</td>
              <td>{money(e.price,e.currency)}</td>
              <td>{e.quantity}份</td>
              <td>{money(gross,e.currency)}</td>
              <td>{money(e.cost,e.currency)}</td>
              <td>{e.trade?.realizedPnl != null ? <b class={tone(e.trade.realizedPnl)}>{money(e.trade.realizedPnl,e.currency)}</b> : '—'}</td>
            </tr>;
          })}</tbody>
        </table></div> : <p class="empty">暂无成交。系统只执行正式信号，不追溯补生成交。</p>}
      </section>
      <p class="disclaimer">⚠️ {data.disclaimer} 页面展示的是虚拟撮合结果，不代表任何券商账户或真实订单。</p>
    </main>
    <Footer />
  </body>
</html>
