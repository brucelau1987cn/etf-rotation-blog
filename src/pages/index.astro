---
import { closeSync, openSync, readFileSync, readSync } from 'node:fs';
import { join } from 'node:path';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import QuoteLiveScripts from '../components/QuoteLiveScripts.astro';
import { isTakeProfitSide, publicHomeCopy } from '../lib/homeCopy.mjs';
import { SITE_TITLE } from '../consts';

type AAction = { code:string; name:string; status:string; action:string; price?:number; support?:number; target?:number; stop?:number; action_level?:number; action_level_label?:string; distance_pct?:number; risk_level?:string; price_date?:string };
type GardenData = { date:string; updated_at:string; stage?:string; level_data_as_of?:string; market_state:string; position:string; mainline:string; summary:string; harvest:AAction[]; plant:AAction[] };
type UsAction = { symbol:string; name:string; price:number; support:number; target:number; stop:number; trade_state:string; signal:string; trigger_level:number; support_gap?:number; target_gap?:number; risk_level:string; trade_date:string };
type UsData = { date:string; updated_at:string; summary:string; market_regime:{state:string;equity_allocation:string}; flower_signals:Record<string,UsAction[]>; flower_counts:Record<string,number> };

const rename = (raw:string) => raw.replaceAll('准备种花','候场').replaceAll('准备摘花','止盈观察').replaceAll('种花','伏击').replaceAll('摘花','兑现').replaceAll('失效退出','破位撤退').replaceAll('回踩位','伏击位').replaceAll('目标位','兑现位').replaceAll('失效线','防守线').replaceAll('ETF花园','ETF罗盘').replaceAll('US ETF Garden','US ETF Compass').replaceAll('Flower Signals','Compass Signals');
const dataPath = (name:string) => join(process.cwd(),`public/data/${name}`);
const readJsonObjectHead = (name:string, maxBytes = 24_000) => {
  const fd = openSync(dataPath(name), 'r');
  try {
    const buf = Buffer.alloc(maxBytes);
    const n = readSync(fd, buf, 0, maxBytes, 0);
    return buf.subarray(0, n).toString('utf8');
  } finally {
    closeSync(fd);
  }
};
const extractNamedObject = (text:string, key:string) => {
  const marker = `"${key}"`;
  const keyAt = text.indexOf(marker);
  if (keyAt < 0) return {};
  const start = text.indexOf('{', keyAt);
  if (start < 0) return {};
  let depth = 0;
  let inString = false;
  let escaped = false;
  for (let i = start; i < text.length; i += 1) {
    const ch = text[i];
    if (inString) {
      if (escaped) escaped = false;
      else if (ch === '\\') escaped = true;
      else if (ch === '"') inString = false;
      continue;
    }
    if (ch === '"') {
      inString = true;
      continue;
    }
    if (ch === '{') depth += 1;
    else if (ch === '}') {
      depth -= 1;
      if (depth === 0) return JSON.parse(text.slice(start, i + 1));
    }
  }
  return {};
};
const readPoolSummary = (name:string) => {
  const summary = extractNamedObject(readJsonObjectHead(name), 'summary') as Record<string, number>;
  return {
    momentum_pass_count: Number(summary.momentum_pass_count ?? summary.momentum_pass ?? 0),
    universe_count: Number(summary.universe_count ?? summary.universe ?? 0),
    momentum_pass: Number(summary.momentum_pass ?? summary.momentum_pass_count ?? 0),
    universe: Number(summary.universe ?? summary.universe_count ?? 0),
  };
};
const garden = JSON.parse(rename(readFileSync(dataPath('garden-recommendations.json'),'utf8'))) as GardenData & { mid_macro?: any };
const aPool = { summary: readPoolSummary('etf-garden-pool.json') };
const us = JSON.parse(rename(readFileSync(dataPath('us-etf-garden.json'),'utf8'))) as UsData;
const usPool = { summary: readPoolSummary('us-etf-pool.json') };
const macro = JSON.parse(readFileSync(dataPath('us-macro-dashboard.json'),'utf8'));
let aMid: any = garden.mid_macro || null;
try {
  const midFile = JSON.parse(readFileSync(dataPath('a-share-mid-macro.json'),'utf8'));
  aMid = aMid || {
    label: midFile.constraint?.label,
    equity_constraint: midFile.constraint?.equity_constraint,
    headwind_level: midFile.constraint?.headwind_level,
    allow_chase: midFile.constraint?.allow_chase,
  };
} catch {}
const aMidLabel = aMid?.label || '中性';
const aMidConstraint = aMid?.equity_constraint || '按关键位正常执行';
const aActions = [...garden.harvest.slice(0,2),...garden.plant.slice(0,2)].slice(0,3);
const usPriority = ['exit','harvest','ready_harvest','plant','ready_plant'];
const usActions = usPriority.flatMap(key => us.flower_signals[key] || []).slice(0,3);
const usFormalCount = ['exit','harvest','plant'].reduce((n,key)=>n+(us.flower_signals[key]?.length||0),0);
const usReadyCount = ['ready_harvest','ready_plant'].reduce((n,key)=>n+(us.flower_signals[key]?.length||0),0);
const macroIcon = macro.risk.key === 'danger' ? '🔴' : macro.risk.key === 'tight' ? '🟠' : macro.risk.key === 'slightly-tight' ? '🟡' : '🟢';
const number = (v?:number) => typeof v === 'number' && Number.isFinite(v) ? v.toFixed(v >= 100 ? 2 : 3).replace(/0+$/,'').replace(/\.$/,'') : 'N/A';
const distance = (v?:number) => typeof v === 'number' && Number.isFinite(v) ? `${v>0?'+':''}${v.toFixed(1)}%` : 'N/A';
const aTone = (status:string) => isTakeProfitSide(status) || status.includes('撤退') ? 'sell' : 'buy';
const usLabel = (item:UsAction) => item.signal || item.trade_state;
const usTone = (item:UsAction) => isTakeProfitSide(usLabel(item)) || usLabel(item).includes('撤退') || usLabel(item).includes('退出') ? 'sell' : 'buy';
const actionLevel = (item:AAction) => item.action_level ?? (isTakeProfitSide(item.status) ? item.target : item.support);
// Decision date = trade plan day. Quote date = latest action snapshot (intraday/close),
// not the qfq key-level baseline (level_data_as_of), which often lags one session.
const aQuoteDates = [...garden.harvest, ...garden.plant]
  .map((item) => item.price_date)
  .filter((value): value is string => Boolean(value));
const aQuoteDate = aQuoteDates.sort().at(-1) || garden.date || garden.level_data_as_of || '待更新';
const aUpdatedShort = (garden.updated_at || '').replace('T', ' ').replace(' CST', '').slice(0, 16) || '待更新';
const usUpdatedShort = (us.updated_at || '').replace('T', ' ').replace(' CST', '').slice(0, 16) || us.date || '待更新';
const aStage = (garden as any).stage || '';
const actionStateLabel = (raw: string) => publicHomeCopy(raw)
  .replace('止盈观察', '接近止盈条件')
  .replace('观察', '等待价格确认');
const actionLevelLabel = (item:AAction) => publicHomeCopy(
  item.action_level_label
  ?? (isTakeProfitSide(item.status) ? '止盈参考价' : '计划关注价'),
);
const aHeroTakeaway = garden.harvest.length
  ? `A股有${garden.harvest.length}项止盈观察，${garden.plant.length}只候选等待价格确认。`
  : `A股当前没有止盈动作，${garden.plant.length}只候选等待价格确认。`;
const usHeroTakeaway = `${us.market_regime.state}，参考权益${us.market_regime.equity_allocation}，当前${usFormalCount}项正式动作。`;

const clipText = (raw: string, max = 48) => {
  const text = String(raw || '').replace(/\s+/g, ' ').trim();
  if (!text) return '—';
  return text.length <= max ? text : `${text.slice(0, Math.max(1, max - 1))}…`;
};
const firstClauses = (raw: string, maxClauses = 2) => String(raw || '')
  .split(/[；;]/)
  .map((item) => item.trim())
  .filter(Boolean)
  .slice(0, maxClauses)
  .join('；');
const extractActionLine = (raw: string) => {
  const text = publicHomeCopy(raw).trim().replace(/['"`]+/g, '');
  if (!text) return '';
  const stripStage = (value: string) => value
    .replace(/^(08:30|11:30|14:30|22:00)夜间?(最终版|最终收盘)?[：:]?/, '')
    .replace(/^结论[：:]/, '')
    .trim();
  const afterConclusion = text.match(/结论[：:]\s*([^。]+)/)?.[1]?.trim();
  if (afterConclusion) return firstClauses(stripStage(afterConclusion), 1);
  // Prefer decisive ops lines over trailing defense-detail lines.
  const ranked = [
    /不追高|不开新|停开进攻|正式伏击0/,
    /按失效线|按防守线|只回踩|空仓|候场|撤退/,
    /保留底仓|防御底仓/,
  ];
  const parts = text.split(/[。；;]/).map((item) => item.trim()).filter(Boolean);
  for (const rule of ranked) {
    const hit = parts.find((part) => rule.test(part));
    if (hit) return firstClauses(stripStage(hit), 1);
  }
  return firstClauses(stripStage(parts[parts.length - 1] || text), 1);
};
const compactHomeMarketState = (raw: string) => {
  const text = publicHomeCopy(raw).trim().replace(/['"`]+/g, '');
  if (!text) return '待更新';
  if (text.length <= 28) return text;
  const stageMatch = text.match(/^(08:30|11:30|14:30|22:00)/);
  const stage = stageMatch
    ? `${stageMatch[1]}${text.includes('夜间') ? '夜间' : ''}`
    : (aStage || '').replace(/最终版|最终收盘/g, '').trim();
  const action = extractActionLine(text)
    .replace(/交易计划全天0触发、0执行[^；。]*/g, '当前没有触发交易信号')
    .replace(/Plan1/gi, '交易计划')
    .replace(/相对14:30尾盘，?/, '')
    .replace(/已买入头寸按(失效|防守)线持有[；,]?/g, '')
    .replace(/517520黄金股保留底仓[^；]*/g, '')
    .replace(/尾盘15:00后兑现窗口已关闭[；,]?/g, '')
    .replace(/防御底仓继续/g, '')
    .replace(/[；;]+$/g, '')
    .trim();
  const shortAction = firstClauses(action, 1);
  return clipText([stage, shortAction].filter(Boolean).join('｜'), 28);
};
const compactHomeSummary = (raw: string) => {
  const text = publicHomeCopy(raw).trim();
  if (!text) return '等待更新';
  if (text.length <= 56) return text;
  const action = extractActionLine(text)
    .replace(/相对14:30尾盘，?/, '')
    .replace(/防御底仓\d{6}[^；]*/g, '')
    .replace(/[；;]+$/g, '')
    .trim();
  const formal = text.match(/正式伏击\d+项/)?.[0] || '';
  const breadth = text.match(/上涨面[\d.]+%/)?.[0]
    || text.match(/\d{3,5}涨\/\d{2,5}跌/)?.[0]
    || '';
  const bits = [];
  if (action && action !== formal) bits.push(firstClauses(action, 1));
  if (formal && !bits.some((item) => item.includes(formal))) bits.push(formal);
  if (breadth) bits.push(breadth);
  return clipText(`${bits.join('；')}。`, 48);
};
const compactHomeMainline = (raw: string) => {
  const text = publicHomeCopy(raw).trim();
  if (!text) return '—';
  if (text.length <= 28) return text;
  const themes = Array.from(
    text.matchAll(/(通信|电网|稀土|电池|创新药|医疗|半导体|设备|黄金股|有色|化工|科创50|煤炭|银行|红利|恒生科技)/g),
  ).map((match) => match[1]);
  const uniq = [...new Set(themes)].slice(0, 3);
  const parts = text.split(/[。；;]/).map((item) => item.trim()).filter(Boolean);
  const action = parts.find((part) => /不追高|不开新|停开进攻/.test(part))
    || parts.find((part) => /正式伏击0|只回踩|空仓|候场|撤退|按失效线|按防守线/.test(part))
    || extractActionLine(text);
  const cleanAction = firstClauses(
    String(action || '')
      .replace(/^(08:30|11:30|14:30|22:00)夜间?(最终版|最终收盘)?[：:]?/, '')
      .replace(/^结论[：:]/, '')
      .trim(),
    1,
  );
  if (uniq.length) return clipText(`${uniq.join('/')}｜${cleanAction}`, 28);
  return clipText(cleanAction || text, 28);
};
const compactHomePosition = (raw: string) => publicHomeCopy(raw).split(/[；;]/).map((item) => item.trim()).filter(Boolean)[0] || '—';
const compactHomeConstraint = (raw: string) => publicHomeCopy(raw)
  .replace(/^中观[^：:]*[：:]?/, '')
  .replace(/[，,]/g, '｜')
  .replace('只回踩不追高', '只回踩')
  .trim() || '按关键位正常执行';
const compactHomeActionCopy = (raw: string) => {
  const text = publicHomeCopy(raw).trim();
  if (!text) return '—';
  if (text.length <= 40) return text;
  return clipText(firstClauses(text, 1), 40);
};
const aMarketStatePublic = publicHomeCopy(garden.market_state);
const aSummaryPublic = publicHomeCopy(garden.summary);
const aMainlinePublic = publicHomeCopy(garden.mainline);
const aMidConstraintPublic = publicHomeCopy(aMidConstraint);
const usSummaryPublic = publicHomeCopy(us.summary);
const aMarketStateShort = compactHomeMarketState(aMarketStatePublic);
const aSummaryShort = compactHomeSummary(aSummaryPublic);
const aMainlineShort = compactHomeMainline(aMainlinePublic);
const aPositionShort = compactHomePosition(garden.position);
const aMidConstraintShort = compactHomeConstraint(aMidConstraintPublic);
const usSummaryShort = compactHomeSummary(usSummaryPublic);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description="ETF罗盘最新ETF行动清单：集中展示A股与美股的市场结论、仓位参考、趋势条件和优先关注标的。" />
    <style>
      main{width: var(--shell-width);padding:1rem 0 3rem}
      .dashboard-head{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;padding:.7rem 0 1rem;border-bottom:1px solid var(--border)}
      .dashboard-head h1{margin:.25rem 0;font-size:clamp(1.8rem,4.5vw,2.75rem)}
      .dashboard-head p{margin:0;color:rgb(var(--gray));max-width:620px;line-height:1.55}
      .takeaway{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin-top:.85rem}
      .takeaway-item{padding:.7rem .8rem;border:1px solid var(--border);border-radius:12px;background:#fff}
      .takeaway-item strong{display:block;font-size:.7rem;color:rgb(var(--gray));margin-bottom:.2rem}
      .takeaway-item span{display:block;font-size:.84rem;font-weight:800;line-height:1.45}
      .dates{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.32rem;max-width:390px}
      .dates span{padding:.34rem .55rem;border:1px solid var(--border);border-radius:9px;background:#fff;font-size:.7rem;white-space:nowrap;color:rgb(var(--gray))}
      .markets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem;margin-top:.9rem;isolation:isolate}
      .market{padding:1rem;overflow:hidden;display:flex;flex-direction:column}
      .market.a{border-top:5px solid var(--accent)}
      .market.us{border-top:5px solid #1b67b2;background:linear-gradient(180deg,#f7fbff 0,#fff 20%)}
      .market-top{display:flex;justify-content:space-between;align-items:flex-start;gap:.75rem}
      .market-title{display:flex;gap:.55rem;align-items:center}
      .market-title h2{margin:0;font-size:1.35rem}
      .market-date{text-align:right;color:rgb(var(--gray));font-size:.7rem}
      .market-date strong{display:block;font-size:.8rem}
      .verdict{margin:.75rem 0;padding:.8rem;border-radius:13px;background:var(--warm-2);border:1px solid var(--border)}
      .verdict-head{display:flex;justify-content:space-between;gap:.7rem;align-items:flex-start}
      .verdict h3{margin:0;font-size:1.02rem;line-height:1.35;max-width:min(72%,26rem)}
      .verdict-copy{margin:.42rem 0 0;color:rgb(var(--gray));font-size:.82rem;line-height:1.5}
      .verdict details{margin-top:.4rem}
      .verdict summary{cursor:pointer;color:rgb(var(--gray-dark));font-size:.72rem;font-weight:800;list-style:none}
      .verdict summary::-webkit-details-marker{display:none}
      .verdict-full{margin:.45rem 0 0;color:rgb(var(--gray));font-size:.78rem;line-height:1.55}
      .allocation{font-weight:850;font-size:.76rem;padding:.25rem .55rem;border-radius:999px;background:#fff;border:1px solid var(--border);max-width:min(42%,180px);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:0 0 auto}
      .metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.42rem;margin:.7rem 0}
      .metric{padding:.62rem .7rem;background:#fff;border:1px solid var(--border);border-radius:10px;min-width:0}
      .metric span{display:block;font-size:.65rem;color:rgb(var(--gray));font-weight:750}
      .metric strong{display:block;margin-top:.18rem;font-size:.84rem;line-height:1.35;overflow-wrap:anywhere}
      .metric.wide{grid-column:span 2}
      .metric.wide strong{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
      .actions-head{display:flex;justify-content:space-between;align-items:center;margin:.9rem 0 .48rem}
      .actions-head h3{margin:0;font-size:1rem}
      .actions-head small{color:rgb(var(--gray))}
      .action-list{display:grid;gap:.62rem;flex:1}
      .action{padding:.78rem;border:1px solid var(--border);border-radius:12px;background:#fff}
      .action.sell,.action.exit{border-left:4px solid var(--action-sell)}
      .action.buy{border-left:4px solid var(--action-buy)}
      .action-top{display:flex;justify-content:space-between;gap:.55rem;align-items:flex-start}
      .identity{min-width:0}
      .identity strong{display:block;font-size:.88rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .identity small{display:block;color:rgb(var(--gray));font-size:.68rem}
      .state{padding:.18rem .46rem;border-radius:999px;font-size:.66rem;font-weight:850;white-space:nowrap}
      .sell .state{background:var(--green-soft);color:var(--green)}
      .buy .state{background:var(--accent-soft);color:var(--accent-dark)}
      .exit .state{background:var(--green-soft);color:var(--action-sell)}
      .levels{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.3rem;margin-top:.55rem}
      .level{padding:.48rem .3rem;text-align:center;background:var(--warm-2);border-radius:8px;min-width:0}
      .level.active{background:#eef6ff}
      .action.sell .level.active{background:var(--green-soft)}
      .action.buy .level.active{background:var(--accent-soft)}
      .level span{display:block;color:rgb(var(--gray));font-size:.59rem;white-space:nowrap}
      .level strong{display:block;margin-top:.08rem;font-size:.74rem;overflow:hidden;text-overflow:ellipsis}
      .action-copy{margin:.5rem 0 0;color:rgb(var(--gray));font-size:.74rem;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
      .market-links{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.85rem;padding-top:.75rem;border-top:1px solid var(--border)}
      .market-links a{flex:1 1 30%;min-height:44px;display:inline-flex;align-items:center;justify-content:center;text-align:center;padding:.5rem .55rem;border:1px solid var(--border);border-radius:9px;background:var(--warm-2);color:rgb(var(--gray-dark));font-size:.72rem;font-weight:850;text-decoration:none;white-space:nowrap}
      .market-links a.primary{color:#fff;background:var(--accent-dark);border-color:var(--accent-dark)}
      @media(max-width:960px){.markets{grid-template-columns:1fr}.dashboard-head{align-items:flex-start}.dates{justify-content:flex-start}}
      @media(max-width:620px){
        main{width: var(--shell-width);padding-top:.55rem}
        .dashboard-head{display:block}
        .dashboard-head p{font-size:.82rem}
        .takeaway{gap:.38rem;margin-top:.65rem}
        .takeaway-item{padding:.55rem .6rem}
        .dates{margin-top:.55rem;gap:.25rem}
        .dates span{padding:.28rem .45rem;font-size:.66rem;white-space:normal}
        .market{padding:.8rem}
        .metrics{grid-template-columns:1fr 1fr}
        .levels{grid-template-columns:repeat(2,minmax(0,1fr))}
        .market-links a{flex:1 1 42%}
        .allocation{max-width:100%}
      }
    </style>
  </head>
  <body class="home-page">
    <Header />
    <main id="main-content" tabindex="-1">
      <header class="dashboard-head">
        <div>
          <span class="pill">最新双市场</span>
          <h1>最新ETF行动清单</h1>
          <p>一眼看清A股与美股最近交易日关注什么、等待什么、如何控制仓位。</p>
          <div class="takeaway" aria-label="最新重点">
            <div class="takeaway-item"><strong>最新重点 · A股</strong><span>{aHeroTakeaway}</span></div>
            <div class="takeaway-item"><strong>最新重点 · 美股</strong><span>{usHeroTakeaway}</span></div>
          </div>
        </div>
        <div class="dates">
          <span id="home-live-status">双市场日历连接中</span>
          <span>A股更新 {aUpdatedShort}</span>
          <span>美股更新 {usUpdatedShort}</span>
        </div>
      </header>

      <section class="markets" aria-label="最新ETF行动清单">
        <article class="market a card">
          <div class="market-top">
            <div class="market-title"><span class="pill pill-red">🇨🇳 A股</span><h2>最新行动</h2></div>
            <div class="market-date"><strong>行情 {aQuoteDate}</strong>更新于 {aUpdatedShort.slice(11)}</div>
          </div>
          <div class="verdict">
            <div class="verdict-head">
              <h3 title={aMarketStatePublic}>{aMarketStateShort}</h3>
              <span class="allocation" title={`仓位 ${publicHomeCopy(garden.position)}`}>仓位 {aPositionShort}</span>
            </div>
            <p class="verdict-copy" title={aSummaryPublic}>{aSummaryShort}</p>
            <details>
              <summary>展开完整结论</summary>
              <p class="verdict-full">{aSummaryPublic}</p>
            </details>
          </div>
          <div class="metrics">
            <div class="metric"><span>接近止盈条件</span><strong>{garden.harvest.length}只</strong></div>
            <div class="metric"><span>等待价格确认</span><strong>{garden.plant.length}只</strong></div>
            <div class="metric"><span>趋势达标</span><strong>{aPool.summary.momentum_pass_count}/{aPool.summary.universe_count}只</strong></div>
            <div class="metric"><span>行业环境</span><strong>{aMidLabel}</strong></div>
            <div class="metric wide"><span>当前主线</span><strong title={aMainlinePublic}>{aMainlineShort}</strong></div>
            <div class="metric wide"><span>行业风险条件</span><strong title={aMidConstraintPublic}>{aMidConstraintShort}</strong></div>
          </div>
          <div class="actions-head"><h3>优先关注</h3><small>{aActions.length}项 · {aQuoteDate} 行情</small></div>
          <div class="action-list">
            {aActions.map(item => (
              <div class={`action ${aTone(item.status)}`} data-code={item.code}>
                <div class="action-top">
                  <div class="identity">
                    <strong>{item.code} · {item.name}</strong>
                    <small>风险 {item.risk_level||'N/A'} · 行情 {item.price_date||aQuoteDate}</small>
                  </div>
                  <span class="state">{actionStateLabel(item.status)}</span>
                </div>
                <div class="levels">
                  <div class="level"><span>现价</span><strong id={`home-live-price-${item.code}`}>{number(item.price)}</strong><span id={`home-live-change-${item.code}`} style="font-size:0.65rem; font-weight:700;"></span></div>
                  <div class="level active"><span>{actionLevelLabel(item)}</span><strong>{number(actionLevel(item))}</strong></div>
                  <div class="level"><span>风险退出价</span><strong>{number(item.stop)}</strong></div>
                  <div class="level"><span>距关注价</span><strong>{distance(item.distance_pct)}</strong></div>
                </div>
                <p class="action-copy" title={publicHomeCopy(item.action)}>{compactHomeActionCopy(item.action)}</p>
              </div>
            ))}
          </div>
          <nav class="market-links" aria-label="A股功能">
            <a class="primary" href="/a-compass/">查看最新行动清单</a>
            <a href="/a-momentum/">查看趋势依据</a>
            <a href="/a-macro/">查看宏观环境</a>
            <a href="/blog/">查看盘后复盘</a>
          </nav>
        </article>

        <article class="market us card">
          <div class="market-top">
            <div class="market-title"><span class="pill" style="background:#eaf3ff;color:#174ea6">🇺🇸 美股</span><h2>最新行动</h2></div>
            <div class="market-date"><strong>行情 {us.date}</strong>{macroIcon} {macro.risk.label}</div>
          </div>
          <div class="verdict">
            <div class="verdict-head"><h3>{us.market_regime.state}</h3><span class="allocation" title={`权益 ${us.market_regime.equity_allocation}`}>权益 {us.market_regime.equity_allocation}</span></div>
            <p class="verdict-copy" title={usSummaryPublic}>{usSummaryShort}</p>
            <details>
              <summary>展开完整结论</summary>
              <p class="verdict-full">{usSummaryPublic}</p>
            </details>
          </div>
          <div class="metrics">
            <div class="metric"><span>最新需处理</span><strong>{usFormalCount}项</strong></div>
            <div class="metric"><span>等待价格确认</span><strong>{usReadyCount}项</strong></div>
            <div class="metric"><span>趋势达标</span><strong>{usPool.summary.momentum_pass}/{usPool.summary.universe}只</strong></div>
            <div class="metric"><span>宏观风险</span><strong>{macro.risk.label}</strong></div>
            <div class="metric wide"><span>仓位结论</span><strong>{publicHomeCopy(macro.risk.equity_constraint)}</strong></div>
            <div class="metric wide"><span>宏观信号</span><strong>{publicHomeCopy(macro.risk.headline)}</strong></div>
          </div>
          <div class="actions-head"><h3>优先关注</h3><small>{usActions.length}项 · 风险优先</small></div>
          <div class="action-list">
            {usActions.map(item => (
              <div class={`action ${usTone(item)}`} data-us-home-symbol={item.symbol}>
                <div class="action-top">
                  <div class="identity">
                    <strong>{item.symbol} · {item.name}</strong>
                    <small>风险 {item.risk_level} · 行情 {item.trade_date}</small>
                  </div>
                  <span class="state">{actionStateLabel(usLabel(item))}</span>
                </div>
                <div class="levels">
                  <div class="level"><span>现价</span><strong id={`home-us-live-price-${item.symbol}`}>${number(item.price)}</strong><span id={`home-us-live-change-${item.symbol}`} style="font-size:0.65rem; font-weight:700;"></span></div>
                  <div class="level active"><span>{isTakeProfitSide(usLabel(item)) ? '止盈参考价' : '计划关注价'}</span><strong>${number(isTakeProfitSide(usLabel(item)) ? item.target : item.support)}</strong></div>
                  <div class="level"><span>风险退出价</span><strong>${number(item.stop)}</strong></div>
                  <div class="level"><span>距关注价</span><strong>{distance(isTakeProfitSide(usLabel(item)) ? item.target_gap : item.support_gap)}</strong></div>
                </div>
                <p class="action-copy" title={publicHomeCopy(item.trade_state)}>{compactHomeActionCopy(item.trade_state)}</p>
              </div>
            ))}
          </div>
          <nav class="market-links" aria-label="美股功能">
            <a class="primary" href="/us-compass/">查看最新行动清单</a>
            <a href="/us-momentum/">查看趋势依据</a>
            <a href="/us-macro/">查看宏观环境</a>
          </nav>
        </article>
      </section>
    </main>
    <Footer />
    <QuoteLiveScripts />
    <script is:inline src="/js/home-live-app.js"></script>
  </body>
</html>
