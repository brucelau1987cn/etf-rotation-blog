---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const title = `订阅登录 | ${SITE_TITLE}`;
const description = '本站采用订阅制。使用订阅密码或账号密码登录；开通与续期请联系 189188XX888。';
const contactPhone = '189188XX888';
---
<BaseHead title={title} description={description} />
<body class="login-body">
  <Header />
  <main class="login-main site-shell">
    <section class="login-panel" aria-label="订阅登录">
      <div class="login-hero">
        <p class="login-eyebrow">ETF 罗盘 · 订阅访问</p>
        <h1>登录解锁完整内容</h1>
        <p class="login-desc">
          本站采用订阅制。使用<strong>订阅密码</strong>或<strong>账号密码</strong>登录后即可访问完整内容。
        </p>
        <ul class="login-points">
          <li>订阅密码一键解锁</li>
          <li>账号密码支持订阅用户与管理员</li>
          <li>同一订阅最多绑定 5 台设备</li>
        </ul>
        <div class="login-contact">
          <span class="login-contact-label">开通 / 续期</span>
          <span class="login-contact-phone">{contactPhone}</span>
          <span class="login-contact-note">请联系管理员开通账号或续期订阅</span>
        </div>
      </div>

      <div class="login-card">
        <div class="login-tabs" role="tablist" aria-label="登录方式">
          <button type="button" class="login-tab active" id="tab-passphrase" role="tab" aria-selected="true">订阅密码</button>
          <button type="button" class="login-tab" id="tab-account" role="tab" aria-selected="false">账号密码</button>
        </div>

        <form id="login-form-pass" class="login-form" novalidate>
          <label for="passphrase">订阅密码</label>
          <input
            id="passphrase"
            name="passphrase"
            type="password"
            autocomplete="current-password"
            placeholder="请输入订阅密码"
            required
          />
          <button type="submit" id="login-btn-pass">解锁访问 →</button>
          <p class="login-msg" id="login-msg-pass" role="status"></p>
        </form>

        <form id="login-form-account" class="login-form" hidden novalidate>
          <label for="account-username">用户名</label>
          <input
            id="account-username"
            name="username"
            type="text"
            autocomplete="username"
            placeholder="订阅用户名或管理员账号"
          />
          <label for="account-password">密码</label>
          <input
            id="account-password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="账号密码"
          />
          <button type="submit" id="login-btn-account">解锁访问 →</button>
          <p class="login-msg" id="login-msg-account" role="status"></p>
        </form>

        <p class="login-foot">设备数达上限时，请联系管理员解绑后再登录。</p>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const params = new URLSearchParams(location.search);
      const next = params.get('next') || '/';

      // 设备指纹：localStorage 持久（换浏览器/清除缓存才变），登录时上报
      let deviceId = localStorage.getItem('etf_device_id');
      if (!deviceId) {
        deviceId = 'dev-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
        localStorage.setItem('etf_device_id', deviceId);
      }

      const tabPass = $('tab-passphrase');
      const tabAccount = $('tab-account');
      const formPass = $('login-form-pass');
      const formAccount = $('login-form-account');

      function switchTab(which) {
        const isPass = which === 'pass';
        tabPass.classList.toggle('active', isPass);
        tabAccount.classList.toggle('active', !isPass);
        tabPass.setAttribute('aria-selected', String(isPass));
        tabAccount.setAttribute('aria-selected', String(!isPass));
        formPass.hidden = !isPass;
        formAccount.hidden = isPass;
      }
      tabPass.addEventListener('click', () => switchTab('pass'));
      tabAccount.addEventListener('click', () => switchTab('account'));

      async function doLogin(endpoint, body, msgEl, btn) {
        btn.disabled = true;
        btn.textContent = '验证中…';
        msgEl.textContent = '';
        msgEl.className = 'login-msg';
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...body, device_id: deviceId }),
          });
          const data = await res.json();
          if (res.ok && data.ok) {
            msgEl.textContent = data.kind === 'admin'
              ? `✔ 管理员登录成功（${data.role === 'super_admin' ? '超级管理员' : '管理员'}），进入管理后台…`
              : `✔ 验证成功，订阅至 ${data.expires_at ? String(data.expires_at).slice(0, 10) : ''}${data.device_count ? ` · 已绑定 ${data.device_count}/5 台设备` : ''}`;
            msgEl.className = 'login-msg ok';
            setTimeout(() => {
              location.href = data.kind === 'admin' ? '/admin/' : next;
            }, 600);
          } else {
            msgEl.textContent = data.error || '登录失败';
            msgEl.className = 'login-msg error';
          }
        } catch (err) {
          msgEl.textContent = '网络错误，请重试';
          msgEl.className = 'login-msg error';
        } finally {
          btn.disabled = false;
          btn.textContent = '解锁访问 →';
        }
      }

      formPass.addEventListener('submit', (e) => {
        e.preventDefault();
        const passphrase = $('passphrase').value.trim();
        if (!passphrase) {
          $('login-msg-pass').textContent = '请输入密码';
          $('login-msg-pass').className = 'login-msg error';
          return;
        }
        doLogin('/api/public/v1/subscription/login', { passphrase }, $('login-msg-pass'), $('login-btn-pass'));
      });

      formAccount.addEventListener('submit', (e) => {
        e.preventDefault();
        const username = $('account-username').value.trim();
        const password = $('account-password').value;
        if (!username || !password) {
          $('login-msg-account').textContent = '请输入用户名和密码';
          $('login-msg-account').className = 'login-msg error';
          return;
        }
        doLogin('/api/public/v1/login-account', { username, password, remember: true }, $('login-msg-account'), $('login-btn-account'));
      });
    })();
  </script>
</body>

<style is:global>
  .login-body {
    min-height: 100vh;
    background:
      radial-gradient(1200px 420px at 12% -10%, rgba(37, 99, 235, .12), transparent 60%),
      radial-gradient(900px 360px at 90% 0%, rgba(14, 165, 233, .10), transparent 55%),
      #f6f8fc;
  }
  .login-main {
    display: flex;
    justify-content: center;
    padding: 2.4rem 1rem 4rem;
  }
  .login-panel {
    width: min(920px, 100%);
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 1.1rem;
    align-items: stretch;
  }
  .login-hero,
  .login-card {
    border: 1px solid #e6ebf2;
    border-radius: 22px;
    background: rgba(255, 255, 255, .92);
    box-shadow: 0 16px 40px rgba(15, 23, 42, .06);
  }
  .login-hero {
    padding: 2rem 1.8rem;
    background:
      linear-gradient(160deg, rgba(30, 58, 138, .96), rgba(37, 99, 235, .92) 55%, rgba(14, 165, 233, .88));
    color: #fff;
  }
  .login-eyebrow {
    margin: 0 0 .7rem;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #bfdbfe; /* blue-200：标签层，比纯白更轻 */
  }
  .login-hero h1 {
    margin: 0 0 .85rem;
    font-size: clamp(1.55rem, 2.4vw, 1.9rem);
    line-height: 1.25;
    letter-spacing: -.02em;
    color: #ffffff;
    text-shadow: 0 1px 0 rgba(15, 23, 42, .12);
  }
  .login-desc {
    margin: 0 0 1.1rem;
    font-size: .92rem;
    line-height: 1.7;
    color: #dbeafe; /* blue-100：说明层，降低与标题抢视觉 */
  }
  .login-desc strong {
    color: #ffffff;
    font-weight: 850;
  }
  .login-points {
    margin: 0 0 1.3rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: .55rem;
  }
  .login-points li {
    position: relative;
    padding-left: 1.15rem;
    font-size: .86rem;
    line-height: 1.5;
    color: #e0f2fe; /* sky-100：列表略亮于说明，仍低于标题 */
  }
  .login-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .45rem;
    width: .5rem;
    height: .5rem;
    border-radius: 999px;
    background: #93c5fd;
    box-shadow: 0 0 0 3px rgba(147, 197, 253, .22);
  }
  .login-contact {
    display: grid;
    gap: .25rem;
    padding: .95rem 1rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, .12);
    border: 1px solid rgba(255, 255, 255, .16);
  }
  .login-contact-label {
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #bfdbfe;
  }
  .login-contact-phone {
    color: #fde68a; /* amber-200：行动色，电话一眼可见 */
    font-size: 1.18rem;
    font-weight: 900;
    letter-spacing: .02em;
  }
  .login-contact-note {
    font-size: .78rem;
    color: #dbeafe;
  }

  .login-card {
    padding: 1.7rem 1.55rem 1.45rem;
  }
  .login-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .35rem;
    margin-bottom: 1.15rem;
    padding: .28rem;
    border-radius: 14px;
    background: #f1f5f9;
  }
  .login-tab {
    padding: .62rem .5rem;
    border: 0;
    border-radius: 11px;
    background: transparent;
    color: #64748b;
    font-size: .88rem;
    font-weight: 850;
    cursor: pointer;
  }
  .login-tab.active {
    background: #fff;
    color: #1e3a8a;
    box-shadow: 0 4px 14px rgba(15, 23, 42, .08);
  }
  .login-form label {
    display: block;
    margin: 0 0 .4rem;
    font-size: .78rem;
    font-weight: 800;
    color: #334155;
  }
  .login-form input {
    width: 100%;
    box-sizing: border-box;
    margin-bottom: .9rem;
    padding: .78rem .95rem;
    border: 1px solid #dbe3ee;
    border-radius: 12px;
    background: #fff;
    font-size: 1rem;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
  }
  .login-form input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
  }
  .login-form button {
    width: 100%;
    margin-top: .15rem;
    padding: .82rem 1rem;
    border: 0;
    border-radius: 12px;
    background: linear-gradient(135deg, #1e3a8a, #2563eb);
    color: #fff;
    font-size: .95rem;
    font-weight: 850;
    cursor: pointer;
    box-shadow: 0 10px 22px rgba(37, 99, 235, .22);
  }
  .login-form button:hover {
    filter: brightness(1.03);
  }
  .login-form button:disabled {
    opacity: .65;
    cursor: wait;
  }
  .login-msg {
    min-height: 1.2em;
    margin: .9rem 0 0;
    font-size: .82rem;
    line-height: 1.5;
  }
  .login-msg.ok { color: #0aa869; }
  .login-msg.error { color: #e04444; }
  .login-foot {
    margin: 1.15rem 0 0;
    text-align: center;
    font-size: .72rem;
    color: #94a3b8;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .login-main { padding-top: 1.4rem; }
    .login-panel { grid-template-columns: 1fr; }
    .login-hero { order: 0; padding: 1.45rem 1.2rem; }
    .login-card { order: 1; padding: 1.3rem 1.15rem 1.15rem; }
    .login-hero h1 { font-size: 1.45rem; }
    .login-points { margin-bottom: 1rem; }
  }
</style>
