---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const title = `订阅登录 | ${SITE_TITLE}`;
const description = '输入订阅密码或用户名密码访问 ETF 罗盘。';
---
<BaseHead title={title} description={description} />
<body class="login-body">
  <Header />
  <main class="login-main site-shell">
    <div class="login-card">
      <p class="login-eyebrow">ETF 罗盘 · 订阅访问</p>
      <h1>登录解锁</h1>
      <p class="login-desc">本站为订阅制访问。订阅密码、订阅账号、管理员账号都在此登录：管理员登录后自动进入管理后台。订阅到期后需续订。</p>

      <div class="login-tabs" role="tablist">
        <button type="button" class="login-tab active" id="tab-passphrase" role="tab" aria-selected="true">订阅密码</button>
        <button type="button" class="login-tab" id="tab-account" role="tab" aria-selected="false">用户名密码</button>
      </div>

      <!-- 方式一：订阅密码 -->
      <form id="login-form-pass" class="login-form" novalidate>
        <label for="passphrase">订阅密码</label>
        <input id="passphrase" name="passphrase" type="password" autocomplete="current-password"
               placeholder="输入订阅密码" required />
        <button type="submit" id="login-btn-pass">解锁访问 →</button>
        <p class="login-msg" id="login-msg-pass" role="status"></p>
      </form>

      <!-- 方式二：用户名密码 -->
      <form id="login-form-account" class="login-form" hidden novalidate>
        <label for="account-username">用户名</label>
        <input id="account-username" name="username" type="text" autocomplete="username"
               placeholder="订阅用户名" />
        <label for="account-password">密码</label>
        <input id="account-password" name="password" type="password" autocomplete="current-password"
               placeholder="账号密码" />
        <button type="submit" id="login-btn-account">解锁访问 →</button>
        <p class="login-msg" id="login-msg-account" role="status"></p>
      </form>

      <p class="login-foot">同一订阅最多 5 台设备；设备数达上限时请联系管理员解绑。</p>
    </div>
  </main>
  <Footer />

  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const params = new URLSearchParams(location.search);
      const next = params.get('next') || '/';

      // 设备指纹：localStorage 持久（换浏览器/清除缓存才变），登录时上报
      let deviceId = localStorage.getItem('etf_device_id');
      if (!deviceId) {
        deviceId = 'dev-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
        localStorage.setItem('etf_device_id', deviceId);
      }

      // Tab 切换
      const tabPass = $('tab-passphrase'), tabAccount = $('tab-account');
      const formPass = $('login-form-pass'), formAccount = $('login-form-account');
      function switchTab(which) {
        const isPass = which === 'pass';
        tabPass.classList.toggle('active', isPass);
        tabAccount.classList.toggle('active', !isPass);
        tabPass.setAttribute('aria-selected', String(isPass));
        tabAccount.setAttribute('aria-selected', String(!isPass));
        formPass.hidden = !isPass;
        formAccount.hidden = isPass;
      }
      tabPass.addEventListener('click', () => switchTab('pass'));
      tabAccount.addEventListener('click', () => switchTab('account'));

      async function doLogin(endpoint, body, msgEl, btn) {
        btn.disabled = true;
        btn.textContent = '验证中…';
        msgEl.textContent = ''; msgEl.className = 'login-msg';
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...body, device_id: deviceId }),
          });
          const data = await res.json();
          if (res.ok && data.ok) {
            msgEl.textContent = data.kind === 'admin'
              ? `✔ 管理员登录成功（${data.role === 'super_admin' ? '超级管理员' : '管理员'}），进入管理后台…`
              : `✔ 验证成功，订阅至 ${data.expires_at ? String(data.expires_at).slice(0, 10) : ''}${data.device_count ? ` · 已绑定 ${data.device_count}/5 台设备` : ''}`;
            msgEl.className = 'login-msg ok';
            setTimeout(() => {
              location.href = data.kind === 'admin' ? '/admin/' : next;
            }, 600);
          } else {
            msgEl.textContent = data.error || '登录失败';
            msgEl.className = 'login-msg error';
          }
        } catch (err) {
          msgEl.textContent = '网络错误，请重试';
          msgEl.className = 'login-msg error';
        } finally {
          btn.disabled = false;
          btn.textContent = '解锁访问 →';
        }
      }

      $('login-form-pass').addEventListener('submit', (e) => {
        e.preventDefault();
        const passphrase = $('passphrase').value.trim();
        if (!passphrase) { $('login-msg-pass').textContent = '请输入密码'; $('login-msg-pass').className = 'login-msg error'; return; }
        doLogin('/api/public/v1/subscription/login', { passphrase }, $('login-msg-pass'), $('login-btn-pass'));
      });

      $('login-form-account').addEventListener('submit', (e) => {
        e.preventDefault();
        const username = $('account-username').value.trim();
        const password = $('account-password').value;
        if (!username || !password) { $('login-msg-account').textContent = '请输入用户名和密码'; $('login-msg-account').className = 'login-msg error'; return; }
        doLogin('/api/public/v1/login-account', { username, password, remember: true }, $('login-msg-account'), $('login-btn-account'));
      });
    })();
  </script>
</body>

<style>
  .login-main { display: flex; justify-content: center; padding: 3rem 1rem 4rem; }
  .login-card {
    width: 100%; max-width: 440px;
    border: 1px solid var(--border); border-radius: 16px;
    background: #fff; padding: 2.2rem 2rem;
    box-shadow: 0 8px 30px rgba(30, 41, 59, .06);
  }
  .login-eyebrow { font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: rgb(var(--gray-mid)); margin: 0 0 .5rem; }
  .login-card h1 { font-size: 1.5rem; margin: 0 0 .6rem; }
  .login-desc { font-size: .85rem; color: rgb(var(--gray-mid)); line-height: 1.6; margin: 0 0 1.4rem; }

  .login-tabs { display: flex; gap: .4rem; margin-bottom: 1.2rem; border-bottom: 1px solid var(--border); }
  .login-tab {
    flex: 1; padding: .55rem .5rem; font-size: .86rem; font-weight: 800; color: rgb(var(--gray-mid));
    background: none; border: none; border-bottom: 2px solid transparent; cursor: pointer;
  }
  .login-tab.active { color: #1e3a8a; border-bottom-color: #1e3a8a; }

  .login-form label { display: block; font-size: .78rem; font-weight: 800; margin-bottom: .4rem; }
  .login-form input {
    width: 100%; box-sizing: border-box;
    font-size: 1rem; padding: .7rem .9rem;
    border: 1px solid var(--border); border-radius: 10px;
    margin-bottom: .9rem; outline: none;
  }
  .login-form input:focus { border-color: rgb(var(--gray-dark)); }
  .login-form button {
    width: 100%; padding: .75rem 1rem;
    font-size: .95rem; font-weight: 850; color: #fff;
    background: linear-gradient(135deg, #1e3a8a, #2563eb);
    border: none; border-radius: 10px; cursor: pointer;
  }
  .login-form button:disabled { opacity: .6; cursor: wait; }
  .login-msg { font-size: .82rem; margin: .9rem 0 0; min-height: 1.2em; }
  .login-msg.ok { color: #0aa869; }
  .login-msg.error { color: #e04444; }
  .login-foot { font-size: .72rem; color: rgb(var(--gray-mid)); margin: 1.2rem 0 0; text-align: center; }
</style>
