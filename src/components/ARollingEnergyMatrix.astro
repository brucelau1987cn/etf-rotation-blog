---
/**
 * Multi-instrument dual-rail energy board.
 * Layout:
 *  - left stock panel is fixed (never pans)
 *  - right signal panel scrolls horizontally
 *  - shared columns are chronological by triggered_at (left → right)
 *  - later BUY columns sit after earlier SELL columns
 * Display cap:
 *  - formal buy rail: latest 4 windows only
 *  - formal sell rail: latest 4 windows only
 * Observation dots:
 *  - buy rail: red, lit by 1.75h (105m)
 *  - sell rail: green, lit by 5m
 */
type TimelineItem = {
  type: 'BUY' | 'SELL' | string;
  code: string;
  triggered_at?: string | null;
  sell_state?: string;
  label?: string;
  price?: number | null;
  price_source?: string | null;
};

type BoardInstrument = {
  instrumentName: string;
  symbol: string;
  exchange: string;
  timeline: TimelineItem[];
  startDate?: string | null;
};

type Props = {
  instruments: BoardInstrument[];
  formatTime: (value: string | null | undefined, includeDate?: boolean, includeSeconds?: boolean) => string;
};

const { instruments = [], formatTime } = Astro.props;

const FORMAL_BUY_ORDER = ['2h', '2.5h', '3h', '3.5h', '4h', '4.5h', '5h', '5.5h', '6h', '6.5h', '7h', '7.5h', '8h'];
const FORMAL_SELL_ORDER = ['10m', '15m', '30m', '60m', '90m', '120m', '150m', '180m', '210m', '240m'];
const MAX_FORMAL_PER_SIDE = 4;

const buyOrderIndex = (code: string) => {
  const i = FORMAL_BUY_ORDER.indexOf(code);
  return i === -1 ? 999 : i;
};

const sellOrderIndex = (code: string) => {
  const i = FORMAL_SELL_ORDER.indexOf(code);
  return i === -1 ? 999 : i;
};

const isBuyObservation = (code: string) => code === '1.75h' || code === '105m';
const isSellObservation = (code: string) => code === '5m';

const formatStartDate = (value?: string | null) => {
  if (!value) return '—';
  const raw = String(value).trim();
  const m = raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
  if (m) return `${Number(m[1])}/${Number(m[2])}/${Number(m[3])}`;
  const d = new Date(raw);
  if (!Number.isNaN(d.getTime())) {
    return d.toLocaleDateString('zh-CN', {
      timeZone: 'Asia/Shanghai',
      year: 'numeric',
      month: 'numeric',
      day: 'numeric',
    }).replace(/年|月/g, '/').replace(/日/g, '');
  }
  return raw;
};

const formatBadgePrice = (value?: number | null, exchange?: string) => {
  const price = Number(value);
  if (!Number.isFinite(price) || price <= 0) return '—';
  return exchange === 'FUTURES'
    ? price.toLocaleString('zh-CN', { maximumFractionDigits: 4 })
    : `¥${price.toFixed(2)}`;
};

const signalTimeMs = (item?: TimelineItem | null) => {
  const ms = new Date(item?.triggered_at || 0).getTime();
  return Number.isFinite(ms) ? ms : 0;
};

/** Keep the latest N formal windows by trigger time; return chronological (old → new). */
const takeLatestFormal = <T extends TimelineItem>(
  items: T[],
  orderIndex: (code: string) => number,
  limit = MAX_FORMAL_PER_SIDE,
) => {
  const sorted = items.slice().sort((a, b) => {
    const ta = signalTimeMs(a);
    const tb = signalTimeMs(b);
    if (ta !== tb) return ta - tb;
    const oa = orderIndex(a.code);
    const ob = orderIndex(b.code);
    if (oa !== ob) return oa - ob;
    return String(a.code || '').localeCompare(String(b.code || ''));
  });
  return sorted.slice(Math.max(0, sorted.length - limit));
};

type FormalColumn = { kind: 'BUY' | 'SELL'; item: TimelineItem };

/** Shared left→right columns: selected formal signals ordered by trigger time. */
const buildChronologicalColumns = (buys: TimelineItem[], sells: TimelineItem[]): FormalColumn[] => {
  const columns: FormalColumn[] = [
    ...buys.map((item) => ({ kind: 'BUY' as const, item })),
    ...sells.map((item) => ({ kind: 'SELL' as const, item })),
  ];
  return columns.sort((a, b) => {
    const ta = signalTimeMs(a.item);
    const tb = signalTimeMs(b.item);
    if (ta !== tb) return ta - tb;
    // Same timestamp: SELL before BUY keeps “先空后多” readable on rare ties.
    if (a.kind !== b.kind) return a.kind === 'SELL' ? -1 : 1;
    const orderIndex = a.kind === 'BUY' ? buyOrderIndex : sellOrderIndex;
    const oa = orderIndex(a.item.code);
    const ob = orderIndex(b.item.code);
    if (oa !== ob) return oa - ob;
    return String(a.item.code || '').localeCompare(String(b.item.code || ''));
  });
};

const splitTimeline = (timeline: TimelineItem[] = []) => {
  const buyObservation = timeline.find((item) => item.type === 'BUY' && isBuyObservation(item.code)) || null;
  const sellObservation = timeline.find((item) => item.type === 'SELL' && isSellObservation(item.code)) || null;
  const allBuys = timeline.filter((item) => item.type === 'BUY' && !isBuyObservation(item.code));
  const allSells = timeline.filter((item) => item.type === 'SELL' && !isSellObservation(item.code));
  const buys = takeLatestFormal(allBuys, buyOrderIndex);
  const sells = takeLatestFormal(allSells, sellOrderIndex);
  const columns = buildChronologicalColumns(buys, sells);
  return {
    buys,
    sells,
    columns,
    buyObservation,
    sellObservation,
    buyTotal: allBuys.length,
    sellTotal: allSells.length,
  };
};

/** First-letter map for current board names + common A-share name chars. */
const CHAR_INITIAL: Record<string, string> = {
  上: 's', 海: 'h', 电: 'd', 力: 'l',
  创: 'c', 新: 'x', 医: 'y', 疗: 'l',
  三: 's', 安: 'a', 光: 'g',
  深: 's', 科: 'k', 技: 'j',
  德: 'd', 福: 'f',
  民: 'm', 爆: 'b',
  信: 'x', 息: 'x',
  东: 'd', 方: 'f', 明: 'm', 珠: 'z',
  长: 'c', 鑫: 'x',
  国: 'g', 术: 's',
  澜: 'l', 起: 'q',
  华: 'h', 天: 't',
  中: 'z', 宏: 'h', 桥: 'q',
  特: 't', 斯: 's', 拉: 'l',
  黄: 'h', 金: 'j', 连: 'l', 续: 'x',
  原: 'y', 油: 'y', 豆: 'd', 粕: 'p',
};

const nameInitials = (name: string) => {
  const raw = String(name || '').trim();
  if (!raw) return '';
  return Array.from(raw).map((ch) => {
    if (/[A-Za-z0-9]/.test(ch)) return ch.toLowerCase();
    return CHAR_INITIAL[ch] || '';
  }).join('');
};
---
<section class="matrix-section card" aria-labelledby="matrix-title">
  <div class="matrix-top">
    <div class="section-head-title">
      <h2 id="matrix-title">多标的双向能量传导</h2>
      <p class="matrix-sub">
        多方/空方各最多显示最新 4 个正式窗口（合计最多 8 个），超出后旧窗口自动隐藏。列按触发时间从左到右排列；后出现的多方信号排在更早空方信号右侧。右侧信号区可左右滑动，左侧标的固定。看板按页浏览，每页 3 只；可用代码、名称或首字母检索。
      </p>
    </div>
    <div class="matrix-controls">
      <div class="legend-list">
        <span class="legend-item"><i class="dot dot-red"></i>多方 1.75h 观察</span>
        <span class="legend-item"><i class="dot dot-green"></i>空方 5m 观察</span>
        <span class="legend-item"><i class="dot dot-gray"></i>观察未触发</span>
      </div>
    </div>
  </div>

  <div class="matrix-toolbar" aria-label="标的检索与分页">
    <label class="board-search-wrap" for="board-search-input">
      <span class="board-search-label">检索</span>
      <input
        id="board-search-input"
        class="board-search-input"
        type="search"
        inputmode="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="代码 / 名称 / 首字母，如 600、创新、cx"
      />
    </label>
    <div class="board-pager" id="board-pager" data-page-size="3" hidden>
      <button type="button" class="board-page-btn" id="board-page-prev" aria-label="上一页">上一页</button>
      <div class="board-page-nums" id="board-page-nums" role="navigation" aria-label="页码"></div>
      <button type="button" class="board-page-btn" id="board-page-next" aria-label="下一页">下一页</button>
      <span class="board-page-meta" id="board-page-meta">第 1 页</span>
    </div>
  </div>

  <div class="board-list" id="rolling-board-list">
    {instruments.length === 0 ? (
      <div class="empty-board-card" role="status">
        <strong>暂无滚动标的</strong>
        <span>新标的须点名后接入。点名后会在此展示多方/空方正式窗口与观察点。</span>
      </div>
    ) : instruments.map((inst, index) => {
      const { columns, buyObservation, sellObservation } = splitTimeline(inst.timeline || []);
      const startDateText = formatStartDate(inst.startDate);
      const initials = nameInitials(inst.instrumentName);
      return (
        <article
          class="instrument-board"
          data-symbol={inst.symbol}
          data-name={inst.instrumentName}
          data-initials={initials}
          data-board-index={index}
          data-exchange={inst.exchange}
          data-start-date={inst.startDate || ''}
          aria-label={`${inst.instrumentName} ${inst.symbol}`}
        >
          <div class="board-row">
            <div class="stock-panel">
              <div class="stock-name-title" data-role="inst-name">{inst.instrumentName}</div>
              <div class="stock-code-tag" data-role="inst-symbol">{inst.symbol}</div>
              <div class="stock-price-tag" data-role="quote" data-symbol={inst.symbol}>加载行情...</div>
              <div class="stock-signal-meta" data-role="signal-meta">
                <span class="start-date-label">起始日期</span>
                <strong class="start-date-value" data-role="start-date">{startDateText}</strong>
              </div>
            </div>

            <div class="signal-panel" data-role="signal-scroller" tabindex="0" aria-label={`${inst.instrumentName} 信号横向滚动区`}>
              <div class="signal-canvas">
                <div class="axis-row sell-axis">
                  <div class="axis-label sell-label">
                    <span>空方力量</span>
                    <i
                      class={`watch-dot sell-watch ${sellObservation ? 'lit' : ''}`}
                      data-role="sell-watch-dot"
                      title={sellObservation ? `5m 观察已触发 ${formatTime(sellObservation.triggered_at, true, false)}` : '5m 观察窗口未触发'}
                      aria-label={sellObservation ? '空方观察窗口已点亮' : '空方观察窗口未点亮'}
                    ></i>
                  </div>
                  <div class="cells-scroll" data-role="sell-cells">
                    {columns.length === 0 ? (
                      <div class="empty-rail">空方信号暂无</div>
                    ) : (
                      columns.map(({ kind, item }) => (
                        kind === 'SELL' ? (
                          <>
                            <div class="cell-badge sell-sell" data-sell-code={item.code}>
                              <div class="badge-code">{item.code}</div>
                              <div class="badge-price" title="信号点股价">{formatBadgePrice(item.price, inst.exchange)}</div>
                              <div class="badge-time">{formatTime(item.triggered_at, true, false)}</div>
                            </div>
                            {item.code === '240m' ? (
                              <div class="stop-validation-card" data-role="stop-validation" aria-label="空方力量达到240分钟，停止验证">
                                <strong>停止验证</strong>
                                <span>空方已达 240m</span>
                              </div>
                            ) : null}
                          </>
                        ) : (
                          <div class="cell-spacer" data-align-buy={item.code} aria-hidden="true"></div>
                        )
                      ))
                    )}
                  </div>
                </div>

                <div class="axis-row buy-axis">
                  <div class="axis-label buy-label">
                    <span>多方力量</span>
                    <i
                      class={`watch-dot buy-watch ${buyObservation ? 'lit' : ''}`}
                      data-role="buy-watch-dot"
                      title={buyObservation ? `1.75h 观察已触发 ${formatTime(buyObservation.triggered_at, true, false)}` : '1.75h 观察窗口未触发'}
                      aria-label={buyObservation ? '多方观察窗口已点亮' : '多方观察窗口未点亮'}
                    ></i>
                  </div>
                  <div class="cells-scroll" data-role="buy-cells">
                    {columns.length === 0 ? (
                      <div class="empty-rail">多方信号暂无</div>
                    ) : (
                      columns.map(({ kind, item }) => (
                        kind === 'BUY' ? (
                          <div class="cell-badge buy-buy" data-buy-code={item.code}>
                            <div class="badge-code">{item.code}</div>
                            <div class="badge-price" title="信号点股价">{formatBadgePrice(item.price, inst.exchange)}</div>
                            <div class="badge-time">{formatTime(item.triggered_at, true, false)}</div>
                          </div>
                        ) : (
                          <>
                            <div class="cell-spacer" data-align-sell={item.code} aria-hidden="true"></div>
                            {item.code === '240m' ? <div class="cell-spacer" data-align-sell="stop-validation" aria-hidden="true"></div> : null}
                          </>
                        )
                      ))
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      );
    })}
    <div class="empty-board-card board-search-empty" id="board-search-empty" role="status" hidden>
      <strong>没有匹配标的</strong>
      <span>换个代码、名称或首字母试试。</span>
    </div>
  </div>
</section>
