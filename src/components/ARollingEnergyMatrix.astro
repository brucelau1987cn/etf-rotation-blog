---
/**
 * Multi-instrument dual-rail energy board.
 * Each instrument is a full row; no selector switch.
 */
type TimelineItem = {
  type: 'BUY' | 'SELL' | string;
  code: string;
  triggered_at?: string | null;
  sell_state?: string;
  label?: string;
};

type BoardInstrument = {
  instrumentName: string;
  symbol: string;
  exchange: string;
  timeline: TimelineItem[];
};

type Props = {
  instruments: BoardInstrument[];
  formatTime: (value: string | null | undefined, includeDate?: boolean, includeSeconds?: boolean) => string;
};

const { instruments = [], formatTime } = Astro.props;

const FORMAL_BUY_ORDER = ['2h', '2.5h', '3h', '3.5h', '4h', '4.5h', '5h', '5.5h'];
const orderIndex = (code: string) => {
  const i = FORMAL_BUY_ORDER.indexOf(code);
  return i === -1 ? 999 : i;
};

const sortTimeline = (timeline: TimelineItem[] = []) => {
  const buys = timeline
    .filter((item) => item.type === 'BUY' && item.code !== '1.75h')
    .sort((a, b) => {
      const oa = orderIndex(a.code);
      const ob = orderIndex(b.code);
      if (oa !== ob) return oa - ob;
      return new Date(a.triggered_at || 0).getTime() - new Date(b.triggered_at || 0).getTime();
    });
  const sells = timeline
    .filter((item) => item.type === 'SELL')
    .sort((a, b) => new Date(a.triggered_at || 0).getTime() - new Date(b.triggered_at || 0).getTime());
  // Display as formal buy windows first for cross-instrument comparison,
  // then sell events after buys (sells still use chronological order).
  return [...buys, ...sells];
};
---
<section class="matrix-section card" aria-labelledby="matrix-title">
  <div class="matrix-top">
    <div class="section-head-title">
      <h2 id="matrix-title">三标的双向能量传导</h2>
      <p class="matrix-sub">正式窗口固定顺序：2h → 5.5h；格子内时间为实际触发时刻。卖出暂无则显示空轨。</p>
    </div>
    <div class="matrix-controls">
      <div class="legend-list">
        <span class="legend-item"><i class="dot dot-red"></i>买方点亮</span>
        <span class="legend-item"><i class="dot dot-green"></i>卖方预警/确认</span>
        <span class="legend-item"><i class="dot dot-gray"></i>暂无信号</span>
      </div>
    </div>
  </div>

  <div class="board-list" id="rolling-board-list">
    {instruments.map((inst) => {
      const timeline = sortTimeline(inst.timeline || []);
      const buys = timeline.filter((item) => item.type === 'BUY');
      const sells = timeline.filter((item) => item.type === 'SELL');
      return (
        <article class="instrument-board" data-symbol={inst.symbol} data-exchange={inst.exchange} aria-label={`${inst.instrumentName} ${inst.symbol}`}>
          <div class="table-outer">
            <div class="table-grid">
              <div class="stock-sticky">
                <div class="stock-name-title" data-role="inst-name">{inst.instrumentName}</div>
                <div class="stock-code-tag" data-role="inst-symbol">{inst.symbol}</div>
                <div class="stock-price-tag" data-role="quote" data-symbol={inst.symbol}>加载行情...</div>
                <div class="stock-signal-meta" data-role="signal-meta">
                  买 {buys.length} · 卖 {sells.length}
                </div>
              </div>

              <div class="signals-axis">
                <div class="axis-row sell-axis">
                  <div class="axis-label sell-label">空方</div>
                  <div class="cells-scroll" data-role="sell-cells">
                    {sells.length === 0 ? (
                      <div class="empty-rail">卖出信号暂无</div>
                    ) : (
                      sells.map((item) => (
                        <div class="cell-badge sell-sell" data-sell-code={item.code}>
                          <div class="badge-code">{item.code}</div>
                          <div class="badge-time">{formatTime(item.triggered_at, true, false)}</div>
                        </div>
                      ))
                    )}
                  </div>
                </div>

                <div class="axis-row buy-axis">
                  <div class="axis-label buy-label">多方</div>
                  <div class="cells-scroll" data-role="buy-cells">
                    {buys.length === 0 ? (
                      <div class="empty-rail">买入信号暂无</div>
                    ) : (
                      buys.map((item) => (
                        <div class="cell-badge buy-buy" data-buy-code={item.code}>
                          <div class="badge-code">{item.code}</div>
                          <div class="badge-time">{formatTime(item.triggered_at, true, false)}</div>
                        </div>
                      ))
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>
