---
type FundItem = {
  title: string;
  tone?: string;
  stale?: boolean;
  frequency?: string;
  value: string;
  detail: string;
  as_of?: string;
  observation_period?: string;
  source?: string;
  source_url?: string;
  next_release?: {
    time?: string;
    star?: number | null;
    consensus?: string | number | null;
  };
};

type Props = {
  kicker: string;
  title: string;
  note: string;
  items: FundItem[];
};

const { kicker, title, note, items } = Astro.props;
---
<section>
  <div class="section-head">
    <div>
      <span class="section-kicker">{kicker}</span>
      <h2>{title}</h2>
    </div>
    <p>{note}</p>
  </div>
  <div class="fund-grid">
    {items.map((item) => (
      <article class={`fund card ${item.tone || ''}`}>
        <div class="fund-top">
          <span>{item.title}</span>
          <span>{item.stale ? '旧快照' : item.frequency}</span>
        </div>
        <h3>{item.value}</h3>
        <p>{item.detail}</p>
        <small>
          更新日 {item.as_of || 'N/A'}{item.observation_period ? ` · 数据期 ${item.observation_period}` : ''} · {
            item.source_url
              ? <a href={item.source_url} target="_blank" rel="noopener noreferrer">{item.source} ↗</a>
              : item.source
          }
        </small>
        {item.next_release?.time ? (
          <small class="next-release">下次更新 {item.next_release.time.replace('T', ' ').slice(0, 16)}{item.next_release.star ? ` · ${'★'.repeat(item.next_release.star)}` : ''}{item.next_release.consensus != null ? ` · 预期 ${item.next_release.consensus}` : ''}</small>
        ) : null}
      </article>
    ))}
  </div>
</section>
