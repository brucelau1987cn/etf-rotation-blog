---
/**
 * A-rolling hero stats: buy / sell / observation at a glance.
 * Stable IDs are used by public/js/a-rolling-app.js.
 */
type InstrumentStat = {
  name: string;
  symbol: string;
  buyCount: number;
  sellCount: number;
  buyWatch: boolean;
  sellWatch: boolean;
  latestBuy?: { code: string; triggered_at?: string | null } | null;
  latestSell?: { code: string; triggered_at?: string | null } | null;
};

type Props = {
  buyTotal?: number;
  sellTotal?: number;
  instruments?: InstrumentStat[];
  latestAction?: string;
  indexMarket?: 'a' | 'futures' | 'hk' | 'us';
};

const {
  buyTotal = 0,
  sellTotal = 0,
  instruments = [],
  latestAction = '等待信号',
  indexMarket = 'a',
} = Astro.props;

const indexSets = {
  a: [
    { symbol: '000001', name: '上证指数' },
    { symbol: '399001', name: '深证成指' },
    { symbol: '399006', name: '创业板指' },
  ],
  futures: [
    { symbol: 'AU0', name: '黄金连续' },
    { symbol: 'SC0', name: '原油连续' },
    { symbol: 'M0', name: '豆粕连续' },
  ],
  hk: [
    { symbol: 'HSI', name: '恒生指数' },
    { symbol: 'HSCI', name: '恒生综合指数' },
    { symbol: 'HSTECH', name: '恒生科技指数' },
  ],
  us: [
    { symbol: 'INX', name: '标普500指数' },
    { symbol: 'IXIC', name: '纳斯达克综合指数' },
    { symbol: 'DJI', name: '道琼斯工业平均指数' },
  ],
};
const marketIndices = indexSets[indexMarket] || indexSets.a;
// 24H continuous quotes under A-share indices: refresh independently of CN session.
const continuousQuotes = indexMarket === 'a'
  ? [
      { symbol: 'hf_XAU', name: '现货黄金', continuous: true },
      { symbol: 'HF_XAG', name: '现货白银', continuous: true },
      { symbol: 'hf_CL', name: '国际原油', continuous: true },
      { symbol: 'DINIW', name: '美元指数', continuous: true },
    ]
  : [];

const shanghaiDateParts = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).formatToParts(new Date());
const shanghaiMonth = shanghaiDateParts.find((part) => part.type === 'month')?.value || '01';
const shanghaiDay = shanghaiDateParts.find((part) => part.type === 'day')?.value || '01';
const todayLabel = `${shanghaiMonth}/${shanghaiDay}`;
const todayCountText = (count: number) => `${todayLabel} · ${count}个信号（含观察）`;
---
<div class="signal-summary" aria-label="买卖信号总览">
  <div class="signal-card buy-card">
    <div class="signal-card-head">
      <span class="signal-kicker">🔴 多方信号</span>
      <span class="signal-chip today-count-chip" id="buy-today-count">{todayCountText(0)}</span>
    </div>
    <div class="summary-signal-viewport">
      <div class="summary-signal-track" id="buy-signal-track">
        <div class="summary-signal-empty">当日暂无多方信号</div>
      </div>
    </div>
  </div>

  <div class="signal-card sell-card">
    <div class="signal-card-head">
      <span class="signal-kicker">🟢 空方信号</span>
      <span class="signal-chip today-count-chip" id="sell-today-count">{todayCountText(0)}</span>
    </div>
    <div class="summary-signal-viewport">
      <div class="summary-signal-track" id="sell-signal-track">
        <div class="summary-signal-empty">当日暂无空方信号</div>
      </div>
    </div>
  </div>

  <div class="signal-card market-index-card" aria-label={indexMarket === 'futures' ? '期货主力连续实时行情' : '关注指数与24H行情'}>
    <div class="signal-card-head">
      <span class="signal-kicker">{indexMarket === 'futures' ? '主力连续' : '🟡 关注指数'}</span>
      <span class="signal-chip index-live-chip" id="index-refresh-countdown">实时：准备刷新…</span>
    </div>
    <div class="market-index-list">
      {marketIndices.map((item) => (
        <div class="market-index-row" data-index-symbol={item.symbol}>
          <span class="market-index-name">{item.name}</span>
          <strong class="market-index-price" data-role="index-price">—</strong>
          <span class="market-index-change" data-role="index-change">行情加载中</span>
        </div>
      ))}
      {continuousQuotes.length > 0 && (
        <div class="market-spot-list" aria-label="24H连续行情">
          <div class="market-24h-head">
            <span>24H 连续行情</span>
            <span class="market-24h-countdown" id="continuous-refresh-countdown">15s 后刷新</span>
          </div>
          {continuousQuotes.map((item) => (
            <div class="market-index-row market-spot-row market-24h-row" data-index-symbol={item.symbol} data-quote-mode="24h">
              <span class="market-index-name">
                {item.name}
                <em class="market-24h-tag" title="24小时独立刷新">24H</em>
              </span>
              <strong class="market-index-price" data-role="index-price">—</strong>
              <span class="market-index-change" data-role="index-change">行情加载中</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</div>
