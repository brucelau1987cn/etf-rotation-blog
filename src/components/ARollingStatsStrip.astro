---
/**
 * A-rolling hero stats: buy / sell / observation at a glance.
 * Stable IDs are used by public/js/a-rolling-app.js.
 */
type InstrumentStat = {
  name: string;
  symbol: string;
  buyCount: number;
  sellCount: number;
  buyWatch: boolean;
  sellWatch: boolean;
  latestBuy?: { code: string; triggered_at?: string | null } | null;
  latestSell?: { code: string; triggered_at?: string | null } | null;
};

type Props = {
  buyTotal?: number;
  sellTotal?: number;
  instruments?: InstrumentStat[];
  latestAction?: string;
  indexMarket?: 'a' | 'futures' | 'hk' | 'us';
};

const {
  buyTotal = 0,
  sellTotal = 0,
  instruments = [],
  latestAction = '等待信号',
  indexMarket = 'a',
} = Astro.props;

const indexSets = {
  a: [
    { symbol: '000001', name: '上证指数' },
    { symbol: '399001', name: '深证成指' },
    { symbol: '399006', name: '创业板指' },
  ],
  futures: [
    { symbol: 'AU0', name: '黄金连续' },
    { symbol: 'SC0', name: '原油连续' },
    { symbol: 'M0', name: '豆粕连续' },
  ],
  hk: [
    { symbol: 'HSI', name: '恒生指数' },
    { symbol: 'HSCI', name: '恒生综合指数' },
    { symbol: 'HSTECH', name: '恒生科技指数' },
  ],
  us: [
    { symbol: 'INX', name: '标普500指数' },
    { symbol: 'IXIC', name: '纳斯达克综合指数' },
    { symbol: 'DJI', name: '道琼斯工业平均指数' },
  ],
};
const marketIndices = indexSets[indexMarket] || indexSets.a;

const formatSignalTime = (value?: string | null) => {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '—';
  return date.toLocaleString('zh-CN', {
    timeZone: 'Asia/Shanghai',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
};
const latestSignals = (side: 'BUY' | 'SELL') => instruments
  .map((item) => {
    const signal = side === 'BUY' ? item.latestBuy : item.latestSell;
    return signal?.triggered_at ? { name: item.name, ...signal } : null;
  })
  .filter(Boolean)
  .sort((a, b) => new Date(b!.triggered_at || 0).getTime() - new Date(a!.triggered_at || 0).getTime());
const initialBuys = latestSignals('BUY');
const initialSells = latestSignals('SELL');
---
<div class="signal-summary" aria-label="买卖信号总览">
  <div class="signal-card buy-card">
    <div class="signal-card-head">
      <span class="signal-kicker">🔴 多方信号</span>
    </div>
    <div class="summary-signal-label">最新多方信号</div>
    <div class="summary-signal-viewport">
      <div class="summary-signal-track" id="buy-signal-track">
        {initialBuys.length ? initialBuys.map((item) => (
          <div class="summary-signal-item">
            <span class="summary-signal-name">{item!.name}</span>
            <strong class="summary-signal-point">{item!.code}</strong>
            <time class="summary-signal-time">{formatSignalTime(item!.triggered_at)}</time>
          </div>
        )) : <div class="summary-signal-empty">等待多方信号</div>}
      </div>
    </div>
    <div class="today-signal-block">
      <span class="today-signal-label">当日更新</span>
      <div class="today-signal-track" id="buy-today-track"><span class="today-signal-empty">暂无</span></div>
    </div>
  </div>

  <div class="signal-card sell-card">
    <div class="signal-card-head">
      <span class="signal-kicker">🟢 空方信号</span>
    </div>
    <div class="summary-signal-label">最新空方信号</div>
    <div class="summary-signal-viewport">
      <div class="summary-signal-track" id="sell-signal-track">
        {initialSells.length ? initialSells.map((item) => (
          <div class="summary-signal-item">
            <span class="summary-signal-name">{item!.name}</span>
            <strong class="summary-signal-point">{item!.code}</strong>
            <time class="summary-signal-time">{formatSignalTime(item!.triggered_at)}</time>
          </div>
        )) : <div class="summary-signal-empty">等待空方信号</div>}
      </div>
    </div>
    <div class="today-signal-block">
      <span class="today-signal-label">当日更新</span>
      <div class="today-signal-track" id="sell-today-track"><span class="today-signal-empty">暂无</span></div>
    </div>
  </div>

  <div class="signal-card market-index-card" aria-label={indexMarket === 'futures' ? '期货主力连续实时行情' : '主要指数实时行情'}>
    <div class="signal-card-head">
      <span class="signal-kicker">{indexMarket === 'futures' ? '主力连续' : '三大指数'}</span>
      <span class="signal-chip index-live-chip" id="index-refresh-countdown">15s 后刷新</span>
    </div>
    <div class="market-index-list">
      {marketIndices.map((item) => (
        <div class="market-index-row" data-index-symbol={item.symbol}>
          <span class="market-index-name">{item.name}</span>
          <strong class="market-index-price" data-role="index-price">—</strong>
          <span class="market-index-change" data-role="index-change">行情加载中</span>
        </div>
      ))}
    </div>
  </div>
</div>
