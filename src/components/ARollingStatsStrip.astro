---
/**
 * A-rolling hero stats: buy / sell / observation at a glance.
 * Stable IDs are used by public/js/a-rolling-app.js.
 */
type InstrumentStat = {
  name: string;
  symbol: string;
  buyCount: number;
  sellCount: number;
  buyWatch: boolean;
  sellWatch: boolean;
};

type Props = {
  buyTotal?: number;
  sellTotal?: number;
  instruments?: InstrumentStat[];
  latestAction?: string;
};

const {
  buyTotal = 0,
  sellTotal = 0,
  instruments = [],
  latestAction = '等待信号',
} = Astro.props;

const buyWatchLit = instruments.filter((item) => item.buyWatch).length;
const sellWatchLit = instruments.filter((item) => item.sellWatch).length;
const buyParts = instruments.map((item) => `${item.name}${item.buyCount}`).join(' · ') || '—';
const sellParts = instruments.map((item) => `${item.name}${item.sellCount}`).join(' · ') || '—';
---
<div class="signal-summary" aria-label="买卖信号总览">
  <div class="signal-card buy-card">
    <div class="signal-card-head">
      <span class="signal-kicker">🔴 买入信号</span>
      <span class="signal-chip">轨上最多 4 个</span>
    </div>
    <div class="signal-metric">
      <strong id="stat-buy-total">{buyTotal}</strong>
      <em>个</em>
    </div>
    <p class="signal-breakdown" id="stat-buy-breakdown">{buyParts}</p>
  </div>

  <div class="signal-card sell-card">
    <div class="signal-card-head">
      <span class="signal-kicker">🟢 卖出信号</span>
      <span class="signal-chip">轨上最多 4 个</span>
    </div>
    <div class="signal-metric">
      <strong id="stat-sell-total">{sellTotal}</strong>
      <em>个</em>
    </div>
    <p class="signal-breakdown" id="stat-sell-breakdown">{sellParts}</p>
  </div>

  <div class="signal-card watch-card">
    <div class="signal-card-head">
      <span class="signal-kicker">观察窗</span>
      <span class="signal-chip">1.75h / 10m</span>
    </div>
    <div class="watch-row">
      <div class="watch-item">
        <i class="watch-dot buy-watch lit" aria-hidden="true"></i>
        <div>
          <strong id="stat-buy-watch">{buyWatchLit}</strong>
          <span>多方红点亮</span>
        </div>
      </div>
      <div class="watch-item">
        <i class="watch-dot sell-watch lit" aria-hidden="true"></i>
        <div>
          <strong id="stat-sell-watch">{sellWatchLit}</strong>
          <span>空方绿点亮</span>
        </div>
      </div>
    </div>
    <p class="signal-breakdown" id="stat-latest-action">{latestAction}</p>
  </div>
</div>
