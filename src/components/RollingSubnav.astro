---
const { active = 'a' } = Astro.props;
const links = [
  { key: 'a', href: '/rolling/', label: 'A股滚动' },
  { key: 'low-chip', href: '/rolling/low-chip/', label: '低筹码股' },
  { key: 'index-low-chip', href: '/rolling/index-low-chip/', label: '低筹码指数' },
  { key: 'futures', href: '/rolling/futures/', label: '期货滚动' },
  { key: 'hk', href: '/rolling/hk/', label: '港股滚动' },
  { key: 'us', href: '/rolling/us/', label: '美股滚动' },
  { key: 'insights', href: '/rolling/insights/', label: '详细解读' },
];
---
<nav class="rolling-subnav site-shell" aria-label="滚动罗盘二级导航">
  {links.map((link) => (
    <a
      href={link.href}
      class:list={[active === link.key && 'active']}
      aria-current={active === link.key ? 'page' : undefined}
    >
      {link.label}
    </a>
  ))}
</nav>
<style>
  .rolling-subnav{
    display:flex;
    gap:.35rem;
    box-sizing:border-box;
    min-height:48px;
    margin:0 auto 1rem;
    padding:.35rem;
    border:1px solid var(--border);
    border-radius:14px;
    background:#fff;
    overflow-x:auto;
    overscroll-behavior-inline:contain;
    scrollbar-width:none;
  }
  .rolling-subnav::-webkit-scrollbar{display:none}
  .rolling-subnav a{
    display:flex;
    align-items:center;
    justify-content:center;
    flex:0 0 auto;
    min-height:36px;
    padding:.5rem .85rem;
    border-radius:10px;
    color:rgb(var(--gray-dark));
    font-size:.82rem;
    font-weight:850;
    line-height:1;
    text-decoration:none;
    white-space:nowrap;
  }
  .rolling-subnav a:hover{background:#f1f5f9}
  .rolling-subnav a.active{background:#14243b;color:#fff}
  @media(max-width:620px){
    .rolling-subnav{
      position:sticky;
      top:3.55rem;
      z-index:18;
      box-shadow:0 8px 20px rgba(15,23,42,.08);
    }
  }
</style>
