---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
const isHome = Astro.url.pathname === '/';
---

<a class="skip-link" href="#main-content">跳到主要内容</a>
<header>
  <nav class="site-shell" aria-label="主导航">
    <a class:list={['brand', { active: isHome }]} href="/" aria-label={`${SITE_TITLE}首页`} aria-current={isHome ? 'page' : undefined}>
      <span class="mark">ETF</span>
      <span class="brand-copy"><strong>{SITE_TITLE}</strong><small>伏击 · 兑现 · 复盘</small></span>
    </a>
    <div class="nav-scroll">
      <div class="internal-links">
        <HeaderLink href="/a-compass/" activePaths={['/a-compass/', '/blog', '/a-momentum', '/a-macro']}>A股罗盘</HeaderLink>
        <HeaderLink href="/rolling/" activePaths={['/rolling/', '/rolling/low-chip', '/rolling/futures', '/rolling/hk', '/rolling/us']}>滚动罗盘</HeaderLink>
        <HeaderLink href="/futures-compass/">期货罗盘</HeaderLink>
        <HeaderLink href="/us-compass/" activePaths={['/us-compass/', '/us-momentum', '/us-macro']}>美股罗盘</HeaderLink>
        <HeaderLink href="/paper/">模拟盘</HeaderLink>
        <HeaderLink href="/research-framework/">研究框架</HeaderLink>
        <div class="user-menu" id="user-menu">
          <a href="/login/" class="user-login-link" id="user-login-link">登录</a>
          <div class="user-dropdown" id="user-dropdown" hidden>
            <button type="button" class="user-trigger" id="user-trigger" aria-haspopup="true" aria-expanded="false">
              <span class="user-avatar" id="user-avatar">👤</span>
              <span class="user-name" id="user-name">用户</span>
              <span class="user-caret">▾</span>
            </button>
            <div class="user-panel" id="user-panel" role="menu" hidden>
              <div class="user-panel-head">
                <span class="user-role" id="user-role">—</span>
                <span class="user-sub" id="user-sub">—</span>
              </div>
              <a href="/account/" class="user-item" role="menuitem">👤 个人信息</a>
              <a href="/admin/" class="user-item admin-only" id="user-admin-link" role="menuitem" hidden>🛠 账号开通</a>
              <button type="button" class="user-item" id="user-logout" role="menuitem">🚪 退出登录</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>
<script is:inline src="/js/site-a11y.js"></script>
<script is:inline>
  (() => {
    const menu = document.getElementById('user-menu');
    const loginLink = document.getElementById('user-login-link');
    const dropdown = document.getElementById('user-dropdown');
    const trigger = document.getElementById('user-trigger');
    const panel = document.getElementById('user-panel');
    const nameEl = document.getElementById('user-name');
    const roleEl = document.getElementById('user-role');
    const subEl = document.getElementById('user-sub');
    const adminLink = document.getElementById('user-admin-link');
    const avatarEl = document.getElementById('user-avatar');

    // 若在登录页/管理页则不干扰页面内逻辑
    const isAuthPage = ['/login/', '/admin/'].some((p) => location.pathname.startsWith(p));

    fetch('/api/public/v1/me', { credentials: 'same-origin' })
      .then((r) => r.json())
      .then((d) => {
        if (d.kind === 'anonymous') return;
        // 已登录 → 隐藏登录链接，显示用户菜单
        loginLink.hidden = true;
        dropdown.hidden = false;
        if (d.kind === 'admin') {
          const roleName = d.role === 'super_admin' ? '超级管理员' : '管理员';
          nameEl.textContent = roleName;
          roleEl.textContent = roleName;
          subEl.textContent = '管理后台';
          avatarEl.textContent = '🛠';
          adminLink.hidden = false;
        } else {
          // 有账号密码的订阅 = VIP 用户；纯密码订阅 = 订阅用户
          const roleName = d.vip ? 'VIP用户' : '订阅用户';
          nameEl.textContent = roleName;
          roleEl.textContent = roleName;
          subEl.textContent = `${d.label || ''} · 订阅至 ${String(d.expires_at || '').slice(0, 10)} · 设备 ${d.device_count ?? 0}/5`;
          avatarEl.textContent = d.vip ? '💎' : '👤';
          adminLink.hidden = true;
        }
      })
      .catch(() => {});

    trigger?.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    // 点击外部关闭
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target)) {
        trigger?.setAttribute('aria-expanded', 'false');
        if (panel) panel.hidden = true;
      }
    });
    document.getElementById('user-logout')?.addEventListener('click', () => {
      fetch('/api/public/v1/logout', { method: 'POST', credentials: 'same-origin' })
        .finally(() => { location.href = '/login/'; });
    });
  })();
</script>
<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    margin: 0;
    padding: 0.62rem 0;
    background: rgba(250, 250, 247, 0.91);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }
  nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 0.65rem; color: rgb(var(--black)); text-decoration: none; }
  .mark { display: inline-flex; align-items: center; justify-content: center; width: 2.35rem; height: 2.35rem; border-radius: 11px; background: rgb(var(--black)); color: white; font-size: 0.75rem; font-weight: 900; letter-spacing: 0.04em; }
  .brand-copy { display: grid; line-height: 1.15; }
  .brand-copy strong { font-size: 0.96rem; }
  .brand-copy small { margin-top: 0.2rem; color: rgb(var(--gray)); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em; }
  .nav-scroll { min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .nav-scroll::-webkit-scrollbar { display: none; }
  .internal-links { display: flex; align-items: center; gap: 0.25rem; width: max-content; margin-left: auto; }
  /* 用户菜单：author CSS 会覆盖原生 [hidden]，必须显式保持隐藏 */
  .user-menu [hidden] { display: none !important; }
  .user-menu { flex: 0 0 auto; position: relative; margin-left: 0.18rem; }
  .user-login-link {
    display: inline-flex; align-items: center; min-height: 40px;
    padding: 0.5rem 0.78rem !important; font-weight: 800 !important;
    color: #fff !important; background: #1e3a8a; border-radius: 999px !important;
  }
  .user-login-link:hover { background: #2563eb !important; }
  .user-dropdown { position: relative; }
  .user-trigger {
    min-height: 40px; display: inline-flex; align-items: center; gap: 0.38rem;
    padding: 0.32rem 0.68rem 0.32rem 0.34rem; border: 1px solid var(--border);
    border-radius: 999px; background: #fff; cursor: pointer; font-weight: 800;
    color: rgb(var(--gray-dark)); font-size: 0.82rem;
    box-shadow: 0 1px 3px rgba(30, 41, 59, 0.05);
  }
  .user-trigger:hover { border-color: #94a3b8; background: #f8fafc; }
  .user-avatar { display: inline-flex; align-items: center; justify-content: center; width: 1.7rem; height: 1.7rem; border-radius: 50%; background: var(--accent-soft); font-size: 0.85rem; }
  .user-caret { font-size: 0.65rem; color: rgb(var(--gray-mid)); }
  .user-panel {
    position: absolute; right: 0; top: calc(100% + 0.5rem); z-index: 50;
    min-width: 230px; background: #fff; border: 1px solid var(--border); border-radius: 14px;
    box-shadow: 0 12px 34px rgba(30, 41, 59, 0.12); padding: 0.5rem; display: grid; gap: 0.15rem;
  }
  .user-panel-head { padding: 0.5rem 0.65rem 0.55rem; border-bottom: 1px solid var(--border); margin-bottom: 0.3rem; display: grid; gap: 0.2rem; }
  .user-role { font-size: 0.85rem; font-weight: 850; color: rgb(var(--black)); }
  .user-sub { font-size: 0.72rem; color: rgb(var(--gray-mid)); }
  .user-item {
    display: flex; align-items: center; gap: 0.5rem; width: 100%; text-align: left;
    padding: 0.55rem 0.65rem !important; border-radius: 9px !important; font-size: 0.85rem !important;
    color: rgb(var(--gray-dark)) !important; background: none; border: none; cursor: pointer; font-weight: 700 !important;
  }
  .user-item:hover { background: var(--warm) !important; color: rgb(var(--black)) !important; }
  .user-item.admin-only { color: #b45309 !important; }
  nav :global(a) { color: rgb(var(--gray-dark)); text-decoration: none; font-size: 0.88rem; font-weight: 750; padding: 0.5rem 0.68rem; border-radius: 999px; white-space: nowrap; }
  nav :global(a.active) { color: var(--accent-dark); background: var(--accent-soft); }
  nav :global(a:hover) { background: var(--warm); color: rgb(var(--black)); }
  nav :global(a.utility) { color: rgb(var(--gray)); border-left: 1px solid var(--border); border-radius: 0; margin-left: 0.2rem; }
  @media (max-width: 720px) {
    header { padding: 0.48rem 0; }
    nav.site-shell { gap: 0.28rem; }
    .brand-copy { display: none; }
    .mark { width: 2.1rem; height: 2.1rem; }
    .nav-scroll { padding-right: 0; -webkit-mask-image: none; mask-image: none; }
    .internal-links { gap: 0; }
    nav :global(a) { min-height: 44px; padding: 0.48rem 0.38rem; font-size: 0.76rem; }
    nav :global(a.utility) { margin-left: 0; padding-inline: 0.32rem; }
  }
</style>
