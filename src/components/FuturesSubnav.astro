---
const { active = 'home' } = Astro.props;
const links = [
  { key: 'home', href: '/futures-compass/', label: '期货罗盘' },
  { key: 'jin10', href: '/futures-compass/jin10/', label: '宏观数据' },
  { key: 'holdings', href: '/futures-compass/holdings/', label: '金银持仓' },
];
---
<nav class="futures-subnav site-shell" aria-label="期货罗盘二级导航">
  {links.map((link) => (
    <a
      href={link.href}
      class:list={[active === link.key && 'active']}
      aria-current={active === link.key ? 'page' : undefined}
    >
      {link.label}
    </a>
  ))}
</nav>
<style>
  .futures-subnav{
    display:flex;
    gap:.35rem;
    box-sizing:border-box;
    min-height:48px;
    margin:0 auto 1rem;
    padding:.35rem;
    border:1px solid var(--border);
    border-radius:14px;
    background:#fff;
    overflow-x:auto;
    overscroll-behavior-inline:contain;
    scrollbar-width:none;
  }
  .futures-subnav::-webkit-scrollbar{display:none}
  .futures-subnav a{
    display:flex;
    align-items:center;
    justify-content:center;
    flex:0 0 auto;
    min-height:36px;
    padding:.5rem .85rem;
    border-radius:10px;
    color:rgb(var(--gray-dark));
    font-size:.82rem;
    font-weight:850;
    line-height:1;
    text-decoration:none;
    white-space:nowrap;
  }
  .futures-subnav a:hover{background:#f1f5f9}
  .futures-subnav a.active{background:#14243b;color:#fff}
  @media(max-width:620px){
    .futures-subnav{
      position:sticky;
      top:3.55rem;
      z-index:18;
      box-shadow:0 8px 20px rgba(15,23,42,.08);
    }
  }
</style>
