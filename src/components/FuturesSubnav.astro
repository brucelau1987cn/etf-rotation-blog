---
const { active = 'home' } = Astro.props;
const links = [
  { key: 'home', href: '/futures-compass/', label: '期货罗盘' },
  { key: 'jin10', href: '/futures-compass/jin10/', label: '金十数据' },
];
---
<nav class="futures-subnav site-shell" aria-label="期货罗盘二级导航">
  {links.map((link) => (
    <a
      href={link.href}
      class:list={[active === link.key && 'active']}
      aria-current={active === link.key ? 'page' : undefined}
    >
      {link.label}
    </a>
  ))}
</nav>
<style>
  .futures-subnav{
    display:flex;
    gap:.35rem;
    box-sizing:border-box;
    min-height:48px;
    margin:0 auto 1rem;
    padding:.35rem;
    border:1px solid var(--border);
    border-radius:14px;
    background:#fff;
    overflow-x:auto;
    overscroll-behavior-inline:contain;
    scrollbar-width:none;
  }
  .futures-subnav::-webkit-scrollbar{display:none}
  .futures-subnav a{
    display:flex;
    align-items:center;
    gap:.4rem;
    padding:.45rem .85rem;
    border-radius:10px;
    font-size:.82rem;
    font-weight:850;
    color:rgb(var(--gray-dark));
    text-decoration:none;
    white-space:nowrap;
    border:1px solid transparent;
  }
  .futures-subnav a:hover{background:var(--warm-2);color:rgb(var(--black))}
  .futures-subnav a.active{background:rgb(var(--black));color:#fff}
  @media(max-width:680px){
    .futures-subnav{min-height:44px}
    .futures-subnav a{padding:.4rem .7rem;font-size:.78rem}
  }
</style>