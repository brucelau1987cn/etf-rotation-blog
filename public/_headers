/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://widgets.tradingview-widget.com; frame-src https://widgets.tradingview-widget.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://widgets.tradingview-widget.com

# Invite tokens arrive in the query string; never forward them in Referer.
/register/*
  Referrer-Policy: no-referrer
  Cache-Control: private, no-store

# HTML pages: short cache so script ?v= hash updates roll out quickly.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Versioned public JS modules (queried as /js/*.js?v=<hash>).
# Long-lived immutable caching is safe because content changes bump the hash.
/js/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Hashed Astro build assets (CSS/JS/fonts/images).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Explicit CSS MIME for Astro stylesheets. Do NOT apply this to all /_astro/*
# because fonts/images also live under /_astro.
/_astro/*.css
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Content-Type: text/css; charset=utf-8

# Static data snapshots: short cache, always revalidate.
/data/*
  Cache-Control: public, max-age=60, stale-while-revalidate=300
