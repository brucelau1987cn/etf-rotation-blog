{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf.peekabo.cc/schemas/us-compass-risk.schema.json",
  "title": "US Compass portfolio risk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "window", "symbols", "correlation_matrix", "volatility", "risk_contribution", "concentration", "data_quality"],
  "properties": {
    "schema_version": {"const": "us-compass-risk-v1"},
    "as_of": {"type": "string", "format": "date"},
    "window": {"type": "integer", "minimum": 1},
    "symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "correlation_matrix": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": "number", "minimum": -1, "maximum": 1}
      }
    },
    "volatility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "values"],
      "properties": {
        "status": {"$ref": "#/$defs/evaluation_status"},
        "values": {"$ref": "#/$defs/symbol_numeric_map"},
        "reasons": {"$ref": "#/$defs/reasons"}
      }
    },
    "risk_contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "values"],
      "properties": {
        "status": {"$ref": "#/$defs/evaluation_status"},
        "values": {"$ref": "#/$defs/signed_symbol_numeric_map"},
        "reasons": {"$ref": "#/$defs/reasons"}
      }
    },
    "concentration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "score", "largest_contributor"],
      "properties": {
        "status": {"$ref": "#/$defs/evaluation_status"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "largest_contributor": {"type": ["string", "null"], "minLength": 1},
        "reasons": {"$ref": "#/$defs/reasons"}
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "coverage", "reasons"],
      "properties": {
        "status": {"$ref": "#/$defs/evaluation_status"},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "reasons": {"$ref": "#/$defs/reasons"}
      }
    }
  },
  "$defs": {
    "evaluation_status": {"enum": ["EVALUATED", "PARTIAL", "INSUFFICIENT", "UNAVAILABLE"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "symbol_numeric_map": {"type": "object", "additionalProperties": {"type": ["number", "null"], "minimum": 0}},
    "signed_symbol_numeric_map": {"type": "object", "additionalProperties": {"type": ["number", "null"]}}
  }
}
